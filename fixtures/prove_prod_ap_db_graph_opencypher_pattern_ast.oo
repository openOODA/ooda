// # Product prove std/db_graph/opencypher_pattern_ast.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_graph/opencypher_pattern_ast.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/db_graph/opencypher_pattern_ast.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_opencypher_pattern_ast: PASSED only if they match.

import "std/db_graph/opencypher_pattern_ast.oo";

pub fn main() {
    let opencypher_pattern_ast_a = cypher_hop_range_exact(0);
    let opencypher_pattern_ast_b = cypher_hop_range_exact(0);
    if opencypher_pattern_ast_a.min_hops != opencypher_pattern_ast_b.min_hops {
        println("FAIL opencypher_pattern_ast");
        process_exit(1);
    }
    println("prod_ap_opencypher_pattern_ast: PASSED");
}
