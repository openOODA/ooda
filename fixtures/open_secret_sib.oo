// # Secret field sibling stays printable
//
// Logline: token is SECRET; println of user.creds.name must stay allowed.
//
// Setup: OPEN-36. Nested struct with one secret field.
//
// Beats:
//   1. Tag token secret.
//   2. Store it in creds.token.
//   3. Print the clean sibling name.

type Creds = struct { token: String, name: String };
type User = struct { creds: Creds };
// SECRET: token
pub fn main() {
    let token = "s3cret-payload";
    let c = Creds { token: token, name: "alice" };
    let user = User { creds: c };
    println(user.creds.name);
}