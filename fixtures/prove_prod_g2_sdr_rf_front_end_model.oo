// # Product prove std/telecom_5g/sdr_rf_front_end_model.oo
//
// Logline: Fail-closed emit+gcc+run asserts sdr_rf_friis_cascaded_noise_factor is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/sdr_rf_front_end_model.oo.
//
// Beats:
//   1. Call sdr_rf_friis_cascaded_noise_factor twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_sdr_rf_front_end_model: PASSED only if they match.

import "std/telecom_5g/sdr_rf_front_end_model.oo";

pub fn main() {
    let sdr_rf_front_end_model_mark: Int = 0;
    if sdr_rf_front_end_model_mark != 0 {
        process_exit(1);
    }
    let a: Float = sdr_rf_friis_cascaded_noise_factor(0.0, 0.0, 0.0);
    let b: Float = sdr_rf_friis_cascaded_noise_factor(0.0, 0.0, 0.0);
    if a != b {
        println("FAIL sdr_rf_friis_cascaded_noise_factor");
        process_exit(1);
    }
    println("prod_g2_sdr_rf_front_end_model: PASSED");
}
