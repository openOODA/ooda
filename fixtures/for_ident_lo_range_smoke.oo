// # IDENT low-bound range-for emit lock
//
// Logline: Fail-closed emit+gcc+run of for i in lo..n with IDENT lo and hi.
//
// Setup: Backend-C. Both bounds are idents.
//
// Beats:
//   1. Bind lo = 0 and n = 3.
//   2. Sum i in lo..n.
//   3. Exit 1 before PASSED when the sum is not 3.

pub fn main() {
    let lo: Int = 0;
    let n: Int = 3;
    let mut s: Int = 0;
    for i in lo..n {
        s = s + i;
    }
    if s != 3 {
        println("FAIL");
        process_exit(1);
    }
    println("for_ident_lo_range_smoke: PASSED");
}
