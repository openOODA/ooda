// # Product prove std/quantum_open_systems/input_output_cavity_theory.oo
//
// Logline: Fail-closed emit+gcc+run asserts cavity_input_output_params_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/input_output_cavity_theory.oo.
//
// Beats:
//   1. Call cavity_input_output_params_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_input_output_cavity_theory: PASSED only if they match.

import "std/quantum_open_systems/input_output_cavity_theory.oo";

pub fn main() {
    let input_output_cavity_theory_mark: Int = 0;
    if input_output_cavity_theory_mark != 0 {
        process_exit(1);
    }
    let a: CavityInputOutputParams = cavity_input_output_params_new(0.0, 0.0, 0.0);
    let b: CavityInputOutputParams = cavity_input_output_params_new(0.0, 0.0, 0.0);
    if (a).detuning_delta != (b).detuning_delta {
        println("FAIL cavity_input_output_params_new");
        process_exit(1);
    }
    println("prod_input_output_cavity_theory: PASSED");
}
