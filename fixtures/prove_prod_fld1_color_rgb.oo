// # Product prove std/multimedia/color_rgb.oo
//
// Logline: Fail-closed emit+gcc+run asserts color_int_to_f is deterministic.
//
// Setup: Isolated emit-c. Imports std/multimedia/color_rgb.oo.
//
// Beats:
//   1. Call color_int_to_f twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_color_rgb: PASSED only if they match.

import "std/multimedia/color_rgb.oo";

pub fn main() {
    let color_rgb_mark: Int = 0;
    if color_rgb_mark != 0 {
        process_exit(1);
    }
    let color_rgb_a: Float = color_int_to_f(1);
    let color_rgb_b: Float = color_int_to_f(1);
    if color_rgb_a != color_rgb_b {
        println("FAIL color_int_to_f");
        process_exit(1);
    }
    println("prod_color_rgb: PASSED");
}
