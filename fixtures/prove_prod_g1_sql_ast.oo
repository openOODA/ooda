// # Product prove std/database/sql_ast.oo
//
// Logline: Fail-closed emit+gcc+run asserts sql_delete_stmt_create is deterministic.
//
// Setup: Isolated emit-c. Imports std/database/sql_ast.oo.
//
// Beats:
//   1. Call sql_delete_stmt_create twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sql_ast: PASSED only if they match.

import "std/database/sql_ast.oo";

pub fn main() {
    let a: SqlDeleteStmt = sql_delete_stmt_create("x");
    let b: SqlDeleteStmt = sql_delete_stmt_create("x");
    if chars_len(a.table_name) != chars_len(b.table_name) {
        println("FAIL sql_delete_stmt_create");
        process_exit(1);
    }
    println("prod_sql_ast: PASSED");
}
