// # Product prove std/iot_scada/opcua_node_tree.oo
//
// Logline: Fail-closed emit+gcc+run asserts opcua_node_new_variable is deterministic.
//
// Setup: Isolated emit-c. Imports std/iot_scada/opcua_node_tree.oo.
//
// Beats:
//   1. Call opcua_node_new_variable twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_opcua_node_tree: PASSED only if they match.

import "std/iot_scada/opcua_node_tree.oo";

pub fn main() {
    let opcua_node_tree_mark: Int = 0;
    if opcua_node_tree_mark != 0 {
        process_exit(1);
    }
    let opcua_node_tree_a = opcua_node_new_variable(1, 1, "x", 1);
    let opcua_node_tree_b = opcua_node_new_variable(1, 1, "x", 1);
    if (opcua_node_tree_a).namespace_index != (opcua_node_tree_b).namespace_index {
        println("FAIL opcua_node_new_variable");
        process_exit(1);
    }
    println("prod_opcua_node_tree: PASSED");
}
