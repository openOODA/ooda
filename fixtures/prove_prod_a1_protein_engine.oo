// # Product prove std/bio/protein_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts protein_backbone_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio/protein_engine.oo.
//
// Beats:
//   1. Call protein_backbone_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_protein_engine: PASSED only if they match.

import "std/bio/protein_engine.oo";

pub fn main() {
    let protein_engine_mark: Int = 0;
    if protein_engine_mark != 0 {
        process_exit(1);
    }
    let a: ProteinBackbone = protein_backbone_new(0);
    let b: ProteinBackbone = protein_backbone_new(0);
    if (a).id != (b).id {
        println("FAIL protein_backbone_new");
        process_exit(1);
    }
    println("prod_protein_engine: PASSED");
}
