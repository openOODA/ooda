// # Product prove std/ai_ml/onnx_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts onnx_magic is deterministic.
//
// Setup: Isolated emit-c. Imports std/ai_ml/onnx_parser.oo.
//
// Beats:
//   1. Call onnx_magic twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_onnx_parser: PASSED only if they match.

import "std/ai_ml/onnx_parser.oo";

pub fn main() {
    let a = onnx_magic();
    let b = onnx_magic();
    if a != b {
        println("FAIL onnx_magic");
        process_exit(1);
    }
    println("prod_onnx_parser: PASSED");
}
