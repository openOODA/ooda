// # Product prove std/fintech_defi/crypto_mnemonic_bip39.oo
//
// Logline: Fail-closed emit+gcc+run asserts mnemonic_compute_checksum is a real value.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/crypto_mnemonic_bip39.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call mnemonic_compute_checksum twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_crypto_mnemonic_bip39: PASSED only if they match.

import "std/fintech_defi/crypto_mnemonic_bip39.oo";

pub fn main() {
    let g0_a = mnemonic_compute_checksum(0);
    let g0_b = mnemonic_compute_checksum(0);
    if g0_a != g0_b {
        println("FAIL mnemonic_compute_checksum");
        process_exit(1);
    }
    println("prod_gr_crypto_mnemonic_bip39: PASSED");
}
