// # Product prove std/tda_topology/rips_graph_skeleton.oo
//
// Logline: Fail-closed emit+gcc+run asserts rips_graph_count_components is a real value.
//
// Setup: Isolated emit-c. Imports std/tda_topology/rips_graph_skeleton.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call rips_graph_count_components twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_rips_graph_skeleton: PASSED only if they match.

import "std/tda_topology/rips_graph_skeleton.oo";

pub fn main() {
    let g0_a = rips_graph_count_components(list_new());
    let g0_b = rips_graph_count_components(list_new());
    if g0_a != g0_b {
        println("FAIL rips_graph_count_components");
        process_exit(1);
    }
    println("prod_gr_rips_graph_skeleton: PASSED");
}
