// # Product prove std/db_columnar/columnar_chimp_float_codec.oo
//
// Logline: Fail-closed emit+gcc+run asserts chimp_decode_stream is a real value.
//
// Setup: Isolated emit-c. Imports std/db_columnar/columnar_chimp_float_codec.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call chimp_decode_stream twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_columnar_chimp_float_codec: PASSED only if they match.

import "std/db_columnar/columnar_chimp_float_codec.oo";

pub fn main() {
    let g2_oa: ChimpCompressedStream = chimp_stream_new(2);
    let g2_ob: ChimpCompressedStream = chimp_stream_new(2);
    let g2_la = chimp_decode_stream(g2_oa);
    let g2_lb = chimp_decode_stream(g2_ob);
    let g2_a = list_len(g2_la);
    let g2_b = list_len(g2_lb);
    if g2_a != g2_b {
        println("FAIL chimp_decode_stream");
        process_exit(1);
    }
    println("prod_g2_columnar_chimp_float_codec: PASSED");
}
