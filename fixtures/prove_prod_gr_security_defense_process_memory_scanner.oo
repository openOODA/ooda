// # Product prove std/security_defense/process_memory_scanner.oo
//
// Logline: Fail-closed emit+gcc+run asserts memory_scanner_detect_nop_sled is a real value.
//
// Setup: Isolated emit-c. Imports std/security_defense/process_memory_scanner.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call memory_scanner_detect_nop_sled twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_process_memory_scanner: PASSED only if they match.

import "std/security_defense/process_memory_scanner.oo";

pub fn main() {
    let g0_a = memory_scanner_detect_nop_sled(list_new(), 0, 0);
    let g0_b = memory_scanner_detect_nop_sled(list_new(), 0, 0);
    if g0_a != g0_b {
        println("FAIL memory_scanner_detect_nop_sled");
        process_exit(1);
    }
    println("prod_gr_process_memory_scanner: PASSED");
}
