// # Product prove std/gis_spatial/utm_projection.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/gis_spatial/utm_projection.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_spatial/utm_projection.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_utm_projection: PASSED only if they match.

import "std/gis_spatial/utm_projection.oo";

pub fn main() {
    let utm_projection_a = utm_calc_zone(0.0);
    let utm_projection_b = utm_calc_zone(0.0);
    if utm_projection_a != utm_projection_b {
        println("FAIL utm_projection");
        process_exit(1);
    }
    println("prod_ap_utm_projection: PASSED");
}
