// # Product prove std/edge/inference_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts model_config_full is deterministic.
//
// Setup: Isolated emit-c. Imports std/edge/inference_ops.oo.
//
// Beats:
//   1. Call model_config_full twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_inference_ops: PASSED only if they match.

import "std/edge/inference_ops.oo";

pub fn main() {
    let inference_ops_mark: Int = 0;
    if inference_ops_mark != 0 {
        process_exit(1);
    }
    let a: ModelConfig = model_config_full(0, 0, 0, 0, 0, 0, 0, 0);
    let b: ModelConfig = model_config_full(0, 0, 0, 0, 0, 0, 0, 0);
    if (a).model_id != (b).model_id {
        println("FAIL model_config_full");
        process_exit(1);
    }
    println("prod_inference_ops: PASSED");
}
