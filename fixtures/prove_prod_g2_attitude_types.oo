// # Product prove std/aero/attitude_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts att_vec3_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/attitude_types.oo.
//
// Beats:
//   1. Call att_vec3_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_attitude_types: PASSED only if they match.

import "std/aero/attitude_types.oo";

pub fn main() {
    let attitude_types_mark: Int = 0;
    if attitude_types_mark != 0 {
        process_exit(1);
    }
    let a: AttVec3 = att_vec3_new(0, 0, 0);
    let b: AttVec3 = att_vec3_new(0, 0, 0);
    if (a).x != (b).x {
        println("FAIL att_vec3_new");
        process_exit(1);
    }
    println("prod_g2_attitude_types: PASSED");
}
