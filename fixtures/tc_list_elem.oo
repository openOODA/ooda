// # List element type mismatch
//
// Logline: Check refuses list_push of a String into Int list ys.
//
// Setup: Single-file probe. The list name must be ys. Line of the push stays under 50.
//
// Beats:
//   1. Bind ys as List[Int].
//   2. Push a string literal.
//   3. check must ERR type list element mismatch.

pub fn main() {
    let mut ys: List[Int] = list_new();
    ys = list_push(ys, "hi");
}
