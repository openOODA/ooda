// # Product prove std/satellite_dvb/gnss_carrier_phase_rtk.oo
//
// Logline: Fail-closed emit+gcc+run asserts rtk_single_difference_phase is deterministic.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/gnss_carrier_phase_rtk.oo.
//
// Beats:
//   1. Call rtk_single_difference_phase twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gnss_carrier_phase_rtk: PASSED only if they match.

import "std/satellite_dvb/gnss_carrier_phase_rtk.oo";

pub fn main() {
    let gnss_carrier_phase_rtk_mark: Int = 0;
    if gnss_carrier_phase_rtk_mark != 0 {
        process_exit(1);
    }
    let a: Float = rtk_single_difference_phase(0.0, 0.0);
    let b: Float = rtk_single_difference_phase(0.0, 0.0);
    if a != b {
        println("FAIL rtk_single_difference_phase");
        process_exit(1);
    }
    println("prod_gnss_carrier_phase_rtk: PASSED");
}
