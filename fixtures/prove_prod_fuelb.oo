// # Product sec fuel budget prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/sec/fuel_budget.oo.
//
// Setup: Product std/sec/fuel_budget.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. new(10) left 10. after 3 is 7. after 20 is -1. new(0) left 0.
//   9. Exit 1 before PASSED on a miss.

import "std/sec/fuel_budget.oo";

pub fn main() {
    let b: FuelBudget = fuel_new(10);
    let n: Int = fuel_left(b);
    if n != 10 {
        println("FAIL fuel left");
        process_exit(1);
    }
    let a: Int = fuel_after(b, 3);
    if a != 7 {
        println("FAIL fuel after");
        process_exit(1);
    }
    let d: Int = fuel_after(b, 20);
    if d != -1 {
        println("FAIL fuel deny");
        process_exit(1);
    }
    let z: Int = fuel_left(fuel_new(0));
    if z != 0 {
        println("FAIL fuel empty");
        process_exit(1);
    }
    if fuel_can(b, 3) == false {
        println("FAIL fuel can");
        process_exit(1);
    }
    if fuel_can(b, 0) {
        println("FAIL fuel cost0");
        process_exit(1);
    }
    println("prod_fuelb: PASSED");
}
