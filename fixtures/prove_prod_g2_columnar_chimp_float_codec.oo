// # Product prove std/db_columnar/columnar_chimp_float_codec.oo
//
// Logline: Fail-closed emit+gcc+run asserts chimp_stream_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/columnar_chimp_float_codec.oo.
//
// Beats:
//   1. Call chimp_stream_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_columnar_chimp_float_codec: PASSED only if they match.

import "std/db_columnar/columnar_chimp_float_codec.oo";

pub fn main() {
    let columnar_chimp_float_codec_mark: Int = 0;
    if columnar_chimp_float_codec_mark != 0 {
        process_exit(1);
    }
    let a: ChimpCompressedStream = chimp_stream_new(0);
    let b: ChimpCompressedStream = chimp_stream_new(0);
    if (a).first_value_bits != (b).first_value_bits {
        println("FAIL chimp_stream_new");
        process_exit(1);
    }
    println("prod_g2_columnar_chimp_float_codec: PASSED");
}
