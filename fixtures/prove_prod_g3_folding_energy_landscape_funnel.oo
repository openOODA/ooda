// # Product prove std/protein_folding/folding_energy_landscape_funnel.oo
//
// Logline: Fail-closed emit+gcc+run asserts funnel_calc_q_pair is deterministic.
//
// Setup: Isolated emit-c. Imports std/protein_folding/folding_energy_landscape_funnel.oo.
//
// Beats:
//   1. Call funnel_calc_q_pair twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_folding_energy_landscape_funnel: PASSED only if they match.

import "std/protein_folding/folding_energy_landscape_funnel.oo";

pub fn main() {
    let folding_energy_landscape_funnel_mark: Int = 0;
    if folding_energy_landscape_funnel_mark != 0 {
        process_exit(1);
    }
    let a: Float = funnel_calc_q_pair(0.0, 0.0, 0.0, 0.0);
    let b: Float = funnel_calc_q_pair(0.0, 0.0, 0.0, 0.0);
    if a != b {
        println("FAIL funnel_calc_q_pair");
        process_exit(1);
    }
    println("prod_folding_energy_landscape_funnel: PASSED");
}
