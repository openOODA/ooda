// # Product prove std/graph_networks/cuckoo_filter_probabilistic.oo
//
// Logline: Fail-closed emit+gcc+run asserts cuckoo_calc_fingerprint is a real value.
//
// Setup: Isolated emit-c. Imports std/graph_networks/cuckoo_filter_probabilistic.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call cuckoo_calc_fingerprint twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_cuckoo_filter_probabilistic: PASSED only if they match.

import "std/graph_networks/cuckoo_filter_probabilistic.oo";

pub fn main() {
    let g0_a = cuckoo_calc_fingerprint(2);
    let g0_b = cuckoo_calc_fingerprint(2);
    if g0_a != g0_b {
        println("FAIL cuckoo_calc_fingerprint");
        process_exit(1);
    }
    println("prod_g0_cuckoo_filter_probabilistic: PASSED");
}
