// # Product prove std/net/headers.oo
//
// Logline: Fail-closed emit+gcc+run asserts headers_has is deterministic.
//
// Setup: Isolated emit-c. Imports std/net/headers.oo.
//
// Beats:
//   1. Call headers_has twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_headers: PASSED only if they match.

import "std/net/headers.oo";

pub fn main() {
    let obj_a: HeaderMap = headers_new();
    let obj_b: HeaderMap = headers_new();
    let a: Bool = headers_has(obj_a, "x");
    let b: Bool = headers_has(obj_b, "x");
    if a != b {
        println("FAIL headers_has");
        process_exit(1);
    }
    println("prod_headers: PASSED");
}
