// # Product env map prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/os/env_vars.oo empty map and expand.
//
// Setup: Tree oodac emit-c. Calls ooda/std/os/env_vars.oo. Destub none. No EnvCap.
//
// Beats:
//   1. env_map_len(env_map_new()) is 0.
//   2. env_map_expand_str of hello with empty map is hello.
//   3. env_map_get missing key is_err.
//   4. Exit 1 on any miss. Print prod_env_vars: PASSED only if all hold.

import "std/os/env_vars.oo";

pub fn main() {
    let m: EnvMap = env_map_new();
    let n: Int = env_map_len(m);
    if n != 0 {
        println("FAIL env_map_len");
        process_exit(1);
    }
    let e: String = env_map_expand_str(m, "hello");
    if e != "hello" {
        println("FAIL env_map_expand_str");
        process_exit(1);
    }
    let r: Result[String, String] = env_map_get(m, "PATH");
    if r.is_ok() {
        println("FAIL env_map_get empty");
        process_exit(1);
    }
    println("prod_env_vars: PASSED");
}
