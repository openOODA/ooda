// # Product prove std/sec/crypto/hsm_stubs.oo
//
// Logline: Fail-closed emit+check asserts hsm_module_ready is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/hsm_stubs.oo.
//
// Beats:
//   1. Call hsm_module_ready twice with no args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_hsm_stubs: PASSED only if they match.

import "std/sec/crypto/hsm_stubs.oo";

pub fn main() {
    let hsm_stubs_mark: Int = 0;
    if hsm_stubs_mark != 0 { process_exit(1); }
    let a: Bool = hsm_module_ready();
    let b: Bool = hsm_module_ready();
    if a != b { process_exit(1); }
    println("prod_hsm_stubs: PASSED");
}
