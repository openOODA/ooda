// # Phase 1 emit retain prove
//
// Logline: Fail-closed emit of a dotted String field alias (must retain).
//
// Setup: Local RetainBox.s aliased to a let String; used after the box is live.
//
// Beats:
//   1. Alias b.s to t; t is "hi".
//   2. Exit 1 before PASSED on a miss.

type RetainBox = struct {
    s: String
};

pub fn main() {
    let s: String = "h" + "i";
    let b: RetainBox = RetainBox { s: s };
    let t: String = b.s;
    if t != "hi" {
        println("FAIL retain alias");
        process_exit(1);
    }
    let n: Int = chars_len(t);
    if n != 2 {
        println("FAIL retain len");
        process_exit(1);
    }
    let t2: String = t + "!";
    if t2 != "hi!" {
        println("FAIL retain concat");
        process_exit(1);
    }
    println("prod_retain: PASSED");
}
