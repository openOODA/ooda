// # Product prove std/simd/simd_bitselect.oo
//
// Logline: Fail-closed emit+gcc+run asserts simd_bitselect_i32 is deterministic.
//
// Setup: Isolated emit-c. Imports std/simd/simd_bitselect.oo.
//
// Beats:
//   1. Call simd_bitselect_i32 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_simd_bitselect: PASSED only if they match.

import "std/simd/simd_bitselect.oo";

pub fn main() {
    let a = simd_bitselect_i32(0, 0, 0);
    let b = simd_bitselect_i32(0, 0, 0);
    if a != b {
        println("FAIL simd_bitselect_i32");
        process_exit(1);
    }
    println("prod_simd_bitselect: PASSED");
}
