// # ArenaCap is its own token
//
// Logline: Create, alloc, and reset a bump arena under &ArenaCap, not AllocCap.
//
// Setup: OPEN-84. oo_cap_grant_arena + arena_* accept ArenaCap.
//
// Beats:
//   1. arena_create 4096 with ArenaCap.
//   2. arena_alloc 16 then reset.
//   3. Print PASSED.

pub fn main(arena: &ArenaCap) {
    let a: Result[String, String] = arena_create(arena, 4096);
    if a.is_err() {
        println("FAIL create");
        process_exit(1);
    }
    let b: Result[String, String] = arena_alloc(arena, 0, 16);
    if b.is_err() {
        println("FAIL alloc");
        process_exit(1);
    }
    let c: Result[String, String] = arena_reset(arena, 0);
    if c.is_err() {
        println("FAIL reset");
        process_exit(1);
    }
    println("open84_arena_cap: PASSED");
}
