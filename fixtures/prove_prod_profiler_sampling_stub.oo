// # Product prove std/diag/profiler_sampling_stub.oo
//
// Logline: Fail-closed emit+gcc+run asserts profiler_sampler_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/diag/profiler_sampling_stub.oo.
//
// Beats:
//   1. Call profiler_sampler_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_profiler_sampling_stub: PASSED only if they match.

import "std/diag/profiler_sampling_stub.oo";

pub fn main() {
    let obj = profiler_sampler_new(0);
    let a = obj.freq_hz;
    let b = obj.freq_hz;
    if a != b {
        println("FAIL profiler_sampler_new");
        process_exit(1);
    }
    println("prod_profiler_sampling_stub: PASSED");
}
