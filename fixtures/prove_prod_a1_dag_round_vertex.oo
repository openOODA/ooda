// # Product prove std/bft_consensus/dag_round_vertex.oo
//
// Logline: Fail-closed emit+gcc+run asserts dag_vertex_is_monotonic_child is deterministic.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/dag_round_vertex.oo.
//
// Beats:
//   1. Call dag_vertex_is_monotonic_child twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dag_round_vertex: PASSED only if they match.

import "std/bft_consensus/dag_round_vertex.oo";

pub fn main() {
    let dag_round_vertex_mark: Int = 0;
    if dag_round_vertex_mark != 0 {
        process_exit(1);
    }
    let a: Bool = dag_vertex_is_monotonic_child(0, 0);
    let b: Bool = dag_vertex_is_monotonic_child(0, 0);
    if a != b {
        println("FAIL dag_vertex_is_monotonic_child");
        process_exit(1);
    }
    println("prod_dag_round_vertex: PASSED");
}
