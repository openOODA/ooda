// # Product prove std/tda_topology/spatial_distance_matrix.oo
//
// Logline: Fail-closed emit+gcc+run asserts distance_matrix_index is a real value.
//
// Setup: Isolated emit-c. Imports std/tda_topology/spatial_distance_matrix.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call distance_matrix_index twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_spatial_distance_matrix: PASSED only if they match.

import "std/tda_topology/spatial_distance_matrix.oo";

pub fn main() {
    let g0_a = distance_matrix_index(0, 0, 0);
    let g0_b = distance_matrix_index(0, 0, 0);
    if g0_a != g0_b {
        println("FAIL distance_matrix_index");
        process_exit(1);
    }
    println("prod_gr_spatial_distance_matrix: PASSED");
}
