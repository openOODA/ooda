// # Product prove std/astrodynamics/sgp4_propagator.oo
//
// Logline: Fail-closed emit+gcc+run asserts sgp4_minutes is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrodynamics/sgp4_propagator.oo.
//
// Beats:
//   1. Call sgp4_minutes twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sgp4_propagator: PASSED only if they match.

import "std/astrodynamics/sgp4_propagator.oo";

pub fn main() {
    let sgp4_propagator_mark: Int = 0;
    if sgp4_propagator_mark != 0 {
        process_exit(1);
    }
    let a: Int = sgp4_minutes();
    let b: Int = sgp4_minutes();
    if a != b {
        println("FAIL sgp4_minutes");
        process_exit(1);
    }
    println("prod_sgp4_propagator: PASSED");
}
