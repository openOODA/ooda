// # Product prove std/graph_networks/tapestry_dolr_overlay.oo
//
// Logline: Fail-closed emit+gcc+run asserts tapestry_get_digit_at_level is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_networks/tapestry_dolr_overlay.oo.
//
// Beats:
//   1. Call tapestry_get_digit_at_level twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_tapestry_dolr_overlay: PASSED only if they match.

import "std/graph_networks/tapestry_dolr_overlay.oo";

pub fn main() {
    let tapestry_dolr_overlay_mark: Int = 0;
    if tapestry_dolr_overlay_mark != 0 {
        process_exit(1);
    }
    let a: Int = tapestry_get_digit_at_level(0, 0, 0);
    let b: Int = tapestry_get_digit_at_level(0, 0, 0);
    if a != b {
        println("FAIL tapestry_get_digit_at_level");
        process_exit(1);
    }
    println("prod_g2_tapestry_dolr_overlay: PASSED");
}
