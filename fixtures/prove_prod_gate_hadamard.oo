// # Product prove std/quantum/gate_hadamard.oo
//
// Logline: Fail-closed emit+gcc+run asserts hadamard_matrix is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum/gate_hadamard.oo.
//
// Beats:
//   1. Call hadamard_matrix twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gate_hadamard: PASSED only if they match.

import "std/quantum/gate_hadamard.oo";

pub fn main() {
    let gate_hadamard_mark: Int = 0;
    if gate_hadamard_mark != 0 {
        process_exit(1);
    }
    let a: Matrix2x2 = hadamard_matrix();
    let b: Matrix2x2 = hadamard_matrix();
    if (a).m00 != (b).m00 {
        println("FAIL hadamard_matrix");
        process_exit(1);
    }
    println("prod_gate_hadamard: PASSED");
}
