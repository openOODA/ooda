// # Product prove std/web_protocols/webrtc_sdp_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts sdp_value_n is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_protocols/webrtc_sdp_parser.oo.
//
// Beats:
//   1. Call sdp_value_n twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_webrtc_sdp_parser: PASSED only if they match.

import "std/web_protocols/webrtc_sdp_parser.oo";
import "std/web_protocols/webrtc_sdp_parser_lines.oo";

pub fn main() {
    let webrtc_sdp_parser_mark: Int = 0;
    if webrtc_sdp_parser_mark != 0 {
        process_exit(1);
    }
    let a: Int = sdp_value_n(0, 0);
    let b: Int = sdp_value_n(0, 0);
    if a != b {
        println("FAIL sdp_value_n");
        process_exit(1);
    }
    println("prod_g2_webrtc_sdp_parser: PASSED");
}
