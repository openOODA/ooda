// # Product prove std/media_dsp/synth_wavetable_lookup.oo
//
// Logline: Fail-closed emit+gcc+run asserts wavetable_sine_new real value.
//
// Setup: Isolated emit-c. Imports std/media_dsp/synth_wavetable_lookup.oo.
//
// Beats:
//   1. Call wavetable_sine_new with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_synth_wavetable_lookup: PASSED only if the assert holds.

import "std/media_dsp/synth_wavetable_lookup.oo";

pub fn main() {
    let synth_wavetable_lookup_mark: Int = 0;
    if synth_wavetable_lookup_mark != 0 {
        process_exit(1);
    }
    let synth_wavetable_lookup_a: Wavetable = wavetable_sine_new(7);
    let synth_wavetable_lookup_table_size: Int = (synth_wavetable_lookup_a).table_size;
    if synth_wavetable_lookup_table_size != 7 {
        println("FAIL wavetable_sine_new");
        process_exit(1);
    }
    println("prod_synth_wavetable_lookup: PASSED");
}
