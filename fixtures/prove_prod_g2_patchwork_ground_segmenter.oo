// # Product prove std/lidar_perception/patchwork_ground_segmenter.oo
//
// Logline: Fail-closed emit+gcc+run asserts czm_get_sector_index is deterministic.
//
// Setup: Isolated emit-c. Imports std/lidar_perception/patchwork_ground_segmenter.oo.
//
// Beats:
//   1. Call czm_get_sector_index twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_patchwork_ground_segmenter: PASSED only if they match.

import "std/lidar_perception/patchwork_ground_segmenter.oo";

pub fn main() {
    let patchwork_ground_segmenter_mark: Int = 0;
    if patchwork_ground_segmenter_mark != 0 {
        process_exit(1);
    }
    let a: Int = czm_get_sector_index(0.0, 0);
    let b: Int = czm_get_sector_index(0.0, 0);
    if a != b {
        println("FAIL czm_get_sector_index");
        process_exit(1);
    }
    println("prod_g2_patchwork_ground_segmenter: PASSED");
}
