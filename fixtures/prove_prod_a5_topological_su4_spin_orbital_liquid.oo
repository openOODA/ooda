// # Product prove std/quantum_topological/topological_su4_spin_orbital_liquid.oo
//
// Logline: Fail-closed emit+gcc+run asserts su4_casimir_eigenvalue is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/topological_su4_spin_orbital_liquid.oo.
//
// Beats:
//   1. Call su4_casimir_eigenvalue twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_topological_su4_spin_orbital_liquid: PASSED only if they match.

import "std/quantum_topological/topological_su4_spin_orbital_liquid.oo";

pub fn main() {
    let topological_su4_spin_orbital_liquid_mark: Int = 0;
    if topological_su4_spin_orbital_liquid_mark != 0 {
        process_exit(1);
    }
    let a: Float = su4_casimir_eigenvalue();
    let b: Float = su4_casimir_eigenvalue();
    if a != b {
        println("FAIL su4_casimir_eigenvalue");
        process_exit(1);
    }
    println("prod_topological_su4_spin_orbital_liquid: PASSED");
}
