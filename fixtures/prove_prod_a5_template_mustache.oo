// # Product prove std/web_ecosystem/template_mustache.oo
//
// Logline: Fail-closed emit+gcc+run asserts mustache_find_var is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/template_mustache.oo.
//
// Beats:
//   1. Call mustache_find_var twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_template_mustache: PASSED only if they match.

import "std/web_ecosystem/template_mustache.oo";

pub fn main() {
    let template_mustache_mark: Int = 0;
    if template_mustache_mark != 0 {
        process_exit(1);
    }
    let a: Int = mustache_find_var(0, 0, 0, 0, 0);
    let b: Int = mustache_find_var(0, 0, 0, 0, 0);
    if a != b {
        println("FAIL mustache_find_var");
        process_exit(1);
    }
    println("prod_template_mustache: PASSED");
}
