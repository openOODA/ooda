// # Product prove std/sec/crypto/bulletproofs_stubs.oo
//
// Logline: Fail-closed verification that Bulletproofs cryptographic operations and parameter generation are deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/bulletproofs_stubs.oo.
//
// Beats:
//   1. Call modular arithmetic operations bp_mod_add, bp_mod_mul, and bp_mod_pow.
//   2. Create Pedersen commitments and verify generators consistency.
//   3. Generate and verify Bulletproof range proofs.
//   4. Print prod_g4_sec_bulletproofs_stubs: PASSED and exit 0.

import "std/sec/crypto/bulletproofs_stubs.oo";

pub fn main() {
    let mod_val: Int = 1009;
    let g_base: Int = 11;
    let h_base: Int = 17;
    let val: Int = 42;
    let blinding: Int = 99;

    let add_a: Int = bp_mod_add(15, 27, mod_val);
    let add_b: Int = bp_mod_add(15, 27, mod_val);
    if add_a != add_b || add_a != 42 {
        println("FAIL bp_mod_add");
        process_exit(1);
    }

    let mul_a: Int = bp_mod_mul(6, 7, mod_val);
    let mul_b: Int = bp_mod_mul(6, 7, mod_val);
    if mul_a != mul_b || mul_a != 42 {
        println("FAIL bp_mod_mul");
        process_exit(1);
    }

    let pow_a: Int = bp_mod_pow(2, 8, mod_val);
    let pow_b: Int = bp_mod_pow(2, 8, mod_val);
    if pow_a != pow_b || pow_a != 256 {
        println("FAIL bp_mod_pow");
        process_exit(1);
    }

    let pcomm_a: PedersenCommitment = pedersen_commitment_create(g_base, h_base, val, blinding, mod_val);
    let pcomm_b: PedersenCommitment = pedersen_commitment_create(g_base, h_base, val, blinding, mod_val);
    if (pcomm_a).commitment != (pcomm_b).commitment {
        println("FAIL pedersen_commitment_create");
        process_exit(1);
    }
    if !(pcomm_a).is_valid {
        println("FAIL pedersen_commitment is_valid");
        process_exit(1);
    }

    let gens_a: BulletproofGenerators = bulletproof_generators_create(8, 1, g_base, h_base, mod_val);
    let gens_b: BulletproofGenerators = bulletproof_generators_create(8, 1, g_base, h_base, mod_val);
    if (gens_a).gens_capacity != (gens_b).gens_capacity || (gens_a).gens_capacity != 8 {
        println("FAIL bulletproof_generators_create");
        process_exit(1);
    }

    let gens_ok: Bool = bulletproof_generators_verify(gens_a);
    if !gens_ok {
        println("FAIL bulletproof_generators_verify");
        process_exit(1);
    }

    let rp_a: RangeProof = bulletproof_range_prove(val, 0, 100, blinding, 8, gens_a, mod_val);
    let rp_b: RangeProof = bulletproof_range_prove(val, 0, 100, blinding, 8, gens_a, mod_val);
    if (rp_a).is_valid != (rp_b).is_valid || !(rp_a).is_valid {
        println("FAIL bulletproof_range_prove");
        process_exit(1);
    }

    let v_ok: Bool = bulletproof_range_verify(rp_a, (pcomm_a).commitment, gens_a, mod_val);
    if !v_ok {
        println("FAIL bulletproof_range_verify");
        process_exit(1);
    }

    println("prod_g4_sec_bulletproofs_stubs: PASSED");
    process_exit(0);
}
