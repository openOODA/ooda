// # Product prove std/neuro_bci/bci_adaptive_drift_tracker.oo
//
// Logline: Fail-closed emit+gcc+run asserts drift_tracker_default real value.
//
// Setup: Isolated emit-c. Imports std/neuro_bci/bci_adaptive_drift_tracker.oo.
//
// Beats:
//   1. Call drift_tracker_default with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_bci_adaptive_drift_tracker: PASSED only if the assert holds.

import "std/neuro_bci/bci_adaptive_drift_tracker.oo";

pub fn main() {
    let bci_adaptive_drift_tracker_mark: Int = 0;
    if bci_adaptive_drift_tracker_mark != 0 {
        process_exit(1);
    }
    let bci_adaptive_drift_tracker_a = drift_tracker_default(2.0);
    let bci_adaptive_drift_tracker_mean1: Float = (bci_adaptive_drift_tracker_a).mean1;
    if !(bci_adaptive_drift_tracker_mean1 == 0.0) {
        println("FAIL drift_tracker_default");
        process_exit(1);
    }
    println("prod_bci_adaptive_drift_tracker: PASSED");
}
