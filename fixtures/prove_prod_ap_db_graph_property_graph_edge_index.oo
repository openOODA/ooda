//   3. Print prod_ap_property_graph_edge_index: PASSED only if they match.

import "std/db_graph/property_graph_edge_index.oo";

pub fn main() {
    let property_graph_edge_index_a = edge_index_catalog_new();
    let property_graph_edge_index_b = edge_index_catalog_new();
    if property_graph_edge_index_a.partition_count != property_graph_edge_index_b.partition_count {
        println("FAIL property_graph_edge_index");
        process_exit(1);
