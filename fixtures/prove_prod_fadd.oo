// # Product Float + prove
//
// Logline: Fail-closed emit+gcc+run of shipped stats_fadd.
//
// Setup: Product std/math/stats.oo. Emit-c must not concat Float +.
//
// Beats:
//   1. stats_fadd(1.0, 2.0) is 3.0.
//   2. stats_fadd(0.5, 0.5) is 1.0.
//   3. Exit 1 before PASSED on a miss.

import "std/math/stats.oo";

pub fn main() {
    let s: Float = stats_fadd(1.0, 2.0);
    if s != 3.0 {
        println("FAIL fadd 3");
        process_exit(1);
    }
    let h: Float = stats_fadd(0.5, 0.5);
    if h != 1.0 {
        println("FAIL fadd 1");
        process_exit(1);
    }
    println("prod_fadd: PASSED");
}
