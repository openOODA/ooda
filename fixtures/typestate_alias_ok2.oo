// # Alias typestate send
//
// Logline: Alias a Closed sock, connect through the alias, and send on the original handle.
//
// Beats:
//   1. Open a Closed sock and bind it to a second name.
//   2. Connect through the alias.
//   3. Send on the original handle.

// TYPESTATE: Sock Closed Open
// TYPESTATE fn open_sock: -> Closed
// TYPESTATE fn connect: Closed -> Open
// TYPESTATE fn send: Open -> Open

fn open_sock() -> Int { return 1; }
fn connect(s: Int) { let x = s; }
fn send(s: Int) { let x = s; }

pub fn main() {
    let s = open_sock();
    let t = s;
    connect(t);
    send(s);
}
