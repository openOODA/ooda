// # Product prove std/simd/simd_quat_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/simd/simd_quat_ops.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/simd/simd_quat_ops.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_simd_quat_ops: PASSED only if they match.

import "std/simd/simd_quat_ops.oo";

pub fn main() {
    let simd_quat_ops_a = simd_quat_new(0.0, 0.0, 0.0, 0.0);
    let simd_quat_ops_b = simd_quat_new(0.0, 0.0, 0.0, 0.0);
    if simd_quat_ops_a.x != simd_quat_ops_b.x {
        println("FAIL simd_quat_ops");
        process_exit(1);
    }
    println("prod_ap_simd_quat_ops: PASSED");
}
