// # Product prove std/astrodynamics/re_entry_thermal_profile.oo
//
// Logline: Fail-closed verification that atmospheric re-entry dynamics, ballistic coefficients, and aerothermal profiles are deterministic.
//
// Setup: Isolated emit-c. Imports std/astrodynamics/re_entry_thermal_profile.oo.
//
// Beats:
//   1. Compute ballistic coefficient and Sutton-Graves stagnation heat flux.
//   2. Compute peak deceleration g-load and peak heating altitude.
//   3. Step re-entry vehicle kinematics and thermal state forward.
//   4. Print prod_g4_astrodyn_reentry: PASSED and exit 0.

import "std/astrodynamics/re_entry_thermal_profile.oo";

pub fn main() {
    let re_entry_thermal_profile_mark: Int = 0;
    if re_entry_thermal_profile_mark != 0 {
        process_exit(1);
    }

    let beta_a: Float = ballistic_coefficient(5000.0, 1.2, 4.0);
    let beta_b: Float = ballistic_coefficient(5000.0, 1.2, 4.0);
    if beta_a != beta_b || beta_a <= 0.0 {
        println("FAIL ballistic_coefficient");
        process_exit(1);
    }

    let q_flux_a: Float = sutton_graves_heat_flux(0.001, 7500.0, 0.5);
    let q_flux_b: Float = sutton_graves_heat_flux(0.001, 7500.0, 0.5);
    if q_flux_a != q_flux_b || q_flux_a <= 0.0 {
        println("FAIL sutton_graves_heat_flux");
        process_exit(1);
    }

    let g_load_a: Float = peak_reentry_deceleration_g(7800.0, 0.05);
    let g_load_b: Float = peak_reentry_deceleration_g(7800.0, 0.05);
    if g_load_a != g_load_b || g_load_a <= 0.0 {
        println("FAIL peak_reentry_deceleration_g");
        process_exit(1);
    }

    let peak_alt_a: Float = peak_heating_altitude(7200.0, beta_a, 0.05);
    let peak_alt_b: Float = peak_heating_altitude(7200.0, beta_b, 0.05);
    if peak_alt_a != peak_alt_b || peak_alt_a <= 0.0 {
        println("FAIL peak_heating_altitude");
        process_exit(1);
    }

    let veh: ReEntryVehicle = ReEntryVehicle {
        mass_kg: 5000.0,
        nose_radius_m: 0.5,
        ref_area_m2: 4.0,
        drag_coeff: 1.2,
    };
    let st_init: ReEntryState = ReEntryState {
        altitude_m: 80000.0,
        velocity_m_s: 7500.0,
        flight_path_angle_rad: 0.05,
        heat_flux_w_m2: 0.0,
        g_load: 0.0,
    };

    let st_next_a: ReEntryState = reentry_state_step(veh, st_init, 0.1);
    let st_next_b: ReEntryState = reentry_state_step(veh, st_init, 0.1);

    if (st_next_a).altitude_m != (st_next_b).altitude_m || (st_next_a).velocity_m_s != (st_next_b).velocity_m_s {
        println("FAIL reentry_state_step altitude or velocity");
        process_exit(1);
    }

    if (st_next_a).heat_flux_w_m2 != (st_next_b).heat_flux_w_m2 || (st_next_a).g_load != (st_next_b).g_load {
        println("FAIL reentry_state_step heat_flux or g_load");
        process_exit(1);
    }

    println("prod_g4_astrodyn_reentry: PASSED");
    process_exit(0);
}
