// # Product prove std/quantum_topological/topological_surface_code_defect_braiding.oo
//
// Logline: Fail-closed emit+gcc+run asserts defect_hole_new value or determinism.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/topological_surface_code_defect_braiding.oo.
//
// Beats:
//   1. Call defect_hole_new twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_topological_surface_code_defect_braiding: PASSED only if asserts hold.

import "std/quantum_topological/topological_surface_code_defect_braiding.oo";

pub fn main() {
    let topological_surface_code_defect_braiding_a: DefectHole = defect_hole_new(0, 0, 0, 0, 0);
    let topological_surface_code_defect_braiding_b: DefectHole = defect_hole_new(0, 0, 0, 0, 0);
    if topological_surface_code_defect_braiding_a.hole_id != topological_surface_code_defect_braiding_b.hole_id {
        println("FAIL defect_hole_new");
        process_exit(1);
    }
    println("prod_topological_surface_code_defect_braiding: PASSED");
}
