// # Nested const if true println no else
//
// Logline: Print nest-ne when both outer and inner if true and there is no else.
//
// Setup: No imports. One public main.
//
// Beats:
//   1. Declare public main.
//   2. If true wrap if true print nest-ne.
//   3. Leave no else and no other statements.

pub fn main() {
    if true {
        if true {
            println("nest-ne");
        }
    }
}
