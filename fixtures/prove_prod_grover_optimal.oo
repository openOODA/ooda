// # Product prove std/quantum/grover_search.oo
//
// Logline: Fail-closed emit+gcc+run asserts grover_optimal_iterations is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum/grover_search.oo.
//
// Beats:
//   1. Call grover_optimal_iterations twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_grover_optimal: PASSED only if they match.

import "std/quantum/grover_search.oo";

pub fn main() {
    let grover_search_mark: Int = 0;
    if grover_search_mark != 0 { process_exit(1); }
    let a: Int = grover_optimal_iterations(3);
    let b: Int = grover_optimal_iterations(3);
    if a != b {
        println("FAIL grover_optimal_iterations");
        process_exit(1);
    }
    println("prod_grover_optimal: PASSED");
}
