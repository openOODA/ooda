// # Product prove std/aero/formation_maneuver.oo
//
// Logline: Fail-closed verification that orbital formation maneuvering and proximity calculations are deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/formation_maneuver.oo.
//
// Beats:
//   1. Transform Cartesian states to LVLH relative states.
//   2. Compute Relative Orbit Elements (ROE) between Keplerian orbits.
//   3. Calculate drift correction delta-V and relative distance.
//   4. Print prod_g4_aero_formation_maneuver: PASSED and exit 0.

import "std/aero/formation_maneuver.oo";
import "std/aero/formation_maneuver_lvlh.oo";
import "std/aero/formation_maneuver_roe.oo";
import "std/aero/formation_maneuver_safety.oo";

pub fn main() {
    let formation_maneuver_mark: Int = 0;
    if formation_maneuver_mark != 0 {
        process_exit(1);
    }
    let s1: RelativeState = relative_state_zero();
    let s2: RelativeState = relative_state_zero();

    let dist_a: Float = relative_distance(s1, s2);
    let dist_b: Float = relative_distance(s1, s2);
    if dist_a != dist_b {
        println("FAIL relative_distance");
        process_exit(1);
    }

    let spd_a: Float = relative_speed(s1, s2);
    let spd_b: Float = relative_speed(s1, s2);
    if spd_a != spd_b {
        println("FAIL relative_speed");
        process_exit(1);
    }

    let min_d_a: Float = formation_minimum_distance(s1, 0.001, 100.0, 10);
    let min_d_b: Float = formation_minimum_distance(s1, 0.001, 100.0, 10);
    if min_d_a != min_d_b {
        println("FAIL formation_minimum_distance");
        process_exit(1);
    }

    let roe_a: RelativeKeplerianElements = compute_roe(7000000.0, 0.001, 0.5, 0.0, 0.0, 0.0, 7000100.0, 0.001, 0.5, 0.0, 0.0, 0.0);
    let roe_b: RelativeKeplerianElements = compute_roe(7000000.0, 0.001, 0.5, 0.0, 0.0, 0.0, 7000100.0, 0.001, 0.5, 0.0, 0.0, 0.0);
    if (roe_a).delta_a != (roe_b).delta_a {
        println("FAIL compute_roe delta_a");
        process_exit(1);
    }

    let dv: Vec3 = calculate_drift_correction_dv(s1, 0.001);
    if (dv).x != 0.0 || (dv).z != 0.0 {
        println("FAIL calculate_drift_correction_dv");
        process_exit(1);
    }

    println("prod_g4_aero_formation_maneuver: PASSED");
    process_exit(0);
}
