// # Product prove std/quantum_advanced/shor_continued_fraction.oo
//
// Logline: Fail-closed emit+gcc+run asserts gcd is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/shor_continued_fraction.oo.
//
// Beats:
//   1. Call gcd twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_shor_continued_fraction: PASSED only if they match.

import "std/quantum_advanced/shor_continued_fraction.oo";

pub fn main() {
    let shor_continued_fraction_mark: Int = 0;
    if shor_continued_fraction_mark != 0 {
        process_exit(1);
    }
    let a: Int = gcd(0, 0);
    let b: Int = gcd(0, 0);
    if a != b {
        println("FAIL gcd");
        process_exit(1);
    }
    println("prod_shor_continued_fraction: PASSED");
}
