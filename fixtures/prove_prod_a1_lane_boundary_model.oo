// # Product prove std/auto_robot/lane_boundary_model.oo
//
// Logline: Fail-closed emit+gcc+run asserts lane_lin_y is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_robot/lane_boundary_model.oo.
//
// Beats:
//   1. Call lane_lin_y twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_lane_boundary_model: PASSED only if they match.

import "std/auto_robot/lane_boundary_model.oo";

pub fn main() {
    let lane_boundary_model_mark: Int = 0;
    if lane_boundary_model_mark != 0 {
        process_exit(1);
    }
    let a: Int = lane_lin_y(0, 0, 0);
    let b: Int = lane_lin_y(0, 0, 0);
    if a != b {
        println("FAIL lane_lin_y");
        process_exit(1);
    }
    println("prod_lane_boundary_model: PASSED");
}
