// # Flat List[Node] Int+String must still emit
//
// Logline: Fail-closed emit+gcc+run of List[Node] with Int id and String tag.
//
// Setup: Isolated emit-c. Flat fields only. Not destub.
//
// Beats:
//   1. Empty list has length 0.
//   2. Push one node; get id and tag.
//   3. Print PASSED.

type Node = struct {
    id: Int,
    tag: String
};

pub fn main() {
    let mut xs: List[Node] = list_new();
    if list_len(xs) != 0 {
        println("FAIL empty len");
        process_exit(1);
    }
    let n0: Node = Node { id: 7, tag: "ok" };
    xs = list_push(xs, n0);
    if list_len(xs) != 1 {
        println("FAIL push len");
        process_exit(1);
    }
    let g: Node = list_get(xs, 0);
    if g.id != 7 {
        println("FAIL get id");
        process_exit(1);
    }
    if g.tag != "ok" {
        println("FAIL get tag");
        process_exit(1);
    }
    println("sk13_list_node: PASSED");
}
