// # Product prove std/zk_rollup/poseidon2_permutation.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/zk_rollup/poseidon2_permutation.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/poseidon2_permutation.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_poseidon2_permutation: PASSED only if they match.

import "std/zk_rollup/poseidon2_permutation.oo";

pub fn main() {
    let poseidon2_permutation_a = poseidon2_sbox_x5(0, 0);
    let poseidon2_permutation_b = poseidon2_sbox_x5(0, 0);
    if poseidon2_permutation_a != poseidon2_permutation_b {
        println("FAIL poseidon2_permutation");
        process_exit(1);
    }
    println("prod_ap_poseidon2_permutation: PASSED");
}
