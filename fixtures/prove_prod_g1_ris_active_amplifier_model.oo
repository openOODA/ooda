// # Product prove std/telecom_6g/ris_active_amplifier_model.oo
//
// Logline: Fail-closed emit+gcc+run asserts active_ris_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/ris_active_amplifier_model.oo.
//
// Beats:
//   1. Call active_ris_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ris_active_amplifier_model: PASSED only if they match.

import "std/telecom_6g/ris_active_amplifier_model.oo";

pub fn main() {
    let a: ActiveRisConfig = active_ris_config_default();
    let b: ActiveRisConfig = active_ris_config_default();
    if a.num_elements != b.num_elements {
        println("FAIL active_ris_config_default");
        process_exit(1);
    }
    println("prod_ris_active_amplifier_model: PASSED");
}
