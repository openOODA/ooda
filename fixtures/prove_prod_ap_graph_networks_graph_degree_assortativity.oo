// # Product prove std/graph_networks/graph_degree_assortativity.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/graph_networks/graph_degree_assortativity.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/graph_networks/graph_degree_assortativity.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_graph_degree_assortativity: PASSED only if they match.

import "std/graph_networks/graph_degree_assortativity.oo";

pub fn main() {
    let graph_degree_assortativity_a = assortativity_compute(0, list_new(), list_new());
    let graph_degree_assortativity_b = assortativity_compute(0, list_new(), list_new());
    if graph_degree_assortativity_a.num_edges != graph_degree_assortativity_b.num_edges {
        println("FAIL graph_degree_assortativity");
        process_exit(1);
    }
    println("prod_ap_graph_degree_assortativity: PASSED");
}
