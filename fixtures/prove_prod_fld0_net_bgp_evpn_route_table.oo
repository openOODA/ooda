// # Product prove std/mesh_ebpf/net_bgp_evpn_route_table.oo
//
// Logline: Fail-closed emit+gcc+run asserts evpn_lookup_vtep is deterministic.
//
// Setup: Isolated emit-c. Imports std/mesh_ebpf/net_bgp_evpn_route_table.oo.
//
// Beats:
//   1. Call evpn_lookup_vtep twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_net_bgp_evpn_route_table: PASSED only if they match.

import "std/mesh_ebpf/net_bgp_evpn_route_table.oo";

pub fn main() {
    let net_bgp_evpn_route_table_mark: Int = 0;
    if net_bgp_evpn_route_table_mark != 0 {
        process_exit(1);
    }
    let net_bgp_evpn_route_table_obj: EvpnRouteTable = evpn_route_table_new(1);
    let net_bgp_evpn_route_table_a: Int = evpn_lookup_vtep(&net_bgp_evpn_route_table_obj, 1);
    let net_bgp_evpn_route_table_b: Int = evpn_lookup_vtep(&net_bgp_evpn_route_table_obj, 1);
    if net_bgp_evpn_route_table_a != net_bgp_evpn_route_table_b {
        println("FAIL evpn_lookup_vtep");
        process_exit(1);
    }
    println("prod_net_bgp_evpn_route_table: PASSED");
}
