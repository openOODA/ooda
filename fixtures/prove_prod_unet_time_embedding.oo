// # Product prove std/ai_multimodal/unet_time_embedding.oo
//
// Logline: Fail-closed emit+gcc+run asserts time_embedding_config_new real value.
//
// Setup: Isolated emit-c. Imports std/ai_multimodal/unet_time_embedding.oo.
//
// Beats:
//   1. Call time_embedding_config_new with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_unet_time_embedding: PASSED only if the assert holds.

import "std/ai_multimodal/unet_time_embedding.oo";

pub fn main() {
    let unet_time_embedding_mark: Int = 0;
    if unet_time_embedding_mark != 0 {
        process_exit(1);
    }
    let unet_time_embedding_a = time_embedding_config_new(7, 7);
    let unet_time_embedding_embedding_dim: Int = (unet_time_embedding_a).embedding_dim;
    if unet_time_embedding_embedding_dim != 7 {
        println("FAIL time_embedding_config_new");
        process_exit(1);
    }
    println("prod_unet_time_embedding: PASSED");
}
