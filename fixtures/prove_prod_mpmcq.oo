// # Product sync mpmc queue prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/sync/mpmc_queue.oo.
//
// Setup: Product std/sync/mpmc_queue.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. new(4) cap 4 len 0. new(0) clamps 1.
//   9. Exit 1 before PASSED on a miss.

import "std/sync/mpmc_queue.oo";

pub fn main() {
    let q: MpmcQueue = mpmc_new(4);
    let c: Int = mpmc_capacity(q);
    if c != 4 {
        println("FAIL mpmc cap");
        process_exit(1);
    }
    let n: Int = mpmc_len(q);
    if n != 0 {
        println("FAIL mpmc len");
        process_exit(1);
    }
    if mpmc_is_empty(q) == false {
        println("FAIL mpmc empty");
        process_exit(1);
    }
    let q2: MpmcQueue = mpmc_new(0);
    let c2: Int = mpmc_capacity(q2);
    if c2 != 1 {
        println("FAIL mpmc clamp");
        process_exit(1);
    }
    println("prod_mpmcq: PASSED");
}
