// # Product prove std/3d/lights_stubs.oo
//
// Logline: Fail-closed verification that 3D lights stubs module imports and LightColor structures are deterministic.
//
// Setup: Isolated emit-c. Imports std/3d/lights_stubs.oo.
//
// Beats:
//   1. Construct LightColor instances using light_color_new, light_color_white, and light_color_black.
//   2. Assert deterministic color channels.
//   3. Print prod_g4_3d_lights_stubs: PASSED and exit 0.

import "std/3d/lights_stubs.oo";

pub fn main() {
    let c1: LightColor = light_color_new(100, 150, 200, 255);
    let c2: LightColor = light_color_new(100, 150, 200, 255);
    let r1: Int = c1.r;
    let r2: Int = c2.r;
    if r1 != r2 {
        println("FAIL light_color_new r");
        process_exit(1);
    }
    let g1: Int = c1.g;
    let g2: Int = c2.g;
    if g1 != g2 {
        println("FAIL light_color_new g");
        process_exit(1);
    }
    let b1: Int = c1.b;
    let b2: Int = c2.b;
    if b1 != b2 {
        println("FAIL light_color_new b");
        process_exit(1);
    }
    let a1: Int = c1.a;
    let a2: Int = c2.a;
    if a1 != a2 {
        println("FAIL light_color_new a");
        process_exit(1);
    }

    let w: LightColor = light_color_white();
    let wr: Int = w.r;
    if wr != 255 {
        println("FAIL light_color_white");
        process_exit(1);
    }

    let b: LightColor = light_color_black();
    let br: Int = b.r;
    if br != 0 {
        println("FAIL light_color_black");
        process_exit(1);
    }

    println("prod_g4_3d_lights_stubs: PASSED");
    process_exit(0);
}
