// # Product prove std/3d/gaussian_push_hi.oo
//
// Logline: Fail-closed verification that GaussianCloud high-slot push operations are deterministic.
//
// Setup: Isolated emit-c. Imports std/3d/gaussian_push_hi.oo.
//
// Beats:
//   1. Construct a GaussianCloud populated at slot 8 boundary.
//   2. Push splat to slot 8 using gaussian_cloud_push_hi.
//   3. Read and verify slot 8 splat attributes.
//   4. Print prod_g4_3d_gaussian_push_hi: PASSED and exit 0.

import "std/3d/gaussian_push_hi.oo";

pub fn main() {
    let id: Gaussian3D = gaussian3d_identity();
    let s8: Gaussian3D = gaussian3d_new(8, 8, 8, 88);
    let c_base: GaussianCloud = GaussianCloud {
        count: 8,
        capacity: 16,
        g0: id, g1: id, g2: id, g3: id,
        g4: id, g5: id, g6: id, g7: id,
        g8: id, g9: id, g10: id, g11: id,
        g12: id, g13: id, g14: id, g15: id
    };

    let c_pushed: GaussianCloud = gaussian_cloud_push_hi(c_base, s8);
    let cnt: Int = gaussian_cloud_count(c_pushed);
    if cnt != 9 {
        println("FAIL gaussian_cloud_push_hi count");
        process_exit(1);
    }

    let g8: Gaussian3D = c_pushed.g8;
    let op8: Int = gaussian3d_opacity(g8);
    if op8 != 88 {
        println("FAIL gaussian_cloud_push_hi g8 opacity");
        process_exit(1);
    }

    println("prod_g4_3d_gaussian_push_hi: PASSED");
    process_exit(0);
}
