// # Product prove std/sec/sys/shadowstack_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/sys/shadowstack_types.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/sec/sys/shadowstack_types.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_shadowstack_types: PASSED only if they match.

import "std/sec/sys/shadowstack_types.oo";

pub fn main() {
    let shadowstack_types_a = shadow_stack_new(0);
    let shadowstack_types_b = shadow_stack_new(0);
    if shadowstack_types_a.top_index != shadowstack_types_b.top_index {
        println("FAIL shadowstack_types");
        process_exit(1);
    }
    println("prod_ap_shadowstack_types: PASSED");
}
