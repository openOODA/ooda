// # Product prove std/robot/kinematics_mobile.oo
//
// Logline: Fail-closed verification of differential, Ackermann, and Mecanum mobile base kinematics and odometry.
//
// Setup: Isolated emit-c. Imports std/robot/kinematics_mobile.oo.
//
// Beats:
//   1. Verify differential drive forward/inverse kinematics and odometry step.
//   2. Verify Ackermann steering forward and inverse kinematics.
//   3. Verify 4-wheel omnidirectional Mecanum drive forward and inverse kinematics.
//   4. Print prod_g4_robot_kinematics_mobile: PASSED and exit 0.

import "std/robot/kinematics_mobile.oo";

pub fn main() {
    let dcfg: DiffDriveConfig = diff_drive_config_new(0.1, 0.5);
    let dspeeds: DiffDriveWheelSpeeds = diff_drive_wheel_speeds_new(10.0, 10.0);

    let dtwist: Twist2D = diff_drive_fk(dcfg, dspeeds);
    let dvx: Float = (dtwist).vx;
    let domega: Float = (dtwist).omega;
    if dvx < 0.99 || dvx > 1.01 || domega < -0.01 || domega > 0.01 {
        println("FAIL diff_drive_fk");
        process_exit(1);
    }

    let dik: DiffDriveWheelSpeeds = diff_drive_ik(dcfg, dtwist);
    let dik_l: Float = (dik).left;
    let dik_r: Float = (dik).right;
    if dik_l < 9.99 || dik_l > 10.01 || dik_r < 9.99 || dik_r > 10.01 {
        println("FAIL diff_drive_ik");
        process_exit(1);
    }

    let p0: Pose2D = Pose2D { x: 0.0, y: 0.0, theta: 0.0 };
    let p1: Pose2D = diff_drive_odometry_update(p0, dspeeds, dcfg, 1.0);
    let p1x: Float = (p1).x;
    if p1x < 0.99 || p1x > 1.01 {
        println("FAIL diff_drive_odometry_update");
        process_exit(1);
    }

    let acfg: AckermannConfig = ackermann_config_new(2.5, 1.5);
    let ast: AckermannState = ackermann_state_new(5.0, 0.0);
    let atwist: Twist2D = ackermann_fk(acfg, ast);
    let avx: Float = (atwist).vx;
    if avx != 5.0 {
        println("FAIL ackermann_fk");
        process_exit(1);
    }

    let aik: AckermannState = ackermann_ik(acfg, atwist);
    let aspd: Float = (aik).speed;
    if aspd != 5.0 {
        println("FAIL ackermann_ik");
        process_exit(1);
    }

    let mcfg: MecanumConfig = mecanum_config_new(0.1, 0.5, 0.4);
    let mspeeds: MecanumWheelSpeeds = mecanum_wheel_speeds_new(10.0, 10.0, 10.0, 10.0);
    let mtwist: Twist2D = mecanum_fk(mcfg, mspeeds);
    let mvx: Float = (mtwist).vx;
    if mvx < 0.99 || mvx > 1.01 {
        println("FAIL mecanum_fk");
        process_exit(1);
    }

    let mik: MecanumWheelSpeeds = mecanum_ik(mcfg, mtwist);
    let mfl: Float = (mik).front_left;
    if mfl < 9.99 || mfl > 10.01 {
        println("FAIL mecanum_ik");
        process_exit(1);
    }

    println("prod_g4_robot_kinematics_mobile: PASSED");
    process_exit(0);
}
