// # Product prove std/scicomp/clifford_rotor.oo
//
// Logline: Fail-closed emit+gcc+run asserts rotor_norm_sq is a real value.
//
// Setup: Isolated emit-c. Imports std/scicomp/clifford_rotor.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call rotor_norm_sq twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_clifford_rotor: PASSED only if they match.

import "std/scicomp/clifford_rotor.oo";

pub fn main() {
    let g2_oa: CliffordRotor = CliffordRotor { a: 1.0, b12: 1.0, b23: 1.0, b31: 1.0 };
    let g2_ob: CliffordRotor = CliffordRotor { a: 1.0, b12: 1.0, b23: 1.0, b31: 1.0 };
    let g2_a = rotor_norm_sq(&g2_oa);
    let g2_b = rotor_norm_sq(&g2_ob);
    if g2_a != g2_b {
        println("FAIL rotor_norm_sq");
        process_exit(1);
    }
    println("prod_g2_clifford_rotor: PASSED");
}
