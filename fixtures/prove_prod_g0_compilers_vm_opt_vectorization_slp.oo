// # Product prove std/compilers_vm/opt_vectorization_slp.oo
//
// Logline: Fail-closed emit+gcc+run asserts compute_pack_profitability is a real value.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/opt_vectorization_slp.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call compute_pack_profitability twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_opt_vectorization_slp: PASSED only if they match.

import "std/compilers_vm/opt_vectorization_slp.oo";

pub fn main() {
    let g0_oa = slp_vector_pack_new(2, 8, 2, "x");
    let g0_ob = slp_vector_pack_new(2, 8, 2, "x");
    let g0_a = compute_pack_profitability(g0_oa);
    let g0_b = compute_pack_profitability(g0_ob);
    if g0_a != g0_b {
        println("FAIL compute_pack_profitability");
        process_exit(1);
    }
    println("prod_g0_opt_vectorization_slp: PASSED");
}
