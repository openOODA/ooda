// # Product prove std/bio/smiles_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts smiles_atom_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio/smiles_types.oo.
//
// Beats:
//   1. Call smiles_atom_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_smiles_types: PASSED only if they match.

import "std/bio/smiles_types.oo";

pub fn main() {
    let smiles_types_mark: Int = 0;
    if smiles_types_mark != 0 {
        process_exit(1);
    }
    let a: Atom = smiles_atom_new(0, 0, 0);
    let b: Atom = smiles_atom_new(0, 0, 0);
    if (a).atomic_number != (b).atomic_number {
        println("FAIL smiles_atom_new");
        process_exit(1);
    }
    println("prod_smiles_types: PASSED");
}
