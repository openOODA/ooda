// # Product regex_vm prove
//
// Logline: Fail-closed emit+gcc+run of shipped regex_vm_match/find over CHAR+MATCH.
//
// Setup: Product std/text/regex_vm.oo. Bytecode CHAR 97 ('a') then MATCH.
//
// Beats:
//   1. match "a" is true; match "b" is false; find "xa" is 1.
//   2. Exit 1 before PASSED on a miss.

import "std/text/regex_bytecode.oo";
import "std/text/regex_vm.oo";

pub fn main() {
    let mut bc: RegexBytecode = regex_bc_new();
    bc = regex_bc_emit_char(bc, 97);
    bc = regex_bc_emit_match(bc);
    let ok: Bool = regex_vm_match(bc, "a");
    if ok == false {
        println("FAIL revm match a");
        process_exit(1);
    }
    let no: Bool = regex_vm_match(bc, "b");
    if no == true {
        println("FAIL revm match b");
        process_exit(1);
    }
    let f: Int = regex_vm_find(bc, "xa");
    if f != 1 {
        println("FAIL revm find");
        process_exit(1);
    }
    println("prod_revm: PASSED");
}
