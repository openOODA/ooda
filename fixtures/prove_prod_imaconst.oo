// # Product sec ima const prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/sec/sys/ima_const.oo.
//
// Setup: Product std/sec/sys/ima_const.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. action measure 1 hash 8. default pcr 10.
//   9. Exit 1 before PASSED on a miss.

import "std/sec/sys/ima_const.oo";

pub fn main() {
    let a: Int = ima_action_measure();
    if a != 1 {
        println("FAIL ima meas");
        process_exit(1);
    }
    let b: Int = ima_action_hash();
    if b != 8 {
        println("FAIL ima hash");
        process_exit(1);
    }
    let c: Int = ima_default_pcr();
    if c != 10 {
        println("FAIL ima pcr");
        process_exit(1);
    }
    println("prod_imaconst: PASSED");
}
