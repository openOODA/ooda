// # Product prove std/sec/crypto/groth16_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts groth16_setup_bytes is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/groth16_types.oo.
//
// Beats:
//   1. Call groth16_setup_bytes twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_groth16_types: PASSED only if they match.

import "std/sec/crypto/groth16_types.oo";

pub fn main() {
    let obj = groth16_setup_new(0, 0);
    let a = groth16_setup_bytes(obj);
    let b = groth16_setup_bytes(obj);
    if a != b {
        println("FAIL groth16_setup_bytes");
        process_exit(1);
    }
    println("prod_groth16_types: PASSED");
}
