// # Product prove std/db_graph/graph_triangle_counting.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_graph/graph_triangle_counting.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/graph_triangle_counting.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_graph_triangle_counting: PASSED only if they match.

import "std/db_graph/graph_triangle_counting.oo";

pub fn main() {
    let graph_triangle_counting_a = compute_local_clustering(0.0, 0.0);
    let graph_triangle_counting_b = compute_local_clustering(0.0, 0.0);
    if graph_triangle_counting_a != graph_triangle_counting_b {
        println("FAIL graph_triangle_counting");
        process_exit(1);
    }
    println("prod_ap_graph_triangle_counting: PASSED");
}
