// # Product prove std/quantum_advanced/vqe_ansatz_uccsd.oo
//
// Logline: Fail-closed emit+gcc+run asserts uccsd_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/vqe_ansatz_uccsd.oo.
//
// Beats:
//   1. Call uccsd_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_vqe_ansatz_uccsd: PASSED only if they match.

import "std/quantum_advanced/vqe_ansatz_uccsd.oo";

pub fn main() {
    let vqe_ansatz_uccsd_mark: Int = 0;
    if vqe_ansatz_uccsd_mark != 0 {
        process_exit(1);
    }
    let a: UccsdConfig = uccsd_config_new(0, 0);
    let b: UccsdConfig = uccsd_config_new(0, 0);
    if (a).num_spatial_orbitals != (b).num_spatial_orbitals {
        println("FAIL uccsd_config_new");
        process_exit(1);
    }
    println("prod_g2_vqe_ansatz_uccsd: PASSED");
}
