// # Product prove std/fhe_lattices/fhe_poly_simd_packing.oo
//
// Logline: Fail-closed emit+gcc+run asserts simd_slot_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fhe_lattices/fhe_poly_simd_packing.oo.
//
// Beats:
//   1. Call simd_slot_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fhe_poly_simd_packing: PASSED only if they match.

import "std/fhe_lattices/fhe_poly_simd_packing.oo";

pub fn main() {
    let fhe_poly_simd_packing_mark: Int = 0;
    if fhe_poly_simd_packing_mark != 0 {
        process_exit(1);
    }
    let a: SimdSlotConfig = simd_slot_config_new(0, 0, 0);
    let b: SimdSlotConfig = simd_slot_config_new(0, 0, 0);
    if (a).num_slots != (b).num_slots {
        println("FAIL simd_slot_config_new");
        process_exit(1);
    }
    println("prod_fhe_poly_simd_packing: PASSED");
}
