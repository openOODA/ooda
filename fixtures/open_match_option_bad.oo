// # Non-exhaustive Option match
//
// Logline: Match Some without None and fail check.
//
// Setup: OPEN-5 exhaustive match. Check should refuse.
//
// Beats:
//   1. Bind Some(1).
//   2. Match only Some.
//   3. Do not print PASSED.

pub fn main() {
    let x = Some(1);
    let y = match x {
        Some(v) => v,
    };
    println(y);
}
