// # Product prove std/sync/lockfree_queue.oo
//
// Logline: Fail-closed emit+gcc+run asserts lockfree_queue_len is deterministic.
//
// Setup: Isolated emit-c. Imports std/sync/lockfree_queue.oo.
//
// Beats:
//   1. Call lockfree_queue_len twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_lockfree_queue: PASSED only if they match.

import "std/sync/lockfree_queue.oo";

pub fn main() {
    let obj = lockfree_queue_new();
    let a = lockfree_queue_len(obj);
    let b = lockfree_queue_len(obj);
    if a != b {
        println("FAIL lockfree_queue_len");
        process_exit(1);
    }
    println("prod_lockfree_queue: PASSED");
}
