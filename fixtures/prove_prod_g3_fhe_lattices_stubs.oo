// # Product prove std/fhe_lattices/fhe_lattices_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts fhe_hardware_capabilities_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/fhe_lattices/fhe_lattices_stubs.oo.
//
// Beats:
//   1. Call fhe_hardware_capabilities_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fhe_lattices_stubs: PASSED only if they match.

import "std/fhe_lattices/fhe_lattices_stubs.oo";

pub fn main() {
    let fhe_lattices_stubs_mark: Int = 0;
    if fhe_lattices_stubs_mark != 0 {
        process_exit(1);
    }
    let a: FheHardwareCapabilities = fhe_hardware_capabilities_default();
    let b: FheHardwareCapabilities = fhe_hardware_capabilities_default();
    if (a).supports_fpga_ntt != (b).supports_fpga_ntt {
        println("FAIL fhe_hardware_capabilities_default");
        process_exit(1);
    }
    println("prod_fhe_lattices_stubs: PASSED");
}
