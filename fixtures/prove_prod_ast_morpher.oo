// # Product Prove std/security_defense/ast_morpher.oo
//
// Logline: Fail-closed deterministic assertion fixture verifying AST control flow flattening, opaque predicates, layout permutation, and Zero-Trust capability invariants.
//
// Setup: Standalone emit-c test fixture importing std/security_defense/ast_morpher.oo.
//
// Beats:
//   1. Build sample function AST and verify capability invariants.
//   2. Test number-theoretic opaque predicates (even product and quadratic residue mod 7).
//   3. Execute full metamorphic AST transformation and assert deterministic metrics.
//   4. Print prod_ast_morpher: PASSED and exit 0.

import "std/security_defense/ast_morpher.oo";

pub fn main() {
    // 1. Verify Zero-Trust capability invariant checks
    let cap_a: AstCapabilitySet = ast_capability_set_new(true, true, false, false);
    let cap_b: AstCapabilitySet = ast_capability_set_new(true, true, false, false);
    let cap_diff: AstCapabilitySet = ast_capability_set_new(false, true, true, false);

    let match_ok: Bool = ast_capability_verify_invariants(&cap_a, &cap_b);
    if !match_ok {
        println("FAIL: capability matching invariant returned false");
        process_exit(1);
    }

    let diff_ok: Bool = ast_capability_verify_invariants(&cap_a, &cap_diff);
    if diff_ok {
        println("FAIL: capability mismatch invariant returned true");
        process_exit(1);
    }

    // 2. Test Number-Theoretic Opaque Predicates
    let ev0: Bool = ast_morpher_opaque_eval_even(0);
    let ev1: Bool = ast_morpher_opaque_eval_even(1);
    let ev42: Bool = ast_morpher_opaque_eval_even(42);
    let ev99: Bool = ast_morpher_opaque_eval_even(99);

    if !ev0 || !ev1 || !ev42 || !ev99 {
        println("FAIL: opaque_eval_even failed on valid integers");
        process_exit(1);
    }

    let m1: Bool = ast_morpher_opaque_eval_mod7(3, 5);
    let m2: Bool = ast_morpher_opaque_eval_mod7(0, 0);
    let m3: Bool = ast_morpher_opaque_eval_mod7(7, 14);
    let m4: Bool = ast_morpher_opaque_eval_mod7(2, 9);

    if m1 || m2 || m3 || m4 {
        println("FAIL: opaque_eval_mod7 returned true for quadratic non-residue mod 7");
        process_exit(1);
    }

    // 3. Setup AST Function for Metamorphic Transformation Run 1
    let mut fn1: AstFunction = ast_function_new("secure_kernel_routine", cap_a);
    let b0: AstBasicBlock = ast_basic_block_new(0, 0, 1, -1);
    let b1: AstBasicBlock = ast_basic_block_new(1, 1, 2, -1);
    let b2: AstBasicBlock = ast_basic_block_new(2, 2, -1, -1);

    ast_function_add_block(&mut fn1, b0);
    ast_function_add_block(&mut fn1, b1);
    ast_function_add_block(&mut fn1, b2);

    let mut bytecode1: BytecodeBuffer = bytecode_buffer_new();
    bytecode_buffer_append(&mut bytecode1, 72);
    bytecode_buffer_append(&mut bytecode1, 137);
    bytecode_buffer_append(&mut bytecode1, 195); // 0xC3 RET gadget
    bytecode_buffer_append(&mut bytecode1, 144);

    let cfg: AstMorpherConfig = ast_morpher_config_default(4242);
    let res1: AstMorpherResult = ast_morpher_apply_all(&cfg, &mut fn1, &mut bytecode1);

    if !(res1).success {
        println("FAIL: ast_morpher_apply_all returned success = false");
        process_exit(1);
    }

    if (res1).total_blocks != 3 {
        println("FAIL: total_blocks mismatch");
        process_exit(1);
    }

    if (res1).flattened_states != 3 {
        println("FAIL: flattened_states mismatch");
        process_exit(1);
    }

    if (res1).permuted_blocks_count != 3 {
        println("FAIL: permuted_blocks_count mismatch");
        process_exit(1);
    }

    if (res1).opaque_predicates_count != 2 {
        println("FAIL: opaque_predicates_count mismatch");
        process_exit(1);
    }

    if (res1).rop_gadgets_cleaned != 1 {
        println("FAIL: rop_gadgets_cleaned mismatch");
        process_exit(1);
    }

    if !(res1).capabilities_verified {
        println("FAIL: capabilities_verified is false");
        process_exit(1);
    }

    if (res1).metamorphic_entropy <= 0 {
        println("FAIL: metamorphic_entropy <= 0");
        process_exit(1);
    }

    // 4. Assert Determinism across identical runs
    let mut fn2: AstFunction = ast_function_new("secure_kernel_routine", cap_a);
    let b0_2: AstBasicBlock = ast_basic_block_new(0, 0, 1, -1);
    let b1_2: AstBasicBlock = ast_basic_block_new(1, 1, 2, -1);
    let b2_2: AstBasicBlock = ast_basic_block_new(2, 2, -1, -1);

    ast_function_add_block(&mut fn2, b0_2);
    ast_function_add_block(&mut fn2, b1_2);
    ast_function_add_block(&mut fn2, b2_2);

    let mut bytecode2: BytecodeBuffer = bytecode_buffer_new();
    bytecode_buffer_append(&mut bytecode2, 72);
    bytecode_buffer_append(&mut bytecode2, 137);
    bytecode_buffer_append(&mut bytecode2, 195);
    bytecode_buffer_append(&mut bytecode2, 144);

    let res2: AstMorpherResult = ast_morpher_apply_all(&cfg, &mut fn2, &mut bytecode2);

    if (res1).metamorphic_entropy != (res2).metamorphic_entropy {
        println("FAIL: non-deterministic metamorphic entropy");
        process_exit(1);
    }

    println("prod_ast_morpher: PASSED");
    process_exit(0);
}
