// # Product prove std/telecom/turbo_decoder.oo
//
// Logline: Fail-closed emit+gcc+run asserts turbo_abs is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom/turbo_decoder.oo.
//
// Beats:
//   1. Call turbo_abs twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_turbo_decoder: PASSED only if they match.

import "std/telecom/turbo_decoder.oo";

pub fn main() {
    let turbo_decoder_mark: Int = 0;
    if turbo_decoder_mark != 0 {
        process_exit(1);
    }
    let a: Float = turbo_abs(0.0);
    let b: Float = turbo_abs(0.0);
    if a != b {
        println("FAIL turbo_abs");
        process_exit(1);
    }
    println("prod_turbo_decoder: PASSED");
}
