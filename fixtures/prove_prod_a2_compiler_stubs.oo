// # Product prove std/compilers/compiler_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts compiler_target_host is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers/compiler_stubs.oo.
//
// Beats:
//   1. Call compiler_target_host twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_compiler_stubs: PASSED only if they match.

import "std/compilers/compiler_stubs.oo";
import "std/str.oo";

pub fn main() {
    let compiler_stubs_mark: Int = 0;
    if compiler_stubs_mark != 0 {
        process_exit(1);
    }
    let a: CompilerTargetTriple = compiler_target_host();
    let b: CompilerTargetTriple = compiler_target_host();
    if str_eq((a).arch, (b).arch) == false {
        println("FAIL compiler_target_host");
        process_exit(1);
    }
    println("prod_compiler_stubs: PASSED");
}
