// M161 path A: SysCap + sys_spawn/wait/kill → residual Err (no real fork).
// main injects long long sys = oo_cap_grant_sys();
// Honesty: residual seal only; blocking spawn+wait is sys_exec (process_exec).
pub fn main(sys: &SysCap) {
    let r: Result[String, String] = sys_spawn(sys, "true");
    if r.is_ok() {
        println("unexpected-ok");
    } else {
        println("spawn-residual-ok");
    }
    let w: Result[String, String] = sys_wait(sys, 1);
    if w.is_err() {
        println("wait-residual-ok");
    } else {
        println("unexpected-wait-ok");
    }
    let k: Result[String, String] = sys_kill(sys, 1, 9);
    if k.is_err() {
        println("kill-residual-ok");
    } else {
        println("unexpected-kill-ok");
    }
}
