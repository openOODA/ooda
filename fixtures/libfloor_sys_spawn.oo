// # SysCap spawn wait kill
//
// Logline: Spawn true, wait for the child, and print ok. Kill of pid 0 must fail closed.
//
// Beats:
//   1. sys_spawn("true") is Ok.
//   2. sys_wait(-1) reaps the child.
//   3. sys_kill(0, 9) is Err (pid 0 refused).

pub fn main(sys: &SysCap) {
    match sys_spawn(sys, "true") {
        Ok(s) => {
            match sys_wait(sys, -1) {
                Ok(st) => println("ok"),
                Err(e) => println(e),
            }
        }
        Err(e) => println(e),
    }
    match sys_kill(sys, 0, 9) {
        Ok(s) => println("unexpected-kill-ok"),
        Err(e) => println("kill-zero-refused"),
    }
}
