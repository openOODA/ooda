// # Product prove std/bioinformatics/dna_sequence.oo
//
// Logline: Fail-closed emit+gcc+run asserts dna_is_valid_nucleotide is deterministic.
//
// Setup: Isolated emit-c. Imports std/bioinformatics/dna_sequence.oo.
//
// Beats:
//   1. Call dna_is_valid_nucleotide twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dna_sequence: PASSED only if they match.

import "std/bioinformatics/dna_sequence.oo";

pub fn main() {
    let dna_sequence_mark: Int = 0;
    if dna_sequence_mark != 0 {
        process_exit(1);
    }
    let a: Bool = dna_is_valid_nucleotide("x");
    let b: Bool = dna_is_valid_nucleotide("x");
    if a != b {
        println("FAIL dna_is_valid_nucleotide");
        process_exit(1);
    }
    println("prod_dna_sequence: PASSED");
}
