// # Product prove std/quantum_advanced/quantum_crosstalk_mitigation.oo
//
// Logline: Fail-closed emit+gcc+run asserts crosstalk_zz_phase_accumulation is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/quantum_crosstalk_mitigation.oo.
//
// Beats:
//   1. Call crosstalk_zz_phase_accumulation twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_quantum_crosstalk_mitigation: PASSED only if they match.

import "std/quantum_advanced/quantum_crosstalk_mitigation.oo";

pub fn main() {
    let quantum_crosstalk_mitigation_mark: Int = 0;
    if quantum_crosstalk_mitigation_mark != 0 {
        process_exit(1);
    }
    let a: Float = crosstalk_zz_phase_accumulation(0.0, 0.0);
    let b: Float = crosstalk_zz_phase_accumulation(0.0, 0.0);
    if a != b {
        println("FAIL crosstalk_zz_phase_accumulation");
        process_exit(1);
    }
    println("prod_quantum_crosstalk_mitigation: PASSED");
}
