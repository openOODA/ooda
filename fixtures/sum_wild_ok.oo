// # User-sum underscore covers remaining variants
//
// Logline: Check accepts Flag match On and _ .
//
// Setup: type Flag = On | Off. _ covers Off.
//
// Beats:
//   1. Annotated Flag let.
//   2. Arms are On and _.
//   3. check must OK.

type Flag = On | Off;

pub fn main() {
    let a: Flag = On;
    let v: Int = match a {
        On => 1,
        _ => 0
    };
}
