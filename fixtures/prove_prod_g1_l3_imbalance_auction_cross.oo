// # Product prove std/fintech_l3_book/l3_imbalance_auction_cross.oo
//
// Logline: Fail-closed emit+gcc+run asserts cross_auction_intent_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/l3_imbalance_auction_cross.oo.
//
// Beats:
//   1. Call cross_auction_intent_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_l3_imbalance_auction_cross: PASSED only if they match.

import "std/fintech_l3_book/l3_imbalance_auction_cross.oo";

pub fn main() {
    let a: CrossAuctionIntent = cross_auction_intent_new("x", "x", 0, 0, 0);
    let b: CrossAuctionIntent = cross_auction_intent_new("x", "x", 0, 0, 0);
    if a.total_market_buy_shares != b.total_market_buy_shares {
        println("FAIL cross_auction_intent_new");
        process_exit(1);
    }
    println("prod_l3_imbalance_auction_cross: PASSED");
}
