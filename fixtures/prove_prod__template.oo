// # Product prove std/_template.oo
//
// Logline: Fail-closed emit+gcc+run asserts template_op is deterministic.
//
// Setup: Isolated emit-c. Imports std/_template.oo.
//
// Beats:
//   1. Call template_op twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod__template: PASSED only if they match.

import "std/_template.oo";

pub fn main() {
    let a = template_op("x");
    let b = template_op("x");
    if a != b {
        println("FAIL template_op");
        process_exit(1);
    }
    println("prod__template: PASSED");
}
