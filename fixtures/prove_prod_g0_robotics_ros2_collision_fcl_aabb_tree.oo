// # Product prove std/robotics_ros2/collision_fcl_aabb_tree.oo
//
// Logline: Fail-closed emit+gcc+run asserts aabb_volume is a real value.
//
// Setup: Isolated emit-c. Imports std/robotics_ros2/collision_fcl_aabb_tree.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call aabb_volume twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_collision_fcl_aabb_tree: PASSED only if they match.

import "std/robotics_ros2/collision_fcl_aabb_tree.oo";

pub fn main() {
    let g0_oa: AABB3D = AABB3D { min_x: 1.0, min_y: 1.0, min_z: 1.0, max_x: 1.0, max_y: 1.0, max_z: 1.0 };
    let g0_ob: AABB3D = AABB3D { min_x: 1.0, min_y: 1.0, min_z: 1.0, max_x: 1.0, max_y: 1.0, max_z: 1.0 };
    let g0_a = aabb_volume(&g0_oa);
    let g0_b = aabb_volume(&g0_ob);
    if g0_a != g0_b {
        println("FAIL aabb_volume");
        process_exit(1);
    }
    println("prod_g0_collision_fcl_aabb_tree: PASSED");
}
