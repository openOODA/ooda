// # Product prove std/robotics_auv/wave_drift_second_order.oo
//
// Logline: Fail-closed emit+gcc+run asserts wave_drift_coefficients_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/wave_drift_second_order.oo.
//
// Beats:
//   1. Call wave_drift_coefficients_default twice.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wave_drift_second_order: PASSED only if they match.

import "std/robotics_auv/wave_drift_second_order.oo";

pub fn main() {
    let wave_drift_second_order_mark: Int = 0;
    if wave_drift_second_order_mark != 0 {
        process_exit(1);
    }
    let a: WaveDriftCoefficients = wave_drift_coefficients_default();
    let b: WaveDriftCoefficients = wave_drift_coefficients_default();
    if (a).surge_c_xd != (b).surge_c_xd {
        println("FAIL wave_drift_coefficients_default");
        process_exit(1);
    }
    println("prod_wave_drift_second_order: PASSED");
}
