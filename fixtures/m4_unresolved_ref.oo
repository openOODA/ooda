// # Milestone 4 test unresolved method on reference receiver
//
// Logline: Verify unresolved method fails closed with ERR\tc_emit\tunresolved method on (&p).
//
// Setup: Point struct from m4_multi_struct_lib.oo.
//
// Beats:
//   1. Call non-existent method bad_method on (&p).
//   2. Fail closed during c_emit.

import "m4_multi_struct_lib.oo";

pub fn helper(pt: &Point) {
    pt.ghost_method();
}

pub fn main() {
    let p = Point { x: 1, y: 2 };
    helper(&p);
}
