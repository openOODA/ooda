// # Product prove std/uav_flight/uav_complementary_filter.oo
//
// Logline: Fail-closed emit+gcc+run asserts mahony_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/uav_flight/uav_complementary_filter.oo.
//
// Beats:
//   1. Call mahony_config_default twice.
//   2. Exit 1 if the two results differ.
//   3. Print prod_uav_complementary_filter: PASSED only if they match.

import "std/uav_flight/uav_complementary_filter.oo";

pub fn main() {
    let uav_complementary_filter_mark: Int = 0;
    if uav_complementary_filter_mark != 0 {
        process_exit(1);
    }
    let a: MahonyFilterConfig = mahony_config_default();
    let b: MahonyFilterConfig = mahony_config_default();
    if (a).kp_gain != (b).kp_gain {
        println("FAIL mahony_config_default");
        process_exit(1);
    }
    println("prod_uav_complementary_filter: PASSED");
}
