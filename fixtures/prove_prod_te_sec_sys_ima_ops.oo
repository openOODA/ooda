// # Product prove std/sec/sys/ima_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts ima_mask_has_flag is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/ima_ops.oo.
//
// Beats:
//   1. Call ima_mask_has_flag twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ima_ops: PASSED only if they match.

import "std/sec/sys/ima_ops.oo";

pub fn main() {
    let ima_ops_mark: Int = 0;
    if ima_ops_mark != 0 {
        process_exit(1);
    }
    let a: Bool = ima_mask_has_flag(0, 0);
    let b: Bool = ima_mask_has_flag(0, 0);
    if a != b {
        println("FAIL ima_mask_has_flag");
        process_exit(1);
    }
    println("prod_ima_ops: PASSED");
}
