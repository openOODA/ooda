// # Match-expression Int Result refuse
//
// Logline: emit-llvm fail-closes Result[Int, String] match-expr instead of OoStr payload.
//
// Setup: Backend-LLVM. Not a run lock.
//
// Beats:
//   1. Match a Result[Int, String].
//   2. Emit must print ERR llvm_emit.
//   3. Do not store the Int as OoStr.

pub fn take() -> Int {
    let r: Result[Int, String] = Ok(7);
    return match r {
        Ok(v) => v,
        Err(e) => 0
    };
}

pub fn main() {
    println(take().to_string());
}
