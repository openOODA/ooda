// # Product prove std/robot/motors_stepper.oo
//
// Logline: Fail-closed emit+gcc+run asserts stepper_init holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/robot/motors_stepper.oo.
//
// Beats:
//   1. Call stepper_init using the motors_stepper ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_motors_stepper: PASSED only if asserts hold.

import "std/robot/motors_stepper.oo";

pub fn main() {
    let obj = stepper_init(8, 0.0, 0.0, 0.0, 0.0);
    let motors_stepper_a = obj.id;
    if motors_stepper_a != 8 {
        println("FAIL stepper_init");
        process_exit(1);
    }
    println("prod_motors_stepper: PASSED");
}
