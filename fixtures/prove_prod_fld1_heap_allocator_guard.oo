// # Product prove std/security_defense/heap_allocator_guard.oo
//
// Logline: Fail-closed emit+gcc+run asserts heap_compute_checksum is deterministic.
//
// Setup: Isolated emit-c. Imports std/security_defense/heap_allocator_guard.oo.
//
// Beats:
//   1. Call heap_compute_checksum twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_heap_allocator_guard: PASSED only if they match.

import "std/security_defense/heap_allocator_guard.oo";

pub fn main() {
    let heap_allocator_guard_mark: Int = 0;
    if heap_allocator_guard_mark != 0 {
        process_exit(1);
    }
    let heap_allocator_guard_a: Int = heap_compute_checksum(1, 1, 1);
    let heap_allocator_guard_b: Int = heap_compute_checksum(1, 1, 1);
    if heap_allocator_guard_a != heap_allocator_guard_b {
        println("FAIL heap_compute_checksum");
        process_exit(1);
    }
    println("prod_heap_allocator_guard: PASSED");
}
