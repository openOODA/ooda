// # Product prove std/uav_flight/uav_parachute_deploy_trigger.oo
//
// Logline: Fail-closed emit+gcc+run asserts parachute_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/uav_flight/uav_parachute_deploy_trigger.oo.
//
// Beats:
//   1. Call parachute_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_uav_parachute_deploy_trigger: PASSED only if they match.

import "std/uav_flight/uav_parachute_deploy_trigger.oo";

pub fn main() {
    let a: ParachuteConfig = parachute_config_default();
    let b: ParachuteConfig = parachute_config_default();
    if a.freefall_mm_s2 != b.freefall_mm_s2 {
        println("FAIL parachute_config_default");
        process_exit(1);
    }
    println("prod_uav_parachute_deploy_trigger: PASSED");
}
