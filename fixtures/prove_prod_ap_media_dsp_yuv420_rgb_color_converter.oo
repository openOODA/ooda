// # Product prove std/media_dsp/yuv420_rgb_color_converter.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/media_dsp/yuv420_rgb_color_converter.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/media_dsp/yuv420_rgb_color_converter.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_yuv420_rgb_color_converter: PASSED only if they match.

import "std/media_dsp/yuv420_rgb_color_converter.oo";

pub fn main() {
    let yuv420_rgb_color_converter_a = yuv_clamp_byte(0);
    let yuv420_rgb_color_converter_b = yuv_clamp_byte(0);
    if yuv420_rgb_color_converter_a != yuv420_rgb_color_converter_b {
        println("FAIL yuv420_rgb_color_converter");
        process_exit(1);
    }
    println("prod_ap_yuv420_rgb_color_converter: PASSED");
}
