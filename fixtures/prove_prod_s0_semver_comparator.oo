// # Product prove std/web_ecosystem/semver_comparator.oo
//
// Logline: Fail-closed emit+gcc+run asserts semver_compare value or determinism.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/semver_comparator.oo.
//
// Beats:
//   1. Call semver_compare twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_semver_comparator: PASSED only if asserts hold.

import "std/web_ecosystem/semver_comparator.oo";

pub fn main() {
    let semver_comparator_a: Int = semver_compare(0, 1, 0, 0, 1, 0);
    let semver_comparator_b: Int = semver_compare(0, 1, 0, 0, 1, 0);
    if semver_comparator_a != semver_comparator_b {
        println("FAIL semver_compare");
        process_exit(1);
    }
    println("prod_semver_comparator: PASSED");
}
