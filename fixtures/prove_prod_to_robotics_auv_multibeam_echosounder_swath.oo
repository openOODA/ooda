// # Product prove std/robotics_auv/multibeam_echosounder_swath.oo
//
// Logline: Fail-closed emit+gcc+run asserts mbes_config_default_em2040 holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/multibeam_echosounder_swath.oo.
//
// Beats:
//   1. Call mbes_config_default_em2040 using the multibeam_echosounder_swath ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_multibeam_echosounder_swath: PASSED only if asserts hold.

import "std/robotics_auv/multibeam_echosounder_swath.oo";

pub fn main() {
    let obj = mbes_config_default_em2040();
    let multibeam_echosounder_swath_a = obj.carrier_frequency_khz;
    if multibeam_echosounder_swath_a != 300.0 {
        println("FAIL mbes_config_default_em2040");
        process_exit(1);
    }
    println("prod_multibeam_echosounder_swath: PASSED");
}
