// # Product prove std/graph_topology/graph_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts graph_hardware_accel_init is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_topology/graph_stubs.oo.
//
// Beats:
//   1. Call graph_hardware_accel_init twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_graph_stubs: PASSED only if they match.

import "std/graph_topology/graph_stubs.oo";

pub fn main() {
    let graph_stubs_mark: Int = 0;
    if graph_stubs_mark != 0 {
        process_exit(1);
    }
    let a: GraphHardwareAccel = graph_hardware_accel_init(0);
    let b: GraphHardwareAccel = graph_hardware_accel_init(0);
    if (a).device_id != (b).device_id {
        println("FAIL graph_hardware_accel_init");
        process_exit(1);
    }
    println("prod_graph_stubs: PASSED");
}
