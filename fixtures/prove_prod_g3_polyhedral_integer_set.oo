// # Product prove std/compilers_polyhedral/polyhedral_integer_set.oo
//
// Logline: Fail-closed emit+gcc+run asserts basic_set_facet_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/polyhedral_integer_set.oo.
//
// Beats:
//   1. Call basic_set_facet_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_polyhedral_integer_set: PASSED only if they match.

import "std/compilers_polyhedral/polyhedral_integer_set.oo";

pub fn main() {
    let polyhedral_integer_set_mark: Int = 0;
    if polyhedral_integer_set_mark != 0 {
        process_exit(1);
    }
    let a: BasicSetFacet = basic_set_facet_new(list_new(), 0, true);
    let b: BasicSetFacet = basic_set_facet_new(list_new(), 0, true);
    if (a).rhs_bound != (b).rhs_bound {
        println("FAIL basic_set_facet_new");
        process_exit(1);
    }
    println("prod_polyhedral_integer_set: PASSED");
}
