// # Allow a public setenv value
//
// Logline: A public value may reach setenv while a tagged name sits unused.
//
// Beats:
//   1. Tag token at line start.
//   2. Pass a public literal as the value.
//   3. Expect emit to allow the call.

// M-? setenv clean: non-secret value may setenv (emit path)
// SECRET: token
pub fn main(envc: &EnvCap) {
    let token = "s3cret";
    let r = setenv(envc, "KEY", "public");
    println(1);
}
