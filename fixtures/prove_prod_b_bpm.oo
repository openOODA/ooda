// # Product prove std/enterprise/bpm.oo
//
// Logline: Fail-closed emit+gcc+run asserts bpm_calculate_sla_compliance_rate is deterministic.
//
// Setup: Isolated emit-c. Imports std/enterprise/bpm.oo.
//
// Beats:
//   1. Call bpm_calculate_sla_compliance_rate twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_bpm: PASSED only if they match.

import "std/enterprise/bpm.oo";

pub fn main() {
    let a = bpm_calculate_sla_compliance_rate(0, 0);
    let b = bpm_calculate_sla_compliance_rate(0, 0);
    if a != b {
        println("FAIL bpm_calculate_sla_compliance_rate");
        process_exit(1);
    }
    println("prod_bpm: PASSED");
}
