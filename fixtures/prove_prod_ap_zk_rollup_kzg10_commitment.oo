// # Product prove std/zk_rollup/kzg10_commitment.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/zk_rollup/kzg10_commitment.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/kzg10_commitment.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_kzg10_commitment: PASSED only if they match.

import "std/zk_rollup/kzg10_commitment.oo";

pub fn main() {
    let kzg10_commitment_a = kzg10_poly_new(0, 0, 0, 0, 0);
    let kzg10_commitment_b = kzg10_poly_new(0, 0, 0, 0, 0);
    let kzg10_commitment_va = kzg10_eval_horner(kzg10_commitment_a, 0);
    let kzg10_commitment_vb = kzg10_eval_horner(kzg10_commitment_b, 0);
    if kzg10_commitment_va != kzg10_commitment_vb {
        println("FAIL kzg10_commitment");
        process_exit(1);
    }
    println("prod_ap_kzg10_commitment: PASSED");
}
