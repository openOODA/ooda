// # Product prove std/net/http2_stream.oo
//
// Logline: Fail-closed emit+gcc+run asserts http2_stream_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/net/http2_stream.oo.
//
// Beats:
//   1. Call http2_stream_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_http2_stream: PASSED only if they match.

import "std/net/http2_stream.oo";

pub fn main() {
    let a: Http2Stream = http2_stream_new(0);
    let b: Http2Stream = http2_stream_new(0);
    if (a).stream_id != (b).stream_id {
        println("FAIL http2_stream_new");
        process_exit(1);
    }
    println("prod_http2_stream: PASSED");
}
