// # Const if !true / !false
//
// Logline: Print YES from if !false and NO from the else of if !true.
//
// Setup: Side emit-aarch64 folds BANG KW_TRUE/KW_FALSE only when LBRACE follows.
//
// Beats:
//   1. if !false print YES.
//   2. if !true else print NO.
//   3. Expect YES and NO.

pub fn main() {
    if !false {
        println("YES");
    }
    if !true {
        println("BAD");
    } else {
        println("NO");
    }
}
