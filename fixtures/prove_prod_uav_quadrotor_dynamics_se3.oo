// # Product prove std/uav_flight/uav_quadrotor_dynamics_se3.oo
//
// Logline: Fail-closed emit+gcc+run asserts quadrotor_params_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/uav_flight/uav_quadrotor_dynamics_se3.oo.
//
// Beats:
//   1. Call quadrotor_params_default twice.
//   2. Exit 1 if the two results differ.
//   3. Print prod_uav_quadrotor_dynamics_se3: PASSED only if they match.

import "std/uav_flight/uav_quadrotor_dynamics_se3.oo";

pub fn main() {
    let uav_quadrotor_dynamics_se3_mark: Int = 0;
    if uav_quadrotor_dynamics_se3_mark != 0 {
        process_exit(1);
    }
    let a: QuadrotorParams = quadrotor_params_default();
    let b: QuadrotorParams = quadrotor_params_default();
    if (a).mass != (b).mass {
        println("FAIL quadrotor_params_default");
        process_exit(1);
    }
    println("prod_uav_quadrotor_dynamics_se3: PASSED");
}
