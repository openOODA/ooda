// # Product prove std/pbr_raytracing/light_environment_map.oo
//
// Logline: Fail-closed emit+gcc+run asserts env_map_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/pbr_raytracing/light_environment_map.oo.
//
// Beats:
//   1. Call env_map_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_light_environment_map: PASSED only if they match.

import "std/pbr_raytracing/light_environment_map.oo";

pub fn main() {
    let light_environment_map_mark: Int = 0;
    if light_environment_map_mark != 0 {
        process_exit(1);
    }
    let a: EnvironmentMap = env_map_new(0, 0, 0.0);
    let b: EnvironmentMap = env_map_new(0, 0, 0.0);
    if (a).width != (b).width {
        println("FAIL env_map_new");
        process_exit(1);
    }
    println("prod_g2_light_environment_map: PASSED");
}
