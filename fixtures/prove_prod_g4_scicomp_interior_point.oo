// # Product prove std/scicomp/interior_point_lp.oo
//
// Logline: Fail-closed verification that primal-dual interior point configuration, duality gap, and step fractioning are deterministic.
//
// Setup: Isolated emit-c. Imports std/scicomp/interior_point_lp.oo.
//
// Beats:
//   1. Construct default IpLpConfig and assert parameter boundaries.
//   2. Compute duality gap over primal and slack variable vectors.
//   3. Calculate step length fraction to boundary under negative step directions.
//   4. Print prod_g4_scicomp_interior_point: PASSED and exit 0.

import "std/scicomp/interior_point_lp.oo";

pub fn main() {
    let cfg1: IpLpConfig = ip_lp_config_default();
    let cfg2: IpLpConfig = ip_lp_config_default();
    if (cfg1).max_iters != (cfg2).max_iters || (cfg1).max_iters != 100 {
        println("FAIL ip_lp_config_default max_iters");
        process_exit(1);
    }
    if (cfg1).tolerance != 0.000001 || (cfg1).gamma_step != 0.95 {
        println("FAIL ip_lp_config_default tolerance/gamma");
        process_exit(1);
    }

    let mut x: List[Float] = list_new();
    x = list_push(x, 2.0);
    x = list_push(x, 4.0);

    let mut s: List[Float] = list_new();
    s = list_push(s, 3.0);
    s = list_push(s, 1.0);

    let gap1: Float = compute_duality_gap(&x, &s);
    let gap2: Float = compute_duality_gap(&x, &s);
    if gap1 != gap2 || gap1 < 4.999 || gap1 > 5.001 {
        println("FAIL compute_duality_gap");
        process_exit(1);
    }

    let mut v: List[Float] = list_new();
    v = list_push(v, 2.0);
    v = list_push(v, 3.0);

    let mut dv: List[Float] = list_new();
    dv = list_push(dv, 0.0 - 4.0);
    dv = list_push(dv, 0.0 - 10.0);

    let step1: Float = step_fraction_to_boundary(&v, &dv, 0.95);
    let step2: Float = step_fraction_to_boundary(&v, &dv, 0.95);
    if step1 != step2 || step1 < 0.284 || step1 > 0.286 {
        println("FAIL step_fraction_to_boundary");
        process_exit(1);
    }

    println("prod_g4_scicomp_interior_point: PASSED");
    process_exit(0);
}
