// # Product prove std/gis_topo/h3_compact_uncompact.oo
//
// Logline: Fail-closed verification that H3 cell set construction, hierarchy compaction, and uncompaction are deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_topo/h3_compact_uncompact.oo.
//
// Beats:
//   1. Construct H3Index and initialize H3CellSet collections.
//   2. Uncompact parent cell to higher resolution children.
//   3. Compact cell lists into parent resolutions.
//   4. Print prod_g4_gis_h3_compact: PASSED only if all match.

import "std/gis_topo/h3_compact_uncompact.oo";

pub fn main() {
    let idx: H3Index = h3_index_new(0, 100, 5, 10, false);
    if (idx).res != 5 || (idx).base_cell != 10 {
        println("FAIL h3_index_new");
        process_exit(1);
    }

    let mut set: H3CellSet = h3_cell_set_new();
    if (set).count != 0 {
        println("FAIL h3_cell_set_new");
        process_exit(1);
    }

    h3_cell_set_add(&mut set, idx);
    if (set).count != 1 {
        println("FAIL h3_cell_set_add");
        process_exit(1);
    }

    let uncomp_same: H3CellSet = h3_uncompact_cell(&idx, 5);
    if (uncomp_same).count != 1 {
        println("FAIL h3_uncompact_cell same res");
        process_exit(1);
    }

    let uncomp_fine: H3CellSet = h3_uncompact_cell(&idx, 6);
    if (uncomp_fine).count != 7 {
        println("FAIL h3_uncompact_cell aperture 7");
        process_exit(1);
    }

    let compacted: H3CellSet = h3_compact_cells((uncomp_fine).cells);
    if (compacted).count != 7 {
        println("FAIL h3_compact_cells");
        process_exit(1);
    }

    println("prod_g4_gis_h3_compact: PASSED");
    process_exit(0);
}
