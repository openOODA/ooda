// # Product prove std/telecom_5g/channel_3gpp_tapped_delay.oo
//
// Logline: Fail-closed emit+gcc+run asserts channel_tdl_scaled_delay_ns value or determinism.
//
// Setup: Isolated emit-c. Imports std/telecom_5g/channel_3gpp_tapped_delay.oo.
//
// Beats:
//   1. Call channel_tdl_scaled_delay_ns twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_channel_3gpp_tapped_delay: PASSED only if asserts hold.

import "std/telecom_5g/channel_3gpp_tapped_delay.oo";

pub fn main() {
    let channel_3gpp_tapped_delay_a: Float = channel_tdl_scaled_delay_ns(0.0, 0.0);
    let channel_3gpp_tapped_delay_b: Float = channel_tdl_scaled_delay_ns(0.0, 0.0);
    if channel_3gpp_tapped_delay_a != channel_3gpp_tapped_delay_b {
        println("FAIL channel_tdl_scaled_delay_ns");
        process_exit(1);
    }
    println("prod_channel_3gpp_tapped_delay: PASSED");
}
