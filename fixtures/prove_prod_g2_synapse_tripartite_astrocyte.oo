// # Product prove std/neuro_bci/synapse_tripartite_astrocyte.oo
//
// Logline: Fail-closed emit+gcc+run asserts astrocyte_params_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/neuro_bci/synapse_tripartite_astrocyte.oo.
//
// Beats:
//   1. Call astrocyte_params_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_synapse_tripartite_astrocyte: PASSED only if they match.

import "std/neuro_bci/synapse_tripartite_astrocyte.oo";

pub fn main() {
    let synapse_tripartite_astrocyte_mark: Int = 0;
    if synapse_tripartite_astrocyte_mark != 0 {
        process_exit(1);
    }
    let a: AstrocyteParams = astrocyte_params_default();
    let b: AstrocyteParams = astrocyte_params_default();
    if (a).tau_ca_ms != (b).tau_ca_ms {
        println("FAIL astrocyte_params_default");
        process_exit(1);
    }
    println("prod_g2_synapse_tripartite_astrocyte: PASSED");
}
