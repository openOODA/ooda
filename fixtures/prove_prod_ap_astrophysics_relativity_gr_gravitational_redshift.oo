// # Product prove std/astrophysics_relativity/gr_gravitational_redshift.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/astrophysics_relativity/gr_gravitational_redshift.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/gr_gravitational_redshift.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_gr_gravitational_redshift: PASSED only if they match.

import "std/astrophysics_relativity/gr_gravitational_redshift.oo";

pub fn main() {
    let gr_gravitational_redshift_a = gr_schwarzschild_redshift(0, 0);
    let gr_gravitational_redshift_b = gr_schwarzschild_redshift(0, 0);
    let gr_gravitational_redshift_va = gr_redshift_z(gr_gravitational_redshift_a);
    let gr_gravitational_redshift_vb = gr_redshift_z(gr_gravitational_redshift_b);
    if gr_gravitational_redshift_va != gr_gravitational_redshift_vb {
        println("FAIL gr_gravitational_redshift");
        process_exit(1);
    }
    println("prod_ap_gr_gravitational_redshift: PASSED");
}
