// # Product linked_list prove
//
// Logline: Fail-closed emit+gcc+run of shipped linked_list_push_back/len.
//
// Setup: Product std/collections/linked_list.oo. List[Int] destub.
//
// Beats:
//   1. After push_back 7, len 1.
//   2. Exit 1 before PASSED on a miss.

import "std/collections/linked_list.oo";

pub fn main() {
    let mut l: LinkedList = linked_list_new();
    l = linked_list_push_back(l, 7);
    let n: Int = linked_list_len(l);
    if n != 1 {
        println("FAIL llist len");
        process_exit(1);
    }
    println("prod_llist: PASSED");
}
