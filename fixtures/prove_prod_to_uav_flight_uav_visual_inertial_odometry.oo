// # Product prove std/uav_flight/uav_visual_inertial_odometry.oo
//
// Logline: Fail-closed emit+gcc+run asserts camera_intrinsics_default holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/uav_flight/uav_visual_inertial_odometry.oo.
//
// Beats:
//   1. Call camera_intrinsics_default using the uav_visual_inertial_odometry ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_uav_visual_inertial_odometry: PASSED only if asserts hold.

import "std/uav_flight/uav_visual_inertial_odometry.oo";

pub fn main() {
    let obj = camera_intrinsics_default();
    let uav_visual_inertial_odometry_a = obj.fx;
    if uav_visual_inertial_odometry_a != 460.0 {
        println("FAIL camera_intrinsics_default");
        process_exit(1);
    }
    println("prod_uav_visual_inertial_odometry: PASSED");
}
