// # Product prove std/genomics_advanced/bam_pileup_generator.oo
//
// Logline: Fail-closed verification that BAM pileup depth calculation and variant allele consensus calling are deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/bam_pileup_generator.oo.
//
// Beats:
//   1. Construct PileupLocus record with base counts.
//   2. Calculate read depth across reference and non-reference observations.
//   3. Call variant consensus and evaluate variant allele frequency.
//   4. Print prod_g4_genomics_bam_pileup: PASSED only if all match.

import "std/genomics_advanced/bam_pileup_generator.oo";

pub fn main() {
    let locus: PileupLocus = PileupLocus {
        chrom_id: 1,
        pos: 1000,
        ref_base: "A",
        count_a: 70,
        count_c: 30,
        count_g: 0,
        count_t: 0,
        count_del: 0,
        count_ins: 0,
    };

    let depth_a: Int = pileup_calculate_depth(&locus);
    let depth_b: Int = pileup_calculate_depth(&locus);
    if depth_a != depth_b || depth_a != 100 {
        println("FAIL pileup_calculate_depth");
        process_exit(1);
    }

    let cons: PileupConsensus = pileup_call_consensus(&locus, 20.0, 50);
    if (cons).total_depth != 100 || (cons).alt_depth != 30 || !(cons).has_variant {
        println("FAIL pileup_call_consensus");
        process_exit(1);
    }

    let cons_low: PileupConsensus = pileup_call_consensus(&locus, 50.0, 50);
    if (cons_low).has_variant {
        println("FAIL pileup_call_consensus min_vaf threshold");
        process_exit(1);
    }

    println("prod_g4_genomics_bam_pileup: PASSED");
    process_exit(0);
}
