// # Product prove std/satellite_dvb/satellite_itu_p840_cloud.oo
//
// Logline: Fail-closed emit+gcc+run asserts cloud_calc_kl_coefficient is a real value.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/satellite_itu_p840_cloud.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call cloud_calc_kl_coefficient twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_satellite_itu_p840_cloud: PASSED only if they match.

import "std/satellite_dvb/satellite_itu_p840_cloud.oo";

pub fn main() {
    let g0_a = cloud_calc_kl_coefficient(1.0, 1.0);
    let g0_b = cloud_calc_kl_coefficient(1.0, 1.0);
    if g0_a != g0_b {
        println("FAIL cloud_calc_kl_coefficient");
        process_exit(1);
    }
    println("prod_g0_satellite_itu_p840_cloud: PASSED");
}
