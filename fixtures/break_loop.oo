// while + if break/continue (interp + CHS C + WASM + LLVM integer subset).
// Tail `if` without trailing `;` must lower (dual-engine honesty).
pub fn main() {
    let mut i = 0;
    let mut s = 0;
    while i < 10 {
        i = i + 1;
        if i == 3 {
            continue;
        }
        if i == 8 {
            break;
        }
        s = s + i;
    }
    println(s);
}
