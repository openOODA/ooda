// # Product prove std/bft_consensus/bls_threshold_multisig.oo
//
// Logline: Fail-closed emit+gcc+run asserts bls_compute_lagrange_weight is a real value.
//
// Setup: Isolated emit-c. Imports std/bft_consensus/bls_threshold_multisig.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call bls_compute_lagrange_weight twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_bls_threshold_multisig: PASSED only if they match.

import "std/bft_consensus/bls_threshold_multisig.oo";

pub fn main() {
    let g0_a = bls_compute_lagrange_weight(0, 0);
    let g0_b = bls_compute_lagrange_weight(0, 0);
    if g0_a != g0_b {
        println("FAIL bls_compute_lagrange_weight");
        process_exit(1);
    }
    println("prod_gr_bls_threshold_multisig: PASSED");
}
