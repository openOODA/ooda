// # Product prove std/astro_advanced/launch_abort_trajectory.oo
//
// Logline: Fail-closed emit+gcc+run asserts abort_mode is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/launch_abort_trajectory.oo.
//
// Beats:
//   1. Call abort_mode twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_launch_abort_trajectory: PASSED only if they match.

import "std/astro_advanced/launch_abort_trajectory.oo";

pub fn main() {
    let a = abort_mode();
    let b = abort_mode();
    if a != b {
        println("FAIL abort_mode");
        process_exit(1);
    }
    println("prod_launch_abort_trajectory: PASSED");
}
