// # Product prove std/satellite_dvb/dvb_s2x_vcm_acm_controller.oo
//
// Logline: Fail-closed emit+gcc+run asserts acm_controller_state_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/dvb_s2x_vcm_acm_controller.oo.
//
// Beats:
//   1. Call acm_controller_state_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dvb_s2x_vcm_acm_controller: PASSED only if they match.

import "std/satellite_dvb/dvb_s2x_vcm_acm_controller.oo";

pub fn main() {
    let a: AcmControllerState = acm_controller_state_new(0.0, 1);
    let b: AcmControllerState = acm_controller_state_new(0.0, 1);
    if a.// Margin before downgrading MODCOD (e.g. 0.3 dB)
    current_modcod != b.// Margin before downgrading MODCOD (e.g. 0.3 dB)
    current_modcod {
        println("FAIL acm_controller_state_new");
        process_exit(1);
    }
    println("prod_dvb_s2x_vcm_acm_controller: PASSED");
}
