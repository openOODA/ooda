// # Product prove std/os/system_metrics_stub.oo
//
// Logline: Fail-closed emit+gcc+run asserts system_metrics_stub_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/os/system_metrics_stub.oo.
//
// Beats:
//   1. Call system_metrics_stub_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_system_metrics_stub: PASSED only if they match.

import "std/os/system_metrics_stub.oo";

pub fn main() {
    let a = system_metrics_stub_probe();
    let b = system_metrics_stub_probe();
    if a != b {
        println("FAIL system_metrics_stub_probe");
        process_exit(1);
    }
    println("prod_system_metrics_stub: PASSED");
}
