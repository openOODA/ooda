// # Prove cursor hover and definition
//
// Logline: Hover on add must say fn add, and definition must not stay on line 0.
//
// Setup: Imports cli/lsp_reply.oo. Reads fixtures/lsp_cursor.oo. cwd is ooda/.
//
// Beats:
//   1. Ident under the add call is add.
//   2. Hover JSON names fn add.
//   3. Definition range uses the fn add line.

import "cli/lsp_ident.oo";
import "cli/lsp_reply.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(fs: &FsCap) {
    if !path_exists(fs, "fixtures/lsp_cursor.oo") {
        fail("missing fixtures/lsp_cursor.oo");
    }
    let rr: Result[String, String] = read_file(fs, "fixtures/lsp_cursor.oo");
    if !rr.is_ok() {
        fail("read cursor fixture");
    }
    let src: String = match rr { Ok(s) => s, Err(m) => m };
    let call: Int = str_index_of(src, "add(1, 2)");
    if call < 0 {
        fail("no add call");
    }
    let cline: Int = lsp_line_at(src, call);
    let ccol: Int = lsp_col_at(src, call);
    let got: String = lsp_ident_at(src, lsp_src_offset(src, cline, ccol));
    if got != "add" {
        fail("ident want add got " + got);
    }
    let hover: String = "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"textDocument/hover\",\"params\":{\"textDocument\":{\"uri\":\"file://fixtures/lsp_cursor.oo\"},\"position\":{\"line\":" + cline.to_string() + ",\"character\":" + ccol.to_string() + "}}}";
    let hrep: String = lsp_reply_build(fs, hover);
    if str_index_of(hrep, "fn add") < 0 {
        fail("hover missing fn add: " + hrep);
    }
    if str_index_of(hrep, "fn main") >= 0 {
        fail("hover still first-fn: " + hrep);
    }
    let defn: String = "{\"jsonrpc\":\"2.0\",\"id\":8,\"method\":\"textDocument/definition\",\"params\":{\"textDocument\":{\"uri\":\"file://fixtures/lsp_cursor.oo\"},\"position\":{\"line\":" + cline.to_string() + ",\"character\":" + ccol.to_string() + "}}}";
    let drep: String = lsp_reply_build(fs, defn);
    let fn_at: Int = lsp_fn_pos(src, "add");
    let want_line: String = "\"line\":" + lsp_line_at(src, fn_at).to_string();
    if str_index_of(drep, want_line) < 0 {
        fail("definition line missing " + want_line + " in " + drep);
    }
    if str_index_of(drep, "\"line\":0") >= 0 {
        fail("definition still line 0: " + drep);
    }
    println("lsp_cursor_probe: PASSED");
}
