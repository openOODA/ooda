// # Product prove std/sec/objcap.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/objcap.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/objcap.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_objcap: PASSED only if they match.

import "std/sec/objcap.oo";

pub fn main() {
    let objcap_a = capability_rights_diminish(0, 0);
    let objcap_b = capability_rights_diminish(0, 0);
    if objcap_a != objcap_b {
        println("FAIL objcap");
        process_exit(1);
    }
    println("prod_ap_objcap: PASSED");
}
