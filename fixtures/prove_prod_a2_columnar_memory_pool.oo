// # Product prove std/db_columnar/columnar_memory_pool.oo
//
// Logline: Fail-closed emit+gcc+run asserts memory_pool_align_64 is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/columnar_memory_pool.oo.
//
// Beats:
//   1. Call memory_pool_align_64 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_columnar_memory_pool: PASSED only if they match.

import "std/db_columnar/columnar_memory_pool.oo";

pub fn main() {
    let columnar_memory_pool_mark: Int = 0;
    if columnar_memory_pool_mark != 0 {
        process_exit(1);
    }
    let a: Int = memory_pool_align_64(0);
    let b: Int = memory_pool_align_64(0);
    if a != b {
        println("FAIL memory_pool_align_64");
        process_exit(1);
    }
    println("prod_columnar_memory_pool: PASSED");
}
