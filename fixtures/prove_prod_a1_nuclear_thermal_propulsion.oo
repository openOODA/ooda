// # Product prove std/astro_advanced/nuclear_thermal_propulsion.oo
//
// Logline: Fail-closed emit+gcc+run asserts ntp_isp is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/nuclear_thermal_propulsion.oo.
//
// Beats:
//   1. Call ntp_isp twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_nuclear_thermal_propulsion: PASSED only if they match.

import "std/astro_advanced/nuclear_thermal_propulsion.oo";

pub fn main() {
    let nuclear_thermal_propulsion_mark: Int = 0;
    if nuclear_thermal_propulsion_mark != 0 {
        process_exit(1);
    }
    let a: Int = ntp_isp();
    let b: Int = ntp_isp();
    if a != b {
        println("FAIL ntp_isp");
        process_exit(1);
    }
    println("prod_nuclear_thermal_propulsion: PASSED");
}
