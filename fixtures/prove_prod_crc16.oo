// # Product CRC-16 CCITT-FALSE prove
//
// Logline: Fail-closed emit+gcc+run of shipped crc16_update_byte/digest.
//
// Setup: Product std/io/checksum_crc16.oo. Poly 0x1021 init 0xFFFF.
//
// Beats:
//   1. Fresh CRC-16 digest is 65535.
//   2. ASCII 123456789 is 10673 (0x29B1 CRC-16/CCITT-FALSE).
//   3. Exit 1 before PASSED on a miss.

import "std/io/checksum_crc16.oo";

pub fn main() {
    let st0: Crc16 = crc16_new();
    let d0: Int = crc16_digest(st0);
    if d0 != 65535 {
        println("FAIL crc16 empty");
        process_exit(1);
    }
    let mut st: Crc16 = crc16_new();
    st = crc16_update_byte(st, 49);
    st = crc16_update_byte(st, 50);
    st = crc16_update_byte(st, 51);
    st = crc16_update_byte(st, 52);
    st = crc16_update_byte(st, 53);
    st = crc16_update_byte(st, 54);
    st = crc16_update_byte(st, 55);
    st = crc16_update_byte(st, 56);
    st = crc16_update_byte(st, 57);
    let d: Int = crc16_digest(st);
    if d != 10673 {
        println("FAIL crc16 123456789");
        process_exit(1);
    }
    println("prod_crc16: PASSED");
}
