// # Product prove std/perf/simd_byte_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts simd_memcmp is deterministic.
//
// Setup: Isolated emit-c. Imports std/perf/simd_byte_ops.oo.
//
// Beats:
//   1. Call simd_memcmp twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_simd_byte_ops: PASSED only if they match.

import "std/perf/simd_byte_ops.oo";

pub fn main() {
    let simd_byte_ops_mark: Int = 0;
    if simd_byte_ops_mark != 0 {
        process_exit(1);
    }
    let a: Int = simd_memcmp("x", "x", 0);
    let b: Int = simd_memcmp("x", "x", 0);
    if a != b {
        println("FAIL simd_memcmp");
        process_exit(1);
    }
    println("prod_simd_byte_ops: PASSED");
}
