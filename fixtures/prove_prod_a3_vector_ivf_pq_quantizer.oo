// # Product prove std/db_storage/vector_ivf_pq_quantizer.oo
//
// Logline: Fail-closed emit+gcc+run asserts ivf_pq_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/vector_ivf_pq_quantizer.oo.
//
// Beats:
//   1. Call ivf_pq_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_vector_ivf_pq_quantizer: PASSED only if they match.

import "std/db_storage/vector_ivf_pq_quantizer.oo";

pub fn main() {
    let vector_ivf_pq_quantizer_mark: Int = 0;
    if vector_ivf_pq_quantizer_mark != 0 {
        process_exit(1);
    }
    let a: IvfPqConfig = ivf_pq_config_default();
    let b: IvfPqConfig = ivf_pq_config_default();
    if (a).num_centroids != (b).num_centroids {
        println("FAIL ivf_pq_config_default");
        process_exit(1);
    }
    println("prod_vector_ivf_pq_quantizer: PASSED");
}
