// # Product prove std/tda_topology/betti_curve_representation.oo
//
// Logline: Fail-closed emit+gcc+run asserts betti_curve_add_interval is a real value.
//
// Setup: Isolated emit-c. Imports std/tda_topology/betti_curve_representation.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call betti_curve_add_interval twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_betti_curve_representation: PASSED only if they match.

import "std/tda_topology/betti_curve_representation.oo";

pub fn main() {
    let mut g0_oa = betti_curve_new(0.0, 0.0, 0);
    let mut g0_ob = betti_curve_new(0.0, 0.0, 0);
    let g0_a = betti_curve_add_interval(&g0_oa, 0.0, 0.0, 0);
    let g0_b = betti_curve_add_interval(&g0_ob, 0.0, 0.0, 0);
    if g0_a != g0_b {
        println("FAIL betti_curve_add_interval");
        process_exit(1);
    }
    println("prod_gr_betti_curve_representation: PASSED");
}
