// # Product prove std/uav_flight/uav_time_optimal_trapezoid.oo
//
// Logline: Fail-closed emit+gcc+run asserts trap_isqrt_seed is deterministic.
//
// Setup: Isolated emit-c. Imports std/uav_flight/uav_time_optimal_trapezoid.oo.
//
// Beats:
//   1. Call trap_isqrt_seed twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_uav_time_optimal_trapezoid: PASSED only if they match.

import "std/uav_flight/uav_time_optimal_trapezoid.oo";

pub fn main() {
    let uav_time_optimal_trapezoid_mark: Int = 0;
    if uav_time_optimal_trapezoid_mark != 0 {
        process_exit(1);
    }
    let uav_time_optimal_trapezoid_a: Int = trap_isqrt_seed(1, 1);
    let uav_time_optimal_trapezoid_b: Int = trap_isqrt_seed(1, 1);
    if uav_time_optimal_trapezoid_a != uav_time_optimal_trapezoid_b {
        println("FAIL trap_isqrt_seed");
        process_exit(1);
    }
    println("prod_uav_time_optimal_trapezoid: PASSED");
}
