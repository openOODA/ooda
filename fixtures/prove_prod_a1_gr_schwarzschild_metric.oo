// # Product prove std/astrophysics_relativity/gr_schwarzschild_metric.oo
//
// Logline: Fail-closed emit+gcc+run asserts schwarzschild_gamma_t_tr_milli is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/gr_schwarzschild_metric.oo.
//
// Beats:
//   1. Call schwarzschild_gamma_t_tr_milli twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_schwarzschild_metric: PASSED only if they match.

import "std/astrophysics_relativity/gr_schwarzschild_metric.oo";

pub fn main() {
    let gr_schwarzschild_metric_mark: Int = 0;
    if gr_schwarzschild_metric_mark != 0 {
        process_exit(1);
    }
    let a: Int = schwarzschild_gamma_t_tr_milli(0, 0);
    let b: Int = schwarzschild_gamma_t_tr_milli(0, 0);
    if a != b {
        println("FAIL schwarzschild_gamma_t_tr_milli");
        process_exit(1);
    }
    println("prod_gr_schwarzschild_metric: PASSED");
}
