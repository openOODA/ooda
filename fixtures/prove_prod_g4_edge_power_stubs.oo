// # Product prove std/edge/power_stubs.oo
//
// Logline: Fail-closed verification that power stub imports, battery states, and power profiles are deterministic.
//
// Setup: Isolated emit-c. Imports std/edge/power_stubs.oo.
//
// Beats:
//   1. Construct battery states with bounded clamping.
//   2. Instantiate performance and saver power profiles.
//   3. Assert deterministic profile modes and thresholds.
//   4. Print prod_g4_edge_power_stubs: PASSED and exit 0.

import "std/edge/power_stubs.oo";

pub fn main() {
    let bat_a: BatteryState = battery_state_new(85, 12600, 1500, 98, 28, 1, 0);
    let bat_b: BatteryState = battery_state_new(85, 12600, 1500, 98, 28, 1, 0);
    if (bat_a).capacity_pct != (bat_b).capacity_pct || (bat_a).voltage_mv != 12600 {
        println("FAIL battery_state_new");
        process_exit(1);
    }
    if (bat_a).health_pct != 98 || (bat_a).charge_status != 1 {
        println("FAIL battery_state_new health/charge");
        process_exit(1);
    }

    let def_bat: BatteryState = battery_state_default();
    if (def_bat).capacity_pct != 100 || (def_bat).voltage_mv != 12000 {
        println("FAIL battery_state_default");
        process_exit(1);
    }

    let prof_perf: PowerProfile = power_profile_performance();
    let prof_save: PowerProfile = power_profile_saver();
    if (prof_perf).mode != 0 || (prof_perf).cpu_freq_pct != 100 {
        println("FAIL power_profile_performance");
        process_exit(1);
    }
    if (prof_save).mode != 2 || (prof_save).cpu_freq_pct != 50 {
        println("FAIL power_profile_saver");
        process_exit(1);
    }

    let prof_crit: PowerProfile = power_profile_critical();
    let prof_sleep: PowerProfile = power_profile_deep_sleep();
    if (prof_crit).mode != 3 || (prof_sleep).mode != 4 {
        println("FAIL critical/sleep power profile modes");
        process_exit(1);
    }

    println("prod_g4_edge_power_stubs: PASSED");
    process_exit(0);
}
