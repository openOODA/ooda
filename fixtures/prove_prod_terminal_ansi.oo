// # Product prove std/os/terminal_ansi.oo
//
// Logline: Fail-closed emit+gcc+run asserts ansi_cursor_to is deterministic.
//
// Setup: Isolated emit-c. Imports std/os/terminal_ansi.oo.
//
// Beats:
//   1. Call ansi_cursor_to twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_terminal_ansi: PASSED only if they match.

import "std/os/terminal_ansi.oo";

pub fn main() {
    let a = ansi_cursor_to(0, 0);
    let b = ansi_cursor_to(0, 0);
    if a != b {
        println("FAIL ansi_cursor_to");
        process_exit(1);
    }
    println("prod_terminal_ansi: PASSED");
}
