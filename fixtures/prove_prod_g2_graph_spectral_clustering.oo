// # Product prove std/graph_gnn/graph_spectral_clustering.oo
//
// Logline: Fail-closed emit+gcc+run asserts spectral_clustering_config_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_gnn/graph_spectral_clustering.oo.
//
// Beats:
//   1. Call spectral_clustering_config_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_graph_spectral_clustering: PASSED only if they match.

import "std/graph_gnn/graph_spectral_clustering.oo";

pub fn main() {
    let graph_spectral_clustering_mark: Int = 0;
    if graph_spectral_clustering_mark != 0 {
        process_exit(1);
    }
    let a: SpectralClusteringConfig = spectral_clustering_config_new(0, 0, 0);
    let b: SpectralClusteringConfig = spectral_clustering_config_new(0, 0, 0);
    if (a).num_nodes != (b).num_nodes {
        println("FAIL spectral_clustering_config_new");
        process_exit(1);
    }
    println("prod_g2_graph_spectral_clustering: PASSED");
}
