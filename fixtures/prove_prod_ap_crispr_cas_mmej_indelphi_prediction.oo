// # Product prove std/crispr_cas/mmej_indelphi_prediction.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/crispr_cas/mmej_indelphi_prediction.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/crispr_cas/mmej_indelphi_prediction.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_mmej_indelphi_prediction: PASSED only if they match.

import "std/crispr_cas/mmej_indelphi_prediction.oo";

pub fn main() {
    let mmej_indelphi_prediction_a = indelphi_predict_cut("x");
    let mmej_indelphi_prediction_b = indelphi_predict_cut("x");
    if mmej_indelphi_prediction_a.dominant_genotype != mmej_indelphi_prediction_b.dominant_genotype {
        println("FAIL mmej_indelphi_prediction");
        process_exit(1);
    }
    println("prod_ap_mmej_indelphi_prediction: PASSED");
}
