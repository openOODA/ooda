// # Product prove std/fin/aml.oo
//
// Logline: Fail-closed emit+gcc+run asserts anti-money laundering risk classification and rule evaluation are deterministic.
//
// Setup: Isolated emit-c. Imports std/fin/aml.oo.
//
// Beats:
//   1. Evaluate AML risk level classification and structuring detection.
//   2. Check jurisdiction risk and transaction rule compliance.
//   3. Assert deterministic return values.
//   4. Print prod_g4_fin_aml: PASSED and exit 0.

import "std/fin/aml.oo";

pub fn main() {
    let cls1: String = shim_marker_classify();
    let cls2: String = shim_marker_classify();
    if cls1 != cls2 || cls1 != "HIGH" {
        println("FAIL shim_marker_classify");
        process_exit(1);
    }

    let struct1: Bool = shim_marker_structuring();
    let struct2: Bool = shim_marker_structuring();
    if struct1 != struct2 || struct1 != true {
        println("FAIL shim_marker_structuring");
        process_exit(1);
    }

    let jur1: Int = shim_marker_jurisdiction();
    let jur2: Int = shim_marker_jurisdiction();
    if jur1 != jur2 {
        println("FAIL shim_marker_jurisdiction");
        process_exit(1);
    }

    let vel1: Int = shim_marker_velocity();
    let vel2: Int = shim_marker_velocity();
    if vel1 != vel2 {
        println("FAIL shim_marker_velocity");
        process_exit(1);
    }

    let sanc1: Bool = shim_marker_sanction_match();
    let sanc2: Bool = shim_marker_sanction_match();
    if sanc1 != sanc2 || sanc1 != true {
        println("FAIL shim_marker_sanction_match");
        process_exit(1);
    }

    let tx: TransactionNode = shim_marker_tx_new();
    let rule: PatternRule = shim_marker_rule_new();
    let ev1: Bool = shim_marker_eval_rule(tx, rule);
    let ev2: Bool = shim_marker_eval_rule(tx, rule);
    if ev1 != ev2 {
        println("FAIL shim_marker_eval_rule");
        process_exit(1);
    }

    println("prod_g4_fin_aml: PASSED");
    process_exit(0);
}
