// # Product encoding facade prove
//
// Logline: Fail-closed emit+gcc+run of shipped encoding.oo wrappers.
//
// Setup: Product std/encoding/encoding.oo hex/base64/base32/csv/url.
//
// Beats:
//   1. encoding_hex_encode hello is RFC 4648 68656c6c6f.
//   2. encoding_b64_encode hello is aGVsbG8=.
//   3. encoding_b32_encode foo is MZXW6===.
//   4. encoding_csv_escape a,b is quoted.
//   5. Exit 1 before PASSED on a miss.

import "std/encoding/encoding.oo";

pub fn main() {
    let hx: String = encoding_hex_encode("hello");
    if hx != "68656c6c6f" {
        println("FAIL encoding hex");
        process_exit(1);
    }
    let b64: String = encoding_b64_encode("hello");
    if b64 != "aGVsbG8=" {
        println("FAIL encoding b64");
        process_exit(1);
    }
    let b32: String = encoding_b32_encode("foo");
    if b32 != "MZXW6===" {
        println("FAIL encoding b32");
        process_exit(1);
    }
    let csv: String = encoding_csv_escape("a,b");
    if csv != "\"a,b\"" {
        println("FAIL encoding csv");
        process_exit(1);
    }
    let url: String = encoding_url_encode("a b");
    if url != "a%20b" {
        println("FAIL encoding url");
        process_exit(1);
    }
    println("prod_encoding: PASSED");
}
