// # Product prove std/compilers/c_header_parser.oo
//
// Logline: Fail-closed verification that C header parser state, type parsing, and AST declarations are deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers/c_header_parser.oo.
//
// Beats:
//   1. Construct token stream representing C function signature `int* foo`.
//   2. Initialize CParserState and verify cursor position.
//   3. Parse C function declaration and assert deterministic return type and pointer depth.
//   4. Print prod_g4_compilers_c_header: PASSED and exit 0.

import "std/compilers/c_header_parser.oo";

pub fn main() {
    let c_header_parser_mark: Int = 0;
    if c_header_parser_mark != 0 {
        process_exit(1);
    }

    let tok1: CToken = c_token_new(c_tok_kw_int(), 1, 1, 0);
    let tok2: CToken = c_token_new(c_tok_star(), 1, 5, 42);
    let tok3: CToken = c_token_new(c_tok_ident(), 1, 7, 0);

    let mut toks: List[CToken] = list_new();
    toks = list_push(toks, tok1);
    toks = list_push(toks, tok2);
    toks = list_push(toks, tok3);

    let mut parser1: CParserState = c_parser_new(toks);
    let mut parser2: CParserState = c_parser_new(toks);

    if (parser1).total_tokens != (parser2).total_tokens || (parser1).total_tokens != 3 {
        println("FAIL c_parser_new totals");
        process_exit(1);
    }

    let end_flag: Bool = c_parser_is_at_end(&parser1);
    if end_flag {
        println("FAIL c_parser_is_at_end");
        process_exit(1);
    }

    let decl1: CFunctionDecl = c_parser_parse_function(&mut parser1);
    let decl2: CFunctionDecl = c_parser_parse_function(&mut parser2);

    let n1: String = (decl1).name;
    let n2: String = (decl2).name;
    if n1 != n2 || n1 != "func" {
        println("FAIL c_parser_parse_function name");
        process_exit(1);
    }

    if (decl1).return_type.pointer_depth != 1 || (decl1).return_type.kind != c_type_kind_int() {
        println("FAIL c_parser_parse_function return_type");
        process_exit(1);
    }

    if (parser1).current_pos != (parser2).current_pos || (parser1).current_pos != 3 {
        println("FAIL parser current_pos");
        process_exit(1);
    }

    println("prod_g4_compilers_c_header: PASSED");
    process_exit(0);
}
