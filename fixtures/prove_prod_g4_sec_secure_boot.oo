// # Product prove std/sec/sys/secure_boot.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/sys/secure_boot.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/secure_boot.oo.
//
// Beats:
//   1. Call real functions twice with concrete test inputs.
//   2. Exit 1 if return values differ.
//   3. Print prod_g4_sec_secure_boot: PASSED and exit 0 only on match.

import "std/sec/sys/secure_boot.oo";

pub fn main() {
    let dummy_a: Int = __dummy_std_src_ooda_sec_sys_secure_boot_oo();
    let dummy_b: Int = __dummy_std_src_ooda_sec_sys_secure_boot_oo();
    if dummy_a != dummy_b {
        println("FAIL secure_boot dummy");
        process_exit(1);
    }

    let cert_a: Int = shim_marker_sboot_cert_x509();
    let cert_b: Int = shim_marker_sboot_cert_x509();
    if cert_a != cert_b {
        println("FAIL shim_marker_sboot_cert_x509");
        process_exit(1);
    }

    let act_a: Int = shim_marker_sboot_action_deny();
    let act_b: Int = shim_marker_sboot_action_deny();
    if act_a != act_b {
        println("FAIL shim_marker_sboot_action_deny");
        process_exit(1);
    }

    let v_a: SecureBootViolation = shim_marker_sboot_violation_new();
    let v_b: SecureBootViolation = shim_marker_sboot_violation_new();
    let v_type_a: Int = v_a.violation_type;
    let v_type_b: Int = v_b.violation_type;
    if v_type_a != v_type_b {
        println("FAIL violation_type mismatch");
        process_exit(1);
    }

    println("prod_g4_sec_secure_boot: PASSED");
    process_exit(0);
}
