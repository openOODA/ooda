// # emit-x86 four-arg SysV rcx call
//
// Logline: Call fth on aa, bb, cc, and hi and print the fourth arg so emit-x86 must lea %rcx then call.
//
// Setup: Product path is oodac emit-x86 on this file, then as and ld. No greet. No const-fold.
//
// Beats:
//   1. Declare four-arg String passthrough of the fourth param.
//   2. Print fth("aa", "bb", "cc", "hi").
//   3. Expect hi from a real call.

fn fth(a: String, b: String, c: String, d: String) -> String {
    return d;
}

pub fn main() {
    println(fth("aa", "bb", "cc", "hi"));
}
