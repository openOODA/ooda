// # Product prove std/space_propulsion/rocket_propulsion_isentropic.oo
//
// Logline: Fail-closed emit+gcc+run asserts nozzle_estimate_exit_mach is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/rocket_propulsion_isentropic.oo.
//
// Beats:
//   1. Call nozzle_estimate_exit_mach twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rocket_propulsion_isentropic: PASSED only if they match.

import "std/space_propulsion/rocket_propulsion_isentropic.oo";

pub fn main() {
    let rocket_propulsion_isentropic_mark: Int = 0;
    if rocket_propulsion_isentropic_mark != 0 {
        process_exit(1);
    }
    let rocket_propulsion_isentropic_a: Float = nozzle_estimate_exit_mach(1.0, 1.0);
    let rocket_propulsion_isentropic_b: Float = nozzle_estimate_exit_mach(1.0, 1.0);
    if rocket_propulsion_isentropic_a != rocket_propulsion_isentropic_b {
        println("FAIL nozzle_estimate_exit_mach");
        process_exit(1);
    }
    println("prod_rocket_propulsion_isentropic: PASSED");
}
