// # Product prove std/db_storage/wal_group_commit.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_storage/wal_group_commit.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/wal_group_commit.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_wal_group_commit: PASSED only if they match.

import "std/db_storage/wal_group_commit.oo";

pub fn main() {
    let wal_group_commit_a = group_commit_coordinator_new(0, 0);
    let wal_group_commit_b = group_commit_coordinator_new(0, 0);
    let wal_group_commit_va = group_commit_should_flush(wal_group_commit_a);
    let wal_group_commit_vb = group_commit_should_flush(wal_group_commit_b);
    if wal_group_commit_va != wal_group_commit_vb {
        println("FAIL wal_group_commit");
        process_exit(1);
    }
    println("prod_ap_wal_group_commit: PASSED");
}
