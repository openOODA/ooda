// # Product prove std/telecom/sdr_stream.oo
//
// Logline: Fail-closed emit+gcc+run asserts sdr_stream_int_to_float is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom/sdr_stream.oo.
//
// Beats:
//   1. Call sdr_stream_int_to_float twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sdr_stream: PASSED only if they match.

import "std/telecom/sdr_stream.oo";

pub fn main() {
    let sdr_stream_mark: Int = 0;
    if sdr_stream_mark != 0 {
        process_exit(1);
    }
    let sdr_stream_a: Float = sdr_stream_int_to_float(1);
    let sdr_stream_b: Float = sdr_stream_int_to_float(1);
    if sdr_stream_a != sdr_stream_b {
        println("FAIL sdr_stream_int_to_float");
        process_exit(1);
    }
    println("prod_sdr_stream: PASSED");
}
