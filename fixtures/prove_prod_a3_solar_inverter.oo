// # Product prove std/grid/solar_inverter.oo
//
// Logline: Fail-closed emit+gcc+run asserts solar_inverter_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/grid/solar_inverter.oo.
//
// Beats:
//   1. Call solar_inverter_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_solar_inverter: PASSED only if they match.

import "std/grid/solar_inverter.oo";

pub fn main() {
    let a: SolarInverter = solar_inverter_new(0, 0.0, 0.0, 0.0);
    let b: SolarInverter = solar_inverter_new(0, 0.0, 0.0, 0.0);
    if (a).inverter_id != (b).inverter_id {
        println("FAIL solar_inverter_new");
        process_exit(1);
    }
    println("prod_solar_inverter: PASSED");
}
