// # Product prove std/space_propulsion/ballistic_entry_deceleration.oo
//
// Logline: Fail-closed emit+gcc+run asserts ballistic_entry_spec_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/ballistic_entry_deceleration.oo.
//
// Beats:
//   1. Call ballistic_entry_spec_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ballistic_entry_deceleration: PASSED only if they match.

import "std/space_propulsion/ballistic_entry_deceleration.oo";

pub fn main() {
    let ballistic_entry_deceleration_mark: Int = 0;
    if ballistic_entry_deceleration_mark != 0 {
        process_exit(1);
    }
    let a: BallisticEntrySpec = ballistic_entry_spec_default();
    let b: BallisticEntrySpec = ballistic_entry_spec_default();
    if (a).entry_velocity_m_s != (b).entry_velocity_m_s {
        println("FAIL ballistic_entry_spec_default");
        process_exit(1);
    }
    println("prod_ballistic_entry_deceleration: PASSED");
}
