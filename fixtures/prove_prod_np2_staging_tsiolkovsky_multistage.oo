// # Product prove std/space_propulsion/staging_tsiolkovsky_multistage.oo
//
// Logline: Fail-closed emit+gcc+run asserts staging_compute_two_stage is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/staging_tsiolkovsky_multistage.oo.
//
// Beats:
//   1. Call staging_compute_two_stage twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_staging_tsiolkovsky_multistage: PASSED only if they match.

import "std/space_propulsion/staging_tsiolkovsky_multistage.oo";

pub fn main() {
    let staging_tsiolkovsky_multistage_mark: Int = 0;
    if staging_tsiolkovsky_multistage_mark != 0 {
        process_exit(1);
    }
    let staging_tsiolkovsky_multistage_a = staging_compute_two_stage(two_stage_spec_default_orbital());
    let staging_tsiolkovsky_multistage_b = staging_compute_two_stage(two_stage_spec_default_orbital());
    if (staging_tsiolkovsky_multistage_a).total_liftoff_mass_kg != (staging_tsiolkovsky_multistage_b).total_liftoff_mass_kg {
        println("FAIL staging_compute_two_stage");
        process_exit(1);
    }
    println("prod_staging_tsiolkovsky_multistage: PASSED");
}
