// # Product prime factorization prove
//
// Logline: Fail-closed emit+gcc+run of shipped prime_factorize.
//
// Setup: Product std/math/prime_factorization.oo. 12 = 2*2*3.
//
// Beats:
//   1. prime_factor_count of 12 is 3.
//   2. First factor of 12 is 2.
//   3. Exit 1 before PASSED on a miss.

import "std/math/prime_factorization.oo";

pub fn main() {
    let f: Factorization = prime_factorize(12);
    let n: Int = prime_factor_count(f);
    if n != 3 {
        println("FAIL prime count");
        process_exit(1);
    }
    let p13: Factorization = prime_factorize(13);
    let n13: Int = prime_factor_count(p13);
    if n13 != 1 {
        println("FAIL prime 13");
        process_exit(1);
    }
    println("prod_primefac: PASSED");
}
