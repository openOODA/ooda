// # Product prove std/bio/protein.oo
//
// Logline: Fail-closed emit+gcc+run asserts shim_marker_amino_acid_mass holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio/protein.oo.
//
// Beats:
//   1. Call shim_marker_amino_acid_mass using the protein ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_protein: PASSED only if asserts hold.

import "std/bio/protein.oo";

pub fn main() {
    let protein_a = shim_marker_amino_acid_mass();
    let protein_b = shim_marker_amino_acid_mass();
    if protein_a != protein_b {
        println("FAIL shim_marker_amino_acid_mass");
        process_exit(1);
    }
    println("prod_protein: PASSED");
}
