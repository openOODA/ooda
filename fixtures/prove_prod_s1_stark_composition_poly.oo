// # Product prove std/zk_rollup/stark_composition_poly.oo
//
// Logline: Fail-closed emit+gcc+run asserts composition_poly_evaluate_point is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/stark_composition_poly.oo.
//
// Beats:
//   1. Call composition_poly_evaluate_point twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_stark_composition_poly: PASSED only if they match.

import "std/zk_rollup/stark_composition_poly.oo";

pub fn main() {
    let stark_composition_poly_mark: Int = 0;
    if stark_composition_poly_mark != 0 {
        process_exit(1);
    }
    let stark_composition_poly_a = composition_poly_evaluate_point(composition_poly_context_new(1, 1, 1), 1, 1, 1);
    let stark_composition_poly_b = composition_poly_evaluate_point(composition_poly_context_new(1, 1, 1), 1, 1, 1);
    if (stark_composition_poly_a).eval_point != (stark_composition_poly_b).eval_point {
        println("FAIL composition_poly_evaluate_point");
        process_exit(1);
    }
    println("prod_stark_composition_poly: PASSED");
}
