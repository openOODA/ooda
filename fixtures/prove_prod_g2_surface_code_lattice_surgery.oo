// # Product prove std/quantum_advanced/surface_code_lattice_surgery.oo
//
// Logline: Fail-closed emit+gcc+run asserts boundary_rough is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_advanced/surface_code_lattice_surgery.oo.
//
// Beats:
//   1. Call boundary_rough twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_surface_code_lattice_surgery: PASSED only if they match.

import "std/quantum_advanced/surface_code_lattice_surgery.oo";

pub fn main() {
    let surface_code_lattice_surgery_mark: Int = 0;
    if surface_code_lattice_surgery_mark != 0 {
        process_exit(1);
    }
    let a: BoundaryType = boundary_rough();
    let b: BoundaryType = boundary_rough();
    if (a).mode != (b).mode {
        println("FAIL boundary_rough");
        process_exit(1);
    }
    println("prod_g2_surface_code_lattice_surgery: PASSED");
}
