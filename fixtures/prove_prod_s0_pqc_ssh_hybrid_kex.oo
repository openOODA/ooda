// # Product prove std/pqc_nist/pqc_ssh_hybrid_kex.oo
//
// Logline: Fail-closed emit+gcc+run asserts ssh_kex_mlkem768_x25519 value or determinism.
//
// Setup: Isolated emit-c. Imports std/pqc_nist/pqc_ssh_hybrid_kex.oo.
//
// Beats:
//   1. Call ssh_kex_mlkem768_x25519 twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_pqc_ssh_hybrid_kex: PASSED only if asserts hold.

import "std/pqc_nist/pqc_ssh_hybrid_kex.oo";

pub fn main() {
    let pqc_ssh_hybrid_kex_a: SshKexMethod = ssh_kex_mlkem768_x25519();
    let pqc_ssh_hybrid_kex_b: SshKexMethod = ssh_kex_mlkem768_x25519();
    if pqc_ssh_hybrid_kex_a.classical_bytes != pqc_ssh_hybrid_kex_b.classical_bytes {
        println("FAIL ssh_kex_mlkem768_x25519");
        process_exit(1);
    }
    println("prod_pqc_ssh_hybrid_kex: PASSED");
}
