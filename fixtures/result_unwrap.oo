// # Unwrap an Ok Result
//
// Logline: Result.unwrap on Ok returns the payload and main prints it.
//
// Beats:
//   1. Build Ok("hi") in make_ok.
//   2. Unwrap without a match.
//   3. Print the payload on the pass rail.

// Pass: Result.unwrap() without match — Ok path returns payload
pub fn make_ok() -> Result[String, String] {
    return Ok("hi");
}

pub fn main() {
    let r: Result[String, String] = make_ok();
    let s: String = r.unwrap();
    println(s);
}
