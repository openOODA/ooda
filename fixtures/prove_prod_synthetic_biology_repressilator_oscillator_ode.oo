// # Product prove std/synthetic_biology/repressilator_oscillator_ode.oo
//
// Logline: Fail-closed emit+check asserts repr_pow is deterministic.
//
// Setup: Isolated emit-c. Imports std/synthetic_biology/repressilator_oscillator_ode.oo.
//
// Beats:
//   1. Call repr_pow twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_repressilator_oscillator_ode: PASSED only if they match.

import "std/synthetic_biology/repressilator_oscillator_ode.oo";

pub fn main() {
    let repressilator_oscillator_ode_mark: Int = 0;
    if repressilator_oscillator_ode_mark != 0 { process_exit(1); }
    let a: Float = repr_pow(2.0, 3);
    let b: Float = repr_pow(2.0, 3);
    if a != b { process_exit(1); }
    println("prod_repressilator_oscillator_ode: PASSED");
}
