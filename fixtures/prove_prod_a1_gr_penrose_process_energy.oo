// # Product prove std/astrophysics_relativity/gr_penrose_process_energy.oo
//
// Logline: Fail-closed emit+gcc+run asserts kerr_irreducible_mass is deterministic.
//
// Setup: Isolated emit-c. Imports std/astrophysics_relativity/gr_penrose_process_energy.oo.
//
// Beats:
//   1. Call kerr_irreducible_mass twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_penrose_process_energy: PASSED only if they match.

import "std/astrophysics_relativity/gr_penrose_process_energy.oo";

pub fn main() {
    let gr_penrose_process_energy_mark: Int = 0;
    if gr_penrose_process_energy_mark != 0 {
        process_exit(1);
    }
    let a: Int = kerr_irreducible_mass(0, 0);
    let b: Int = kerr_irreducible_mass(0, 0);
    if a != b {
        println("FAIL kerr_irreducible_mass");
        process_exit(1);
    }
    println("prod_gr_penrose_process_energy: PASSED");
}
