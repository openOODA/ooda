// # Product prove std/quantum_open_systems/steady_state_liouvillian_kernel.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/quantum_open_systems/steady_state_liouvillian_kernel.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/steady_state_liouvillian_kernel.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_steady_state_liouvillian_kernel: PASSED only if they match.

import "std/quantum_open_systems/steady_state_liouvillian_kernel.oo";

pub fn main() {
    let steady_state_liouvillian_kernel_a = solve_steady_state_qubit(0.0, 0.0, 0.0, 0.0);
    let steady_state_liouvillian_kernel_b = solve_steady_state_qubit(0.0, 0.0, 0.0, 0.0);
    let steady_state_liouvillian_kernel_va = steady_state_is_physical(steady_state_liouvillian_kernel_a);
    let steady_state_liouvillian_kernel_vb = steady_state_is_physical(steady_state_liouvillian_kernel_b);
    if steady_state_liouvillian_kernel_va != steady_state_liouvillian_kernel_vb {
        println("FAIL steady_state_liouvillian_kernel");
        process_exit(1);
    }
    println("prod_ap_steady_state_liouvillian_kernel: PASSED");
}
