// # Product prove std/formal_verif/wlp_calculus_evaluator.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/formal_verif/wlp_calculus_evaluator.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/formal_verif/wlp_calculus_evaluator.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_wlp_calculus_evaluator: PASSED only if they match.

import "std/formal_verif/wlp_calculus_evaluator.oo";

pub fn main() {
    let wlp_calculus_evaluator_a = wlp_eval_assign("x", "x", "x");
    let wlp_calculus_evaluator_b = wlp_eval_assign("x", "x", "x");
    if wlp_calculus_evaluator_a.contains(wlp_calculus_evaluator_b) == false {
        println("FAIL wlp_calculus_evaluator");
        process_exit(1);
    }
    if wlp_calculus_evaluator_b.contains(wlp_calculus_evaluator_a) == false {
        println("FAIL wlp_calculus_evaluator");
        process_exit(1);
    }
    println("prod_ap_wlp_calculus_evaluator: PASSED");
}
