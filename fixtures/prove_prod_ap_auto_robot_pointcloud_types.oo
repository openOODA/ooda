// # Product prove std/auto_robot/pointcloud_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/auto_robot/pointcloud_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto_robot/pointcloud_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_pointcloud_types: PASSED only if they match.

import "std/auto_robot/pointcloud_types.oo";

pub fn main() {
    let pointcloud_types_a = point_xyz_new(0, 0, 0);
    let pointcloud_types_b = point_xyz_new(0, 0, 0);
    let pointcloud_types_va = point_xyz_dist_sq(pointcloud_types_a);
    let pointcloud_types_vb = point_xyz_dist_sq(pointcloud_types_b);
    if pointcloud_types_va != pointcloud_types_vb {
        println("FAIL pointcloud_types");
        process_exit(1);
    }
    println("prod_ap_pointcloud_types: PASSED");
}
