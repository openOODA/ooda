// # Product prove std/graph_networks/fruchterman_reingold_layout.oo
//
// Logline: Fail-closed emit+gcc+run asserts fr_approx_sqrt is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_networks/fruchterman_reingold_layout.oo.
//
// Beats:
//   1. Call fr_approx_sqrt twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fruchterman_reingold_layout: PASSED only if they match.

import "std/graph_networks/fruchterman_reingold_layout.oo";

pub fn main() {
    let fruchterman_reingold_layout_mark: Int = 0;
    if fruchterman_reingold_layout_mark != 0 {
        process_exit(1);
    }
    let fruchterman_reingold_layout_a: Int = fr_approx_sqrt(1);
    let fruchterman_reingold_layout_b: Int = fr_approx_sqrt(1);
    if fruchterman_reingold_layout_a != fruchterman_reingold_layout_b {
        println("FAIL fr_approx_sqrt");
        process_exit(1);
    }
    println("prod_fruchterman_reingold_layout: PASSED");
}
