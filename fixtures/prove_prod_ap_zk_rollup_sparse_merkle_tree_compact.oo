// # Product prove std/zk_rollup/sparse_merkle_tree_compact.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/zk_rollup/sparse_merkle_tree_compact.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/sparse_merkle_tree_compact.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_sparse_merkle_tree_compact: PASSED only if they match.

import "std/zk_rollup/sparse_merkle_tree_compact.oo";

pub fn main() {
    let sparse_merkle_tree_compact_a = smt_compact_node_new(0, "x", "x", true);
    let sparse_merkle_tree_compact_b = smt_compact_node_new(0, "x", "x", true);
    if sparse_merkle_tree_compact_a.bit_depth != sparse_merkle_tree_compact_b.bit_depth {
        println("FAIL sparse_merkle_tree_compact");
        process_exit(1);
    }
    println("prod_ap_sparse_merkle_tree_compact: PASSED");
}
