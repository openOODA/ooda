// # Product prove std/web_ecosystem/semver_comparator.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/web_ecosystem/semver_comparator.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/semver_comparator.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_semver_comparator: PASSED only if they match.

import "std/web_ecosystem/semver_comparator.oo";

pub fn main() {
    let semver_comparator_a = semver_compare(0, 0, 0, 0, 0, 0);
    let semver_comparator_b = semver_compare(0, 0, 0, 0, 0, 0);
    if semver_comparator_a != semver_comparator_b {
        println("FAIL semver_comparator");
        process_exit(1);
    }
    println("prod_ap_semver_comparator: PASSED");
}
