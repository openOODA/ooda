// # Product prove std/web_ecosystem/zod_string_validator.oo
//
// Logline: Fail-closed emit+gcc+run asserts zod_string is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/zod_string_validator.oo.
//
// Beats:
//   1. Call zod_string twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_zod_string_validator: PASSED only if they match.

import "std/web_ecosystem/zod_string_validator.oo";

pub fn main() {
    let zod_string_validator_mark: Int = 0;
    if zod_string_validator_mark != 0 {
        process_exit(1);
    }
    let a: ZodStringSchema = zod_string();
    let b: ZodStringSchema = zod_string();
    if (a).min_n != (b).min_n {
        println("FAIL zod_string");
        process_exit(1);
    }
    println("prod_g2_zod_string_validator: PASSED");
}
