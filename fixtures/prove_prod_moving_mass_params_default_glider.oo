// # Product prove std/robotics_auv/internal_moving_mass.oo
//
// Logline: Fail-closed emit+gcc+run asserts moving_mass_params_default_glider is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/internal_moving_mass.oo.
//
// Beats:
//   1. Call moving_mass_params_default_glider twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_moving_mass_params_default_glider: PASSED only if they match.

import "std/robotics_auv/internal_moving_mass.oo";

pub fn main() {
    let internal_moving_mass_mark: Int = 0;
    if internal_moving_mass_mark != 0 { process_exit(1); }
    let a: MovingMassParams = moving_mass_params_default_glider();
    let b: MovingMassParams = moving_mass_params_default_glider();
    if (a).slider_mass_kg != (b).slider_mass_kg {
        println("FAIL moving_mass_params_default_glider");
        process_exit(1);
    }
    println("prod_moving_mass_params_default_glider: PASSED");
}
