// # Product prove std/cloud_k8s/raft_leader_election.oo
//
// Logline: Fail-closed emit+gcc+run asserts raft_election_init is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_k8s/raft_leader_election.oo.
//
// Beats:
//   1. Call raft_election_init twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_raft_leader_init: PASSED only if they match.

import "std/cloud_k8s/raft_leader_election.oo";

pub fn main() {
    let raft_leader_election_mark: Int = 0;
    if raft_leader_election_mark != 0 { process_exit(1); }
    let a: RaftElectionState = raft_election_init("n1", 3, 1000, 0);
    let b: RaftElectionState = raft_election_init("n1", 3, 1000, 0);
    let an: Int = (a).current_term;
    let bn: Int = (b).current_term;
    if an != bn {
        println("FAIL raft_election_init");
        process_exit(1);
    }
    println("prod_raft_leader_init: PASSED");
}
