// # Product prove std/auto/orca_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/auto/orca_engine.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/auto/orca_engine.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_orca_engine: PASSED only if they match.

import "std/auto/orca_engine.oo";

pub fn main() {
    let orca_engine_a = orca_eng_new(0, 0);
    let orca_engine_b = orca_eng_new(0, 0);
    let orca_engine_va = orca_eng_dt(orca_engine_a);
    let orca_engine_vb = orca_eng_dt(orca_engine_b);
    if orca_engine_va != orca_engine_vb {
        println("FAIL orca_engine");
        process_exit(1);
    }
    println("prod_ap_orca_engine: PASSED");
}
