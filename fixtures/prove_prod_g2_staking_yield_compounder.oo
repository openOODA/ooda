// # Product prove std/fintech_defi/staking_yield_compounder.oo
//
// Logline: Fail-closed emit+gcc+run asserts staking_pool_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_defi/staking_yield_compounder.oo.
//
// Beats:
//   1. Call staking_pool_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_staking_yield_compounder: PASSED only if they match.

import "std/fintech_defi/staking_yield_compounder.oo";

pub fn main() {
    let staking_yield_compounder_mark: Int = 0;
    if staking_yield_compounder_mark != 0 {
        process_exit(1);
    }
    let a: StakingPool = staking_pool_new("x", "x", 0, 0, 0);
    let b: StakingPool = staking_pool_new("x", "x", 0, 0, 0);
    if (a).total_staked != (b).total_staked {
        println("FAIL staking_pool_new");
        process_exit(1);
    }
    println("prod_g2_staking_yield_compounder: PASSED");
}
