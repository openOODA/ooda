// # Product prove std/compilers_polyhedral/polyhedral_dependence_graph.oo
//
// Logline: Fail-closed emit+gcc+run asserts pdg_has_cycle_at_level is a real value.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/polyhedral_dependence_graph.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call pdg_has_cycle_at_level twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_polyhedral_dependence_graph: PASSED only if they match.

import "std/compilers_polyhedral/polyhedral_dependence_graph.oo";

pub fn main() {
    let g0_oa = pdg_new();
    let g0_ob = pdg_new();
    let g0_a = pdg_has_cycle_at_level(g0_oa, 2);
    let g0_b = pdg_has_cycle_at_level(g0_ob, 2);
    if g0_a != g0_b {
        println("FAIL pdg_has_cycle_at_level");
        process_exit(1);
    }
    println("prod_g0_polyhedral_dependence_graph: PASSED");
}
