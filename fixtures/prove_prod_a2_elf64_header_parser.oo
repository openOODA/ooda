// # Product prove std/compilers_vm/elf64_header_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts elf_et_rel is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_vm/elf64_header_parser.oo.
//
// Beats:
//   1. Call elf_et_rel twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_elf64_header_parser: PASSED only if they match.

import "std/compilers_vm/elf64_header_parser.oo";

pub fn main() {
    let elf64_header_parser_mark: Int = 0;
    if elf64_header_parser_mark != 0 {
        process_exit(1);
    }
    let a: Int = elf_et_rel();
    let b: Int = elf_et_rel();
    if a != b {
        println("FAIL elf_et_rel");
        process_exit(1);
    }
    println("prod_elf64_header_parser: PASSED");
}
