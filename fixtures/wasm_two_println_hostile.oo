// # Hostile two-println mixed concat
//
// Logline: Print one string then a mixed concat so emit-wasm must not drop the second print.
//
// Setup: First println is STRING. Second is ident plus STRING. Not a two-STRING fold.
//
// Beats:
//   1. Bind x to a string literal.
//   2. Print keep-me then x plus no.
//   3. A keep-me-only module is a lie.

pub fn main() {
    let x = "x";
    println("keep-me");
    println(x + "no");
}
