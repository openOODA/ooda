// # Product prove std/gui/core.oo
//
// Logline: Fail-closed emit+gcc+run asserts gui_context_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/gui/core.oo.
//
// Beats:
//   1. Call gui_context_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_core: PASSED only if they match.

import "std/gui/core.oo";

pub fn main() {
    let core_mark: Int = 0;
    if core_mark != 0 {
        process_exit(1);
    }
    let a: GuiContext = gui_context_new(0, 0);
    let b: GuiContext = gui_context_new(0, 0);
    if (a).width != (b).width {
        println("FAIL gui_context_new");
        process_exit(1);
    }
    println("prod_core: PASSED");
}
