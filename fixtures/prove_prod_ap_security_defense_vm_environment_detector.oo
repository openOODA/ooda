// # Product prove std/security_defense/vm_environment_detector.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/security_defense/vm_environment_detector.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/security_defense/vm_environment_detector.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_vm_environment_detector: PASSED only if they match.

import "std/security_defense/vm_environment_detector.oo";

pub fn main() {
    let vm_environment_detector_a = hypervisor_signature_match("x");
    let vm_environment_detector_b = hypervisor_signature_match("x");
    if vm_environment_detector_a.contains(vm_environment_detector_b) == false {
        println("FAIL vm_environment_detector");
        process_exit(1);
    }
    if vm_environment_detector_b.contains(vm_environment_detector_a) == false {
        println("FAIL vm_environment_detector");
        process_exit(1);
    }
    println("prod_ap_vm_environment_detector: PASSED");
}
