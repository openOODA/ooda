// # Const if true print
//
// Logline: Print T only from the true arm of if true.
//
// Setup: Side emit-aarch64 harvests the true arm. Else is skipped.
//
// Beats:
//   1. if true print T.
//   2. else print F.
//   3. Expect T only.

pub fn main() {
    if true {
        println("T");
    } else {
        println("F");
    }
}
