    let a: MockOrderFeed = mock_order_feed_new("x", 0);
    let b: MockOrderFeed = mock_order_feed_new("x", 0);
    if a.base_price != b.base_price {
        println("FAIL mock_order_feed_new");
        process_exit(1);
    }
    println("prod_fintech_defi_stubs: PASSED");
