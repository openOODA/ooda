// # Product prove std/tda_topology/graph_persistent_homology.oo
//
// Logline: Fail-closed emit+gcc+run asserts graph_persistence_summary_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/graph_persistent_homology.oo.
//
// Beats:
//   1. Call graph_persistence_summary_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_graph_persistent_homology: PASSED only if they match.

import "std/tda_topology/graph_persistent_homology.oo";

pub fn main() {
    let graph_persistent_homology_mark: Int = 0;
    if graph_persistent_homology_mark != 0 {
        process_exit(1);
    }
    let graph_persistent_homology_a = graph_persistence_summary_new(1);
    let graph_persistent_homology_b = graph_persistence_summary_new(1);
    if (graph_persistent_homology_a).num_nodes != (graph_persistent_homology_b).num_nodes {
        println("FAIL graph_persistence_summary_new");
        process_exit(1);
    }
    println("prod_graph_persistent_homology: PASSED");
}
