// # Call connect and send as methods
//
// Logline: Open a Sock and invoke connect and send as methods on s.
//
// Setup: Test fixture. Keep TYPESTATE directives and all code exact.
//
// Beats:
//   1. Open into Closed.
//   2. Call s.connect().
//   3. Call s.send().
//
// TYPESTATE: Sock Closed Open
// TYPESTATE fn open_sock: -> Closed
// TYPESTATE fn connect: Closed -> Open
// TYPESTATE fn send: Open -> Open

fn open_sock() -> Int { return 1; }
fn connect(s: Int) { let x = s; }
fn send(s: Int) { let x = s; }

pub fn main() {
    let s = open_sock();
    s.connect();
    s.send();
}
