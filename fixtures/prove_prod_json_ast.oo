// # Product prove std/markup/json_ast.oo
//
// Logline: Fail-closed emit+gcc+run asserts json_is_null is deterministic.
//
// Setup: Isolated emit-c. Imports std/markup/json_ast.oo.
//
// Beats:
//   1. Call json_is_null twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_json_ast: PASSED only if they match.

import "std/markup/json_ast.oo";

pub fn main() {
    let obj = json_node_null();
    let a = json_is_null(obj);
    let b = json_is_null(obj);
    if a != b {
        println("FAIL json_is_null");
        process_exit(1);
    }
    println("prod_json_ast: PASSED");
}
