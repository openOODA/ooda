// # Product prove std/iot_scada/plc_ladder_rung_eval.oo
//
// Logline: Fail-closed emit+gcc+run asserts plc_eval_contact_no is deterministic.
//
// Setup: Isolated emit-c. Imports std/iot_scada/plc_ladder_rung_eval.oo.
//
// Beats:
//   1. Call plc_eval_contact_no twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_plc_ladder_rung_eval: PASSED only if they match.

import "std/iot_scada/plc_ladder_rung_eval.oo";

pub fn main() {
    let plc_ladder_rung_eval_mark: Int = 0;
    if plc_ladder_rung_eval_mark != 0 {
        process_exit(1);
    }
    let a: Bool = plc_eval_contact_no(true, true);
    let b: Bool = plc_eval_contact_no(true, true);
    if a != b {
        println("FAIL plc_eval_contact_no");
        process_exit(1);
    }
    println("prod_plc_ladder_rung_eval: PASSED");
}
