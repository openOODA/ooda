// # Product prove advanced collections
//
// Logline: Fail-closed emit+gcc+run drives B-tree, Bloom, LRU, and skip list get, miss, range, and eviction.
//
// Setup: Isolated emit-c. Run from ooda/.
//
// Beats:
//   1. B-tree insert, get, miss, and ordered range.
//   2. Bloom never misses an inserted key.
//   3. LRU evicts the least-recent key.
//   4. Skip list insert, get, miss, and ordered range.

import "std/collections_advanced/btree_map.oo";
import "std/collections_advanced/bloom_filter.oo";
import "std/collections_advanced/lru_cache.oo";
import "std/collections_advanced/skip_list.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

fn unwrap(r: Result[List[Int], String], msg: String) -> List[Int] {
    match r {
        Ok(v) => { return v; },
        Err(e) => { fail(msg + ": " + e); return list_new(); }
    }
}

fn unwrap_i(r: Result[Int, String], msg: String) -> Int {
    match r {
        Ok(v) => { return v; },
        Err(e) => { fail(msg + ": " + e); return 0; }
    }
}

fn unwrap_b(r: Result[Bool, String], msg: String) -> Bool {
    match r {
        Ok(v) => { return v; },
        Err(e) => { fail(msg + ": " + e); return false; }
    }
}

fn prove_bt() {
    let mut t: List[Int] = btree_map_new();
    t = unwrap(btree_map_put(t, 5, 50), "bt 5");
    t = unwrap(btree_map_put(t, 3, 30), "bt 3");
    t = unwrap(btree_map_put(t, 8, 80), "bt 8");
    t = unwrap(btree_map_put(t, 1, 10), "bt 1");
    t = unwrap(btree_map_put(t, 7, 70), "bt 7");
    if unwrap_i(btree_map_get(t, 5), "bt get 5") != 50 { fail("bt get"); }
    let miss: Result[Int, String] = btree_map_get(t, 99);
    match miss {
        Ok(v) => { fail("bt miss hit " + v.to_string()); },
        Err(e) => { println("B-tree missing " + e); }
    }
    let rg: List[Int] = unwrap(btree_map_range(t, 1, 8), "bt range");
    let mut i: Int = 1;
    while i < list_len(rg) {
        if list_get(rg, i) < list_get(rg, i - 1) { fail("bt range order"); }
        i = i + 1;
    }
    if list_len(rg) < 5 { fail("bt range n"); }
    println("B-tree insert get miss range n=" + list_len(rg).to_string());
}

fn prove_bloom() {
    let mut bf: List[Int] = unwrap(bloom_filter_new(128, 3), "bloom new");
    bf = unwrap(bloom_filter_add(bf, 11), "bloom add 11");
    bf = unwrap(bloom_filter_add(bf, 22), "bloom add 22");
    bf = unwrap(bloom_filter_add(bf, 33), "bloom add 33");
    if unwrap_b(bloom_filter_has(bf, 11), "bloom 11") == false { fail("bloom fn 11"); }
    if unwrap_b(bloom_filter_has(bf, 22), "bloom 22") == false { fail("bloom fn 22"); }
    if unwrap_b(bloom_filter_has(bf, 33), "bloom 33") == false { fail("bloom fn 33"); }
    let fresh: Bool = unwrap_b(bloom_filter_has(bf, 999991), "bloom fresh");
    println("Bloom inserted present fresh=" + fresh.to_string());
}

fn prove_lru() {
    let mut c: List[Int] = unwrap(lru_cache_new(2), "lru new");
    c = unwrap(lru_cache_put(c, 1, 10), "lru put 1");
    c = unwrap(lru_cache_put(c, 2, 20), "lru put 2");
    let g: List[Int] = unwrap(lru_cache_get(c, 1), "lru get 1");
    if list_get(g, 0) != 10 { fail("lru val"); }
    let mut c2: List[Int] = list_new();
    let mut i: Int = 1;
    while i < list_len(g) {
        c2 = list_push(c2, list_get(g, i));
        i = i + 1;
    }
    c2 = unwrap(lru_cache_put(c2, 3, 30), "lru put 3");
    if lru_cache_has(c2, 2) { fail("lru did not evict 2"); }
    if lru_cache_has(c2, 1) == false { fail("lru kept 1"); }
    if lru_cache_has(c2, 3) == false { fail("lru has 3"); }
    println("LRU evicted least-recent key 2");
}

fn prove_skip() {
    let mut t: List[Int] = skip_list_new();
    t = unwrap(skip_list_put(t, 3, 30), "sk 3");
    t = unwrap(skip_list_put(t, 1, 10), "sk 1");
    t = unwrap(skip_list_put(t, 4, 40), "sk 4");
    if unwrap_i(skip_list_get(t, 1), "sk get 1") != 10 { fail("sk get"); }
    let miss: Result[Int, String] = skip_list_get(t, 9);
    match miss {
        Ok(v) => { fail("sk miss hit " + v.to_string()); },
        Err(e) => { println("Skip missing " + e); }
    }
    let rg: List[Int] = unwrap(skip_list_range(t, 1, 4), "sk range");
    if list_len(rg) != 3 { fail("sk range n"); }
    if list_get(rg, 0) != 1 { fail("sk range 0"); }
    if list_get(rg, 1) != 3 { fail("sk range 1"); }
    if list_get(rg, 2) != 4 { fail("sk range 2"); }
    println("Skip list insert get range ordered");
}

pub fn main() {
    prove_bt();
    prove_bloom();
    prove_lru();
    prove_skip();
    println("prove_prod_collections: PASSED");
}
