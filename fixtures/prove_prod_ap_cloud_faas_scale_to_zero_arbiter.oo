import "std/cloud_faas/scale_to_zero_arbiter.oo";

pub fn main() {
    let scale_to_zero_arbiter_a = scale_to_zero_arbiter_new(0);
    let scale_to_zero_arbiter_b = scale_to_zero_arbiter_new(0);
    if scale_to_zero_arbiter_a.idle_timeout_ms != scale_to_zero_arbiter_b.idle_timeout_ms {
        println("FAIL scale_to_zero_arbiter");
        process_exit(1);
    }
