// # Product prove std/quantum_tensor_nets/dmrg_excited_states.oo
//
// Logline: Fail-closed emit+gcc+run asserts excited_state_penalty_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_tensor_nets/dmrg_excited_states.oo.
//
// Beats:
//   1. Call excited_state_penalty_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_dmrg_excited_states: PASSED only if they match.

import "std/quantum_tensor_nets/dmrg_excited_states.oo";

pub fn main() {
    let dmrg_excited_states_mark: Int = 0;
    if dmrg_excited_states_mark != 0 {
        process_exit(1);
    }
    let a: ExcitedStatePenalty = excited_state_penalty_new(0, 0.0);
    let b: ExcitedStatePenalty = excited_state_penalty_new(0, 0.0);
    if (a).state_id != (b).state_id {
        println("FAIL excited_state_penalty_new");
        process_exit(1);
    }
    println("prod_dmrg_excited_states: PASSED");
}
