// # Product prove std/fhe_lattices/fhe_bfv_ciphertext.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/fhe_lattices/fhe_bfv_ciphertext.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/fhe_lattices/fhe_bfv_ciphertext.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_fhe_bfv_ciphertext: PASSED only if they match.

import "std/fhe_lattices/fhe_bfv_ciphertext.oo";

pub fn main() {
    let fhe_bfv_ciphertext_a = bfv_compute_delta(0, 0);
    let fhe_bfv_ciphertext_b = bfv_compute_delta(0, 0);
    if fhe_bfv_ciphertext_a != fhe_bfv_ciphertext_b {
        println("FAIL fhe_bfv_ciphertext");
        process_exit(1);
    }
    println("prod_ap_fhe_bfv_ciphertext: PASSED");
}
