// # Adversarial Test: rational_exact overflow boundaries
//
// Logline: Verify the rational_exact module rejects signed overflow on LLONG_MIN sign normalization and on canonical reduction, exposes the safe-range predicate, and supports negation and invariant checks.
//
// Setup: Imports std/math_exact/rational_exact.oo. Tests use direct .val extraction. Each test either fails closed with Err or produces the exact mathematical result.
//
// Beats:
//   1. LLONG_MIN as denominator: rational_new(1, LLONG_MIN) must return Err.
//   2. LLONG_MIN as numerator: rational_new(LLONG_MIN, -1) must return Err.
//   3. rational_is_in_safe_range: small values are in range; values beyond i32 are not.
//   4. rational_negate(1/2) == -1/2; rational_negate(LLONG_MIN/1) is Err.
//   5. rational_invariant_check confirms canonical form post-conditions.
//   6. Boundary positive/positive cases still work: 2/4 == 1/2; 1/2 + 1/3 == 5/6.

import "std/math_exact/rational_exact.oo";

fn re_assert(label: String, ok: Bool) {
    if ok == false {
        println("FAIL: " + label);
        process_exit(1);
    }
}

pub fn main() {
    // Test 1: LLONG_MIN as denominator must be rejected.
    let r1: Result[Rational, String] = rational_new(1, 0 - 9223372036854775807 - 1);
    re_assert("rational_new(1, LLONG_MIN) is_err", r1.is_err());

    // Test 2: LLONG_MIN as numerator with negative denominator must be rejected.
    let r2: Result[Rational, String] = rational_new(0 - 9223372036854775807 - 1, -1);
    re_assert("rational_new(LLONG_MIN, -1) is_err", r2.is_err());

    // Test 3: rational_is_in_safe_range predicate.
    let small_in: Bool = rational_is_in_safe_range(100);
    re_assert("rational_is_in_safe_range(100) == true", small_in);
    let huge_in: Bool = rational_is_in_safe_range(9223372036854775807);
    re_assert("rational_is_in_safe_range(LLONG_MAX) == false", huge_in == false);

    // Test 4: rational_negate.
    let nr: Result[Rational, String] = rational_new(1, 2);
    if nr.is_ok() {
        let neg: Result[Rational, String] = rational_negate(nr.val);
        if neg.is_ok() {
            let nr2: Rational = neg.val;
            let n: Int = rational_num(nr2);
            let d: Int = rational_den(nr2);
            re_assert("negate(1/2) == -1/2", n == -1 && d == 2);
        } else {
            re_assert("negate(1/2) is_ok", false);
        }
    } else {
        re_assert("rational_new(1, 2) is_ok", false);
    }

    // Test 5: rational_invariant_check on canonical rational.
    let cr: Result[Rational, String] = rational_new(3, 7);
    if cr.is_ok() {
        let ok: Bool = rational_invariant_check(cr.val);
        re_assert("invariant_check(3/7) == true", ok);
    } else {
        re_assert("rational_new(3, 7) is_ok", false);
    }

    // Test 6: 1/2 + 1/3 == 5/6 (regression).
    let a_r: Result[Rational, String] = rational_new(1, 2);
    let b_r: Result[Rational, String] = rational_new(1, 3);
    if a_r.is_ok() && b_r.is_ok() {
        let sum: Result[Rational, String] = rational_add(a_r.val, b_r.val);
        if sum.is_ok() {
            let s: Rational = sum.val;
            let n: Int = rational_num(s);
            let d: Int = rational_den(s);
            re_assert("1/2 + 1/3 == 5/6", n == 5 && d == 6);
        } else {
            re_assert("1/2 + 1/3 is_ok", false);
        }
    } else {
        re_assert("rational_new(1, 2) and rational_new(1, 3) both ok", false);
    }

    // Test 7: 2/4 reduces to 1/2.
    let r4: Result[Rational, String] = rational_new(2, 4);
    if r4.is_ok() {
        let ra: Rational = r4.val;
        let n: Int = rational_num(ra);
        let d: Int = rational_den(ra);
        re_assert("2/4 reduces to 1/2", n == 1 && d == 2);
    } else {
        re_assert("rational_new(2, 4) is_ok", false);
    }

    // Test 8: 0/5 reduces to 0/1.
    let r5: Result[Rational, String] = rational_new(0, 5);
    if r5.is_ok() {
        let ra: Rational = r5.val;
        let n: Int = rational_num(ra);
        let d: Int = rational_den(ra);
        re_assert("0/5 reduces to 0/1", n == 0 && d == 1);
    } else {
        re_assert("rational_new(0, 5) is_ok", false);
    }

    // Test 9: 1/-2 normalizes to -1/2.
    let r6: Result[Rational, String] = rational_new(1, -2);
    if r6.is_ok() {
        let ra: Rational = r6.val;
        let n: Int = rational_num(ra);
        let d: Int = rational_den(ra);
        re_assert("1/-2 normalizes to -1/2", n == -1 && d == 2);
    } else {
        re_assert("rational_new(1, -2) is_ok", false);
    }

    println("test_rational_exact_overflow: PASSED");
}

