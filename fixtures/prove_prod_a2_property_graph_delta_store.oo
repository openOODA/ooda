// # Product prove std/db_graph/property_graph_delta_store.oo
//
// Logline: Fail-closed emit+gcc+run asserts graph_delta_store_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_graph/property_graph_delta_store.oo.
//
// Beats:
//   1. Call graph_delta_store_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_property_graph_delta_store: PASSED only if they match.

import "std/db_graph/property_graph_delta_store.oo";

pub fn main() {
    let property_graph_delta_store_mark: Int = 0;
    if property_graph_delta_store_mark != 0 {
        process_exit(1);
    }
    let a: GraphDeltaStore = graph_delta_store_new(0);
    let b: GraphDeltaStore = graph_delta_store_new(0);
    if (a).tx_id != (b).tx_id {
        println("FAIL graph_delta_store_new");
        process_exit(1);
    }
    println("prod_property_graph_delta_store: PASSED");
}
