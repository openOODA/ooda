// # Product prove std/hft_alpha/mm_almgren_chriss_trajectory.oo
//
// Logline: Fail-closed emit+gcc+run asserts ac_compute_kappa is a real value.
//
// Setup: Isolated emit-c. Imports std/hft_alpha/mm_almgren_chriss_trajectory.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call ac_compute_kappa twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_mm_almgren_chriss_trajectory: PASSED only if they match.

import "std/hft_alpha/mm_almgren_chriss_trajectory.oo";

pub fn main() {
    let g2_oa: AlmgrenChrissParams = AlmgrenChrissParams { total_shares_x0: 1.0, time_horizon_t: 1.0, num_intervals_n: 2, volatility_sigma: 1.0, risk_aversion_lambda: 1.0, temp_impact_eta: 1.0, perm_impact_gamma: 1.0 };
    let g2_ob: AlmgrenChrissParams = AlmgrenChrissParams { total_shares_x0: 1.0, time_horizon_t: 1.0, num_intervals_n: 2, volatility_sigma: 1.0, risk_aversion_lambda: 1.0, temp_impact_eta: 1.0, perm_impact_gamma: 1.0 };
    let g2_a = ac_compute_kappa(&g2_oa);
    let g2_b = ac_compute_kappa(&g2_ob);
    if g2_a != g2_b {
        println("FAIL ac_compute_kappa");
        process_exit(1);
    }
    println("prod_g2_mm_almgren_chriss_trajectory: PASSED");
}
