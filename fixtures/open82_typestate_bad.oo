// # OPEN-82 use-after-close must fail check
//
// Logline: After file_close, file_read is illegal. Check prints ERR typestate.
//
// Setup: Same FileHandle machine. No user type_state_check.
//
// Beats:
//   1. Legal init, open, close.
//   2. file_read after close is refused at check.
//   3. Do not print PASSED.

// TYPESTATE: FileHandle Unopened Opened Closed
// TYPESTATE fn file_init: -> Unopened
// TYPESTATE fn file_open: Unopened -> Opened
// TYPESTATE fn file_read: Opened -> Opened
// TYPESTATE fn file_close: Opened -> Closed

fn file_init() -> Int { return 1; }
fn file_open(f: Int) { let x = f; }
fn file_read(f: Int) { let x = f; }
fn file_close(f: Int) { let x = f; }

pub fn main() {
    let fh = file_init();
    file_open(fh);
    file_close(fh);
    file_read(fh);
}
