// # Product prove std/tda_topology/heat_kernel_signature_tda.oo
//
// Logline: Fail-closed emit+gcc+run asserts heat_point_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/heat_kernel_signature_tda.oo.
//
// Beats:
//   1. Call heat_point_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_heat_kernel_signature_tda: PASSED only if they match.

import "std/tda_topology/heat_kernel_signature_tda.oo";

pub fn main() {
    let heat_kernel_signature_tda_mark: Int = 0;
    if heat_kernel_signature_tda_mark != 0 {
        process_exit(1);
    }
    let heat_kernel_signature_tda_a: HeatPoint = heat_point_new(1.0, 1.0);
    let heat_kernel_signature_tda_b: HeatPoint = heat_point_new(1.0, 1.0);
    if (heat_kernel_signature_tda_a).birth != (heat_kernel_signature_tda_b).birth {
        println("FAIL heat_point_new");
        process_exit(1);
    }
    println("prod_heat_kernel_signature_tda: PASSED");
}
