// # Product prove std/db_storage/btree_bulk_loader.oo
//
// Logline: Fail-closed emit+gcc+run asserts bulk_loader_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_storage/btree_bulk_loader.oo.
//
// Beats:
//   1. Call bulk_loader_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_btree_bulk_loader: PASSED only if they match.

import "std/db_storage/btree_bulk_loader.oo";

pub fn main() {
    let btree_bulk_loader_mark: Int = 0;
    if btree_bulk_loader_mark != 0 {
        process_exit(1);
    }
    let a: BulkLoaderConfig = bulk_loader_config_default();
    let b: BulkLoaderConfig = bulk_loader_config_default();
    if (a).page_capacity_keys != (b).page_capacity_keys {
        println("FAIL bulk_loader_config_default");
        process_exit(1);
    }
    println("prod_btree_bulk_loader: PASSED");
}
