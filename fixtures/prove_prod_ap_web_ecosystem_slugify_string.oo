// # Product prove std/web_ecosystem/slugify_string.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/web_ecosystem/slugify_string.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/slugify_string.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_slugify_string: PASSED only if they match.

import "std/web_ecosystem/slugify_string.oo";

pub fn main() {
    let slugify_string_a = to_char_lower("x");
    let slugify_string_b = to_char_lower("x");
    if slugify_string_a.contains(slugify_string_b) == false {
        println("FAIL slugify_string");
        process_exit(1);
    }
    if slugify_string_b.contains(slugify_string_a) == false {
        println("FAIL slugify_string");
        process_exit(1);
    }
    println("prod_ap_slugify_string: PASSED");
}
