// # Product prove std/tda_topology/simplicial_complex_core.oo
//
// Logline: Fail-closed emit+gcc+run asserts simplex_has_vertex is a real value.
//
// Setup: Isolated emit-c. Imports std/tda_topology/simplicial_complex_core.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call simplex_has_vertex twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_simplicial_complex_core: PASSED only if they match.

import "std/tda_topology/simplicial_complex_core.oo";

pub fn main() {
    let g0_oa: Simplex = Simplex { vertices: list_new(), dimension: 0, filtration_val: 0.0, id: 0 };
    let g0_ob: Simplex = Simplex { vertices: list_new(), dimension: 0, filtration_val: 0.0, id: 0 };
    let g0_a = simplex_has_vertex(&g0_oa, 0);
    let g0_b = simplex_has_vertex(&g0_ob, 0);
    if g0_a != g0_b {
        println("FAIL simplex_has_vertex");
        process_exit(1);
    }
    println("prod_gr_simplicial_complex_core: PASSED");
}
