// # Product prove std/web_ecosystem/path_to_regexp.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/web_ecosystem/path_to_regexp.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_ecosystem/path_to_regexp.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_path_to_regexp: PASSED only if they match.

import "std/web_ecosystem/path_to_regexp.oo";

pub fn main() {
    let path_to_regexp_a = route_static_match(0, 0);
    let path_to_regexp_b = route_static_match(0, 0);
    if path_to_regexp_a != path_to_regexp_b {
        println("FAIL path_to_regexp");
        process_exit(1);
    }
    println("prod_ap_path_to_regexp: PASSED");
}
