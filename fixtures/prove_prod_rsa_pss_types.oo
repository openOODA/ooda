// # Product prove std/sec/crypto/rsa_pss_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts rsa_legacy_pub is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/rsa_pss_types.oo.
//
// Beats:
//   1. Call rsa_legacy_pub twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rsa_pss_types: PASSED only if they match.

import "std/sec/crypto/rsa_pss_types.oo";

pub fn main() {
    let obj = rsa_legacy_pub("x", 0);
    let a = obj.e_exponent;
    let b = obj.e_exponent;
    if a != b {
        println("FAIL rsa_legacy_pub");
        process_exit(1);
    }
    println("prod_rsa_pss_types: PASSED");
}
