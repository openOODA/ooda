// # Product prove std/genomics_advanced/spatial_transcriptomics_grid.oo
//
// Logline: Fail-closed emit+gcc+run asserts spatial_transcriptomics_grid_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/spatial_transcriptomics_grid.oo.
//
// Beats:
//   1. Call spatial_transcriptomics_grid_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_spatial_transcriptomics_grid: PASSED only if it matches.

import "std/genomics_advanced/spatial_transcriptomics_grid.oo";

pub fn main() {
    let a: Int = spatial_transcriptomics_grid_probe();
    if a != 0 {
        println("FAIL spatial_transcriptomics_grid_probe");
        process_exit(1);
    }
    println("prod_nc_spatial_transcriptomics_grid: PASSED");
}
