// # Product prove std/lidar_perception/progressive_morphological_filter.oo
//
// Logline: Fail-closed emit+gcc+run asserts pmf_is_ground_point is deterministic.
//
// Setup: Isolated emit-c. Imports std/lidar_perception/progressive_morphological_filter.oo.
//
// Beats:
//   1. Call pmf_is_ground_point twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_progressive_morphological_filter: PASSED only if they match.

import "std/lidar_perception/progressive_morphological_filter.oo";

pub fn main() {
    let progressive_morphological_filter_mark: Int = 0;
    if progressive_morphological_filter_mark != 0 {
        process_exit(1);
    }
    let a: Bool = pmf_is_ground_point(0.0, 0.0, 0.0);
    let b: Bool = pmf_is_ground_point(0.0, 0.0, 0.0);
    if a != b {
        println("FAIL pmf_is_ground_point");
        process_exit(1);
    }
    println("prod_g2_progressive_morphological_filter: PASSED");
}
