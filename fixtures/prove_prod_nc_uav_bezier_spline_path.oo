// # Product prove std/uav_flight/uav_bezier_spline_path.oo
//
// Logline: Fail-closed emit+gcc+run asserts uav_bezier_spline_path_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/uav_flight/uav_bezier_spline_path.oo.
//
// Beats:
//   1. Call uav_bezier_spline_path_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_uav_bezier_spline_path: PASSED only if it matches.

import "std/uav_flight/uav_bezier_spline_path.oo";

pub fn main() {
    let a: Int = uav_bezier_spline_path_probe();
    if a != 0 {
        println("FAIL uav_bezier_spline_path_probe");
        process_exit(1);
    }
    println("prod_nc_uav_bezier_spline_path: PASSED");
}
