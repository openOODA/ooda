// # Product prove std/nerf_3dgs/nerf_positional_volumetric.oo
//
// Logline: Fail-closed verification that NeRF network configuration defaults and volumetric point evaluation are deterministic.
//
// Setup: Isolated emit-c. Imports std/nerf_3dgs/nerf_positional_volumetric.oo.
//
// Beats:
//   1. Construct default NeRF network architecture configurations and assert hyperparameters.
//   2. Evaluate volume density sigma and view-dependent directional radiance at interior and exterior points.
//   3. Assert deterministic density extinction coefficients and RGB color channels.
//   4. Print prod_g4_nerf_volumetric: PASSED and exit 0.

import "std/nerf_3dgs/nerf_positional_volumetric.oo";

pub fn main() {
    let cfg1: NeRFNetworkConfig = nerf_network_config_default();
    let cfg2: NeRFNetworkConfig = nerf_network_config_default();
    if (cfg1).num_layers_pos != (cfg2).num_layers_pos || (cfg1).num_layers_pos != 8 {
        println("FAIL nerf_network_config_default num_layers_pos");
        process_exit(1);
    }
    if (cfg1).hidden_dim != 256 || (cfg1).pos_freq_bands != 10 || (cfg1).dir_freq_bands != 4 {
        println("FAIL nerf_network_config_default dimensions");
        process_exit(1);
    }

    let p_center: Vec3 = vec3_new(0.0, 0.0, 0.0);
    let d_up: Vec3 = vec3_new(0.0, 1.0, 0.0);
    let eval1: NeRFEvaluation = nerf_evaluate_point_mock(&p_center, &d_up, &cfg1);
    let eval2: NeRFEvaluation = nerf_evaluate_point_mock(&p_center, &d_up, &cfg1);
    if (eval1).density != (eval2).density || (eval1).density != 10.0 {
        println("FAIL nerf_evaluate_point_mock center density");
        process_exit(1);
    }
    if (eval1).rgb.x != (eval2).rgb.x || (eval1).rgb.x <= 0.0 {
        println("FAIL nerf_evaluate_point_mock center rgb");
        process_exit(1);
    }

    let p_outside: Vec3 = vec3_new(2.0, 2.0, 2.0);
    let eval_out: NeRFEvaluation = nerf_evaluate_point_mock(&p_outside, &d_up, &cfg1);
    if (eval_out).density != 0.0 {
        println("FAIL nerf_evaluate_point_mock outside density");
        process_exit(1);
    }

    println("prod_g4_nerf_volumetric: PASSED");
    process_exit(0);
}
