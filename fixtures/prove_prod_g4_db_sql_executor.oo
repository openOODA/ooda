// # Product prove std/database/sql_executor.oo
//
// Logline: Fail-closed verification that SQL execution engine, catalog tables, and row filtering are deterministic.
//
// Setup: Isolated emit-c. Imports std/database/sql_executor.oo.
//
// Beats:
//   1. Initialize database catalog and register table schema.
//   2. Query catalog table count deterministically.
//   3. Match row filter predicates against candidate values.
//   4. Execute physical plans and verify query result records.
//   5. Print prod_g4_db_sql_executor: PASSED and exit 0.

import "std/database/sql_executor.oo";

pub fn main() {
    let cat0: DbCatalog = db_catalog_create();
    if cat0.table_count != 0 {
        println("FAIL db_catalog_create");
        process_exit(1);
    }

    let cat1: DbCatalog = db_catalog_add_table(cat0, "users");
    let cat2: DbCatalog = db_catalog_add_table(cat1, "orders");

    if cat2.table_count != 2 {
        println("FAIL db_catalog_add_table");
        process_exit(1);
    }

    let tbl: DbTable = db_table_create("users");
    if tbl.table_name != "users" || tbl.row_count != 0 || tbl.next_row_id != 1 {
        println("FAIL db_table_create");
        process_exit(1);
    }

    let m1: Bool = sql_row_matches_filters("alice", "alice", "=");
    let m2: Bool = sql_row_matches_filters("alice", "bob", "=");
    let m3: Bool = sql_row_matches_filters("alice", "bob", "!=");

    if m1 != true || m2 != false || m3 != true {
        println("FAIL sql_row_matches_filters");
        process_exit(1);
    }

    let res_sel: DbQueryResult = sql_execute_plan(cat2, 1);
    if res_sel.success != true || res_sel.rows_affected != 1 {
        println("FAIL sql_execute_plan select");
        process_exit(1);
    }

    let res_ins: DbQueryResult = sql_execute_plan(cat2, 2);
    if res_ins.success != true || res_ins.rows_affected != 1 {
        println("FAIL sql_execute_plan insert");
        process_exit(1);
    }

    println("prod_g4_db_sql_executor: PASSED");
    process_exit(0);
}
