// # Product prove std/iot_scada/safety_interlock_matrix.oo
//
// Logline: Fail-closed emit+gcc+run asserts sis_vote_1oo2 is deterministic.
//
// Setup: Isolated emit-c. Imports std/iot_scada/safety_interlock_matrix.oo.
//
// Beats:
//   1. Call sis_vote_1oo2 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_safety_interlock_matrix: PASSED only if they match.

import "std/iot_scada/safety_interlock_matrix.oo";

pub fn main() {
    let safety_interlock_matrix_mark: Int = 0;
    if safety_interlock_matrix_mark != 0 {
        process_exit(1);
    }
    let a: SisVotingResult = sis_vote_1oo2(true, true);
    let b: SisVotingResult = sis_vote_1oo2(true, true);
    if (a).is_trip != (b).is_trip {
        println("FAIL sis_vote_1oo2");
        process_exit(1);
    }
    println("prod_safety_interlock_matrix: PASSED");
}
