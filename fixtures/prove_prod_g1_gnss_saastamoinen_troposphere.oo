// # Product prove std/satellite_dvb/gnss_saastamoinen_troposphere.oo
//
// Logline: Fail-closed emit+gcc+run asserts troposphere_weather_standard_atmosphere is deterministic.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/gnss_saastamoinen_troposphere.oo.
//
// Beats:
//   1. Call troposphere_weather_standard_atmosphere twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gnss_saastamoinen_troposphere: PASSED only if they match.

import "std/satellite_dvb/gnss_saastamoinen_troposphere.oo";

pub fn main() {
    let a: TroposphereWeather = troposphere_weather_standard_atmosphere(0.0, 0.0);
    let b: TroposphereWeather = troposphere_weather_standard_atmosphere(0.0, 0.0);
    if a.surface_pressure_hpa != b.surface_pressure_hpa {
        println("FAIL troposphere_weather_standard_atmosphere");
        process_exit(1);
    }
    println("prod_gnss_saastamoinen_troposphere: PASSED");
}
