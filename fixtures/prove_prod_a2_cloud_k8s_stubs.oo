// # Product prove std/cloud_k8s/cloud_k8s_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts cloud_k8s_fail_closed is deterministic.
//
// Setup: Isolated emit-c. Imports std/cloud_k8s/cloud_k8s_stubs.oo.
//
// Beats:
//   1. Call cloud_k8s_fail_closed twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_cloud_k8s_stubs: PASSED only if they match.

import "std/cloud_k8s/cloud_k8s_stubs.oo";

pub fn main() {
    let cloud_k8s_stubs_mark: Int = 0;
    if cloud_k8s_stubs_mark != 0 {
        process_exit(1);
    }
    let a: Bool = cloud_k8s_fail_closed("x", 0);
    let b: Bool = cloud_k8s_fail_closed("x", 0);
    if a != b {
        println("FAIL cloud_k8s_fail_closed");
        process_exit(1);
    }
    println("prod_cloud_k8s_stubs: PASSED");
}
