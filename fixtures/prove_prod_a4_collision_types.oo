// # Product prove std/physics/collision_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts collider_aabb_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics/collision_types.oo.
//
// Beats:
//   1. Call collider_aabb_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_collision_types: PASSED only if they match.

import "std/physics/collision_types.oo";

pub fn main() {
    let collision_types_mark: Int = 0;
    if collision_types_mark != 0 {
        process_exit(1);
    }
    let a: ColliderAabb = collider_aabb_new(0, 0);
    let b: ColliderAabb = collider_aabb_new(0, 0);
    if (a).min_x != (b).min_x {
        println("FAIL collider_aabb_new");
        process_exit(1);
    }
    println("prod_collision_types: PASSED");
}
