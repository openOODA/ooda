// # Product prove std/telecom_6g/gfdm_generalized_frequency_div.oo
//
// Logline: Fail-closed emit+gcc+run asserts gfdm_rrc_frequency_response is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/gfdm_generalized_frequency_div.oo.
//
// Beats:
//   1. Call gfdm_rrc_frequency_response twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_gfdm_generalized_frequency_div: PASSED only if they match.

import "std/telecom_6g/gfdm_generalized_frequency_div.oo";

pub fn main() {
    let gfdm_generalized_frequency_div_mark: Int = 0;
    if gfdm_generalized_frequency_div_mark != 0 {
        process_exit(1);
    }
    let a: Float = gfdm_rrc_frequency_response(0.0, 0.0);
    let b: Float = gfdm_rrc_frequency_response(0.0, 0.0);
    if a != b {
        println("FAIL gfdm_rrc_frequency_response");
        process_exit(1);
    }
    println("prod_g2_gfdm_generalized_frequency_div: PASSED");
}
