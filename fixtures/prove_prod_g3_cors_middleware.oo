// # Product prove std/web_protocols/cors_middleware.oo
//
// Logline: Fail-closed emit+gcc+run asserts cors_policy_permissive is deterministic.
//
// Setup: Isolated emit-c. Imports std/web_protocols/cors_middleware.oo.
//
// Beats:
//   1. Call cors_policy_permissive twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_cors_middleware: PASSED only if they match.

import "std/web_protocols/cors_middleware.oo";

pub fn main() {
    let cors_middleware_mark: Int = 0;
    if cors_middleware_mark != 0 {
        process_exit(1);
    }
    let a: CorsPolicy = cors_policy_permissive();
    let b: CorsPolicy = cors_policy_permissive();
    if (a).o0 != (b).o0 {
        println("FAIL cors_policy_permissive");
        process_exit(1);
    }
    println("prod_cors_middleware: PASSED");
}
