// # Product prove std/wasm_gc/wasm_gc_finalizer_registry.oo
//
// Logline: Fail-closed emit+gcc+run asserts finalizer_registry_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/wasm_gc_finalizer_registry.oo.
//
// Beats:
//   1. Call finalizer_registry_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wasm_gc_finalizer_registry: PASSED only if they match.

import "std/wasm_gc/wasm_gc_finalizer_registry.oo";

pub fn main() {
    let wasm_gc_finalizer_registry_mark: Int = 0;
    if wasm_gc_finalizer_registry_mark != 0 {
        process_exit(1);
    }
    let wasm_gc_finalizer_registry_a = finalizer_registry_new();
    let wasm_gc_finalizer_registry_b = finalizer_registry_new();
    if (wasm_gc_finalizer_registry_a).entry_count != (wasm_gc_finalizer_registry_b).entry_count {
        println("FAIL finalizer_registry_new");
        process_exit(1);
    }
    println("prod_wasm_gc_finalizer_registry: PASSED");
}
