// # Product prove std/bio_advanced/sequence_burrows_wheeler.oo
//
// Logline: Fail-closed emit+gcc+run asserts bwt_char_count is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/sequence_burrows_wheeler.oo.
//
// Beats:
//   1. Call bwt_char_count twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sequence_burrows_wheeler: PASSED only if they match.

import "std/bio_advanced/sequence_burrows_wheeler.oo";

pub fn main() {
    let sequence_burrows_wheeler_mark: Int = 0;
    if sequence_burrows_wheeler_mark != 0 {
        process_exit(1);
    }
    let a: Int = bwt_char_count("x", "x");
    let b: Int = bwt_char_count("x", "x");
    if a != b {
        println("FAIL bwt_char_count");
        process_exit(1);
    }
    println("prod_sequence_burrows_wheeler: PASSED");
}
