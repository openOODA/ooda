// # Product prove std/db_columnar/columnar_run_length.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_columnar/columnar_run_length.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_columnar/columnar_run_length.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_columnar_run_length: PASSED only if they match.

import "std/db_columnar/columnar_run_length.oo";

pub fn main() {
    let columnar_run_length_a = columnar_rle_encode(list_new());
    let columnar_run_length_b = columnar_rle_encode(list_new());
    let columnar_run_length_va = columnar_rle_get_at(columnar_run_length_a, 0);
    let columnar_run_length_vb = columnar_rle_get_at(columnar_run_length_b, 0);
    if columnar_run_length_va != columnar_run_length_vb {
        println("FAIL columnar_run_length");
        process_exit(1);
    }
    println("prod_ap_columnar_run_length: PASSED");
}
