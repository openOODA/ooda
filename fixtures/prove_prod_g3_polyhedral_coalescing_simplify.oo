// # Product prove std/compilers_polyhedral/polyhedral_coalescing_simplify.oo
//
// Logline: Fail-closed emit+gcc+run asserts can_coalesce_intervals is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/polyhedral_coalescing_simplify.oo.
//
// Beats:
//   1. Call can_coalesce_intervals twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_polyhedral_coalescing_simplify: PASSED only if they match.

import "std/compilers_polyhedral/polyhedral_coalescing_simplify.oo";

pub fn main() {
    let polyhedral_coalescing_simplify_mark: Int = 0;
    if polyhedral_coalescing_simplify_mark != 0 {
        process_exit(1);
    }
    let a: Int = can_coalesce_intervals(0, 0, 0, 0);
    let b: Int = can_coalesce_intervals(0, 0, 0, 0);
    if a != b {
        println("FAIL can_coalesce_intervals");
        process_exit(1);
    }
    println("prod_polyhedral_coalescing_simplify: PASSED");
}
