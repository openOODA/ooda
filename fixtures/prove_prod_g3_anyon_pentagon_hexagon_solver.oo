// # Product prove std/quantum_topological/anyon_pentagon_hexagon_solver.oo
//
// Logline: Fail-closed emit+gcc+run asserts pentagon_residual_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_topological/anyon_pentagon_hexagon_solver.oo.
//
// Beats:
//   1. Call pentagon_residual_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_anyon_pentagon_hexagon_solver: PASSED only if they match.

import "std/quantum_topological/anyon_pentagon_hexagon_solver.oo";

pub fn main() {
    let anyon_pentagon_hexagon_solver_mark: Int = 0;
    if anyon_pentagon_hexagon_solver_mark != 0 {
        process_exit(1);
    }
    let a: PentagonResidual = pentagon_residual_new(0.0, 0);
    let b: PentagonResidual = pentagon_residual_new(0.0, 0);
    if (a).is_satisfied != (b).is_satisfied {
        println("FAIL pentagon_residual_new");
        process_exit(1);
    }
    println("prod_anyon_pentagon_hexagon_solver: PASSED");
}
