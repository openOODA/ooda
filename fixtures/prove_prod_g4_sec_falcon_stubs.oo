// # Product prove std/sec/crypto/falcon_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/falcon_stubs.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/falcon_stubs.oo.
//
// Beats:
//   1. Call real functions twice with concrete test inputs.
//   2. Exit 1 if return values differ.
//   3. Print prod_g4_sec_falcon_stubs: PASSED and exit 0 only on match.

import "std/sec/crypto/falcon_stubs.oo";

pub fn main() {
    let probe_a: Int = falcon_stubs_probe();
    let probe_b: Int = falcon_stubs_probe();
    if probe_a != probe_b {
        println("FAIL falcon_stubs probe");
        process_exit(1);
    }

    let p_a: FalconPolynomial = falcon_polynomial_empty();
    let p_b: FalconPolynomial = falcon_polynomial_empty();
    if (p_a).degree != (p_b).degree {
        println("FAIL falcon polynomial empty");
        process_exit(1);
    }

    let bv_a: FalconBatchVerifier = falcon_batch_verifier_init("bv_1", 512);
    let bv_b: FalconBatchVerifier = falcon_batch_verifier_init("bv_1", 512);
    if (bv_a).degree != (bv_b).degree {
        println("FAIL falcon batch verifier init");
        process_exit(1);
    }

    println("prod_g4_sec_falcon_stubs: PASSED");
    process_exit(0);
}
