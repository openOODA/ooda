// # Product prove std/astro_advanced/free_return_trajectory.oo
//
// Logline: Fail-closed emit+gcc+run asserts free_return_tof_hours is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/free_return_trajectory.oo.
//
// Beats:
//   1. Call free_return_tof_hours twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_free_return_trajectory: PASSED only if they match.

import "std/astro_advanced/free_return_trajectory.oo";

pub fn main() {
    let a = free_return_tof_hours();
    let b = free_return_tof_hours();
    if a != b {
        println("FAIL free_return_tof_hours");
        process_exit(1);
    }
    println("prod_free_return_trajectory: PASSED");
}
