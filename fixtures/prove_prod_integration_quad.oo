// # Product prove std/math/integration_quad.oo
//
// Logline: Fail-closed emit+gcc+run asserts quad_gauss_legendre_2pt is deterministic.
//
// Setup: Isolated emit-c. Imports std/math/integration_quad.oo.
//
// Beats:
//   1. Call quad_gauss_legendre_2pt twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_integration_quad: PASSED only if they match.

import "std/math/integration_quad.oo";

pub fn main() {
    let a = quad_gauss_legendre_2pt(0.0, 0.0, 0.0, 0.0);
    let b = quad_gauss_legendre_2pt(0.0, 0.0, 0.0, 0.0);
    if a != b {
        println("FAIL quad_gauss_legendre_2pt");
        process_exit(1);
    }
    println("prod_integration_quad: PASSED");
}
