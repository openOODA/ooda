// M0 CHS: List + string char walk (interpreter host surface).
pub fn main() {
    let mut xs = list_new();
    xs = list_push(xs, 10);
    xs = list_push(xs, 20);
    println(list_len(xs));
    println(list_get(xs, 0));
    println(list_get(xs, 1));

    let s = "fn";
    println(chars_len(s));
    println(char_at(s, 0));
    println(char_at(s, 1));
    println(str_slice(s, 0, 2));
    println(char_is_alpha(char_at(s, 0)));
}
