// # Product hash XXH64 hex prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/hash/xxhash.oo.
//
// Setup: Product std/hash/xxhash.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. Empty seed 0 is ef46db3751d8e999.
//   2. Hex length is 16.
//   9. Exit 1 before PASSED on a miss.

import "std/hash/xxhash.oo";

pub fn main() {
    let h: String = xxhash64_hex("", 0);
    println(h);
    if h != "ef46db3751d8e999" {
        println("FAIL xxh64 empty");
        process_exit(1);
    }
    let n: Int = chars_len(h);
    if n != 16 {
        println("FAIL xxh64 len");
        process_exit(1);
    }
    println("prod_xxh64: PASSED");
}
