// # Product prove std/robotics_auv/internal_moving_mass.oo
//
// Logline: Fail-closed emit+gcc+run asserts moving_mass_params_default_glider holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/internal_moving_mass.oo.
//
// Beats:
//   1. Call moving_mass_params_default_glider using the internal_moving_mass ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_internal_moving_mass: PASSED only if asserts hold.

import "std/robotics_auv/internal_moving_mass.oo";

pub fn main() {
    let obj = moving_mass_params_default_glider();
    let internal_moving_mass_a = obj.slider_mass_kg;
    if internal_moving_mass_a != 10.0 {
        println("FAIL moving_mass_params_default_glider");
        process_exit(1);
    }
    println("prod_internal_moving_mass: PASSED");
}
