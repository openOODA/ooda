// # Product prove std/sec/sys/audit_const.oo
//
// Logline: Fail-closed emit+gcc+run asserts audit_type_syscall is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/sys/audit_const.oo.
//
// Beats:
//   1. Call audit_type_syscall twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_audit_const: PASSED only if they match.

import "std/sec/sys/audit_const.oo";

pub fn main() {
    let a = audit_type_syscall();
    let b = audit_type_syscall();
    if a != b {
        println("FAIL audit_type_syscall");
        process_exit(1);
    }
    println("prod_audit_const: PASSED");
}
