// # Product prove std/robot/ros.oo
//
// Logline: Fail-closed emit+gcc+run asserts shim_marker_ros_header holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/robot/ros.oo.
//
// Beats:
//   1. Call shim_marker_ros_header using the ros ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_ros: PASSED only if asserts hold.

import "std/robot/ros.oo";

pub fn main() {
    let obj = shim_marker_ros_header();
    let ros_a = obj.seq;
    let ros_b = obj.seq;
    if ros_a != ros_b {
        println("FAIL shim_marker_ros_header");
        process_exit(1);
    }
    println("prod_ros: PASSED");
}
