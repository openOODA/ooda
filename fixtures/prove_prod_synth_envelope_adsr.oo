// # Product prove std/media_dsp/synth_envelope_adsr.oo
//
// Logline: Fail-closed emit+gcc+run asserts adsr_stage_idle real value.
//
// Setup: Isolated emit-c. Imports std/media_dsp/synth_envelope_adsr.oo.
//
// Beats:
//   1. Call adsr_stage_idle with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_synth_envelope_adsr: PASSED only if the assert holds.

import "std/media_dsp/synth_envelope_adsr.oo";

pub fn main() {
    let synth_envelope_adsr_mark: Int = 0;
    if synth_envelope_adsr_mark != 0 {
        process_exit(1);
    }
    let synth_envelope_adsr_n: Int = adsr_stage_idle();
    if synth_envelope_adsr_n != 0 {
        println("FAIL adsr_stage_idle");
        process_exit(1);
    }
    println("prod_synth_envelope_adsr: PASSED");
}
