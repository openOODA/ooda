// # Product prove std/genomics_advanced/microbial_pan_genome_roary.oo
//
// Logline: Fail-closed emit+gcc+run asserts microbial_pan_genome_roary_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/microbial_pan_genome_roary.oo.
//
// Beats:
//   1. Call microbial_pan_genome_roary_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_microbial_pan_genome_roary: PASSED only if they match.

import "std/genomics_advanced/microbial_pan_genome_roary.oo";

pub fn main() {
    let a = microbial_pan_genome_roary_probe();
    let b = microbial_pan_genome_roary_probe();
    if a != b {
        println("FAIL microbial_pan_genome_roary_probe");
        process_exit(1);
    }
    println("prod_microbial_pan_genome_roary: PASSED");
}
