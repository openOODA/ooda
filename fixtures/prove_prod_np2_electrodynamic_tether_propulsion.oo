// # Product prove std/space_propulsion/electrodynamic_tether_propulsion.oo
//
// Logline: Fail-closed emit+gcc+run asserts edt_compute_performance is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/electrodynamic_tether_propulsion.oo.
//
// Beats:
//   1. Call edt_compute_performance twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_electrodynamic_tether_propulsion: PASSED only if they match.

import "std/space_propulsion/electrodynamic_tether_propulsion.oo";

pub fn main() {
    let electrodynamic_tether_propulsion_mark: Int = 0;
    if electrodynamic_tether_propulsion_mark != 0 {
        process_exit(1);
    }
    let electrodynamic_tether_propulsion_a = edt_compute_performance(edt_spec_default_leo_deorbit(), 1.0);
    let electrodynamic_tether_propulsion_b = edt_compute_performance(edt_spec_default_leo_deorbit(), 1.0);
    if (electrodynamic_tether_propulsion_a).induced_motional_emf_v != (electrodynamic_tether_propulsion_b).induced_motional_emf_v {
        println("FAIL edt_compute_performance");
        process_exit(1);
    }
    println("prod_electrodynamic_tether_propulsion: PASSED");
}
