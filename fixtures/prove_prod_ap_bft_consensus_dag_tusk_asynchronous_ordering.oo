import "std/bft_consensus/dag_tusk_asynchronous_ordering.oo";

pub fn main() {
    let dag_tusk_asynchronous_ordering_a = tusk_wave_to_leader_round(0);
    let dag_tusk_asynchronous_ordering_b = tusk_wave_to_leader_round(0);
    if dag_tusk_asynchronous_ordering_a != dag_tusk_asynchronous_ordering_b {
        println("FAIL dag_tusk_asynchronous_ordering");
        process_exit(1);
    }
    println("prod_ap_dag_tusk_asynchronous_ordering: PASSED");
