// # Product prove std/game_engine/collision_aabb.oo
//
// Logline: Fail-closed emit+gcc+run asserts aabb2d_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/game_engine/collision_aabb.oo.
//
// Beats:
//   1. Call aabb2d_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_collision_aabb: PASSED only if they match.

import "std/game_engine/collision_aabb.oo";

pub fn main() {
    let collision_aabb_mark: Int = 0;
    if collision_aabb_mark != 0 {
        process_exit(1);
    }
    let a: AABB2D = aabb2d_new(0.0, 0.0, 0.0, 0.0);
    let b: AABB2D = aabb2d_new(0.0, 0.0, 0.0, 0.0);
    if (a).min_x != (b).min_x {
        println("FAIL aabb2d_new");
        process_exit(1);
    }
    println("prod_g2_collision_aabb: PASSED");
}
