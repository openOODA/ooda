// # Product prove std/iot_scada/opcua_variant_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/iot_scada/opcua_variant_types.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/iot_scada/opcua_variant_types.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_opcua_variant_types: PASSED only if they match.

import "std/iot_scada/opcua_variant_types.oo";

pub fn main() {
    let opcua_variant_types_a = opcua_variant_new(0, 0);
    let opcua_variant_types_b = opcua_variant_new(0, 0);
    let opcua_variant_types_va = opcua_variant_int_val(opcua_variant_types_a);
    let opcua_variant_types_vb = opcua_variant_int_val(opcua_variant_types_b);
    if opcua_variant_types_va != opcua_variant_types_vb {
        println("FAIL opcua_variant_types");
        process_exit(1);
    }
    println("prod_ap_opcua_variant_types: PASSED");
}
