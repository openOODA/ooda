// # Product prove &List[Int] param is OoIList not List*
//
// Logline: Fail-closed emit+gcc+run asserts prompt_max_confidence on a ref list.
//
// Setup: Isolated emit-c. Imports std/sec/ai/prompt_filter_policy.oo.
//
// Beats:
//   1. Build List[Int] 1, 3, 2 and call prompt_max_confidence.
//   2. Exit 1 if the max is not 3.
//   3. Print prod_ref_list: PASSED only if the assert holds.

import "std/sec/ai/prompt_filter_policy.oo";

pub fn main() {
    let mut xs: List[Int] = list_new();
    xs = list_push(xs, 1);
    xs = list_push(xs, 3);
    xs = list_push(xs, 2);
    let m: Int = prompt_max_confidence(&xs);
    if m != 3 {
        println("FAIL prompt_max_confidence");
        process_exit(1);
    }
    println("prod_ref_list: PASSED");
}
