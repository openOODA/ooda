// # Product prove std/bio_advanced/rna_pseudoknot_detector.oo
//
// Logline: Fail-closed emit+gcc+run asserts rna_pairs_cross is deterministic.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/rna_pseudoknot_detector.oo.
//
// Beats:
//   1. Call rna_pairs_cross twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rna_pseudoknot_detector: PASSED only if they match.

import "std/bio_advanced/rna_pseudoknot_detector.oo";

pub fn main() {
    let rna_pseudoknot_detector_mark: Int = 0;
    if rna_pseudoknot_detector_mark != 0 {
        process_exit(1);
    }
    let a: Bool = rna_pairs_cross(0, 0, 0, 0);
    let b: Bool = rna_pairs_cross(0, 0, 0, 0);
    if a != b {
        println("FAIL rna_pairs_cross");
        process_exit(1);
    }
    println("prod_rna_pseudoknot_detector: PASSED");
}
