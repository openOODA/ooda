// # Refuse a secret eprintln argument
//
// Logline: eprintln refuses a bare tagged IDENT the same way println does.
//
// Beats:
//   1. Tag tok at line start.
//   2. Pass that IDENT to eprintln.
//   3. Expect the sink to refuse.

// SECRET: tok
// Phase 2: eprintln sink refuses SECRET bare IDENT
pub fn main() {
    let tok = "secret-token";
    eprintln(tok);
}
