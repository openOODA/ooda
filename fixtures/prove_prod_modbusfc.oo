// # Product iot_scada modbus function codes prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/iot_scada/modbus_function_codes.oo.
//
// Setup: Product std/iot_scada/modbus_function_codes.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. read coils 1, holding 3, write multi regs 16.
//   9. Exit 1 before PASSED on a miss.

import "std/iot_scada/modbus_function_codes.oo";

pub fn main() {
    let a: Int = modbus_fc_read_coils();
    if a != 1 {
        println("FAIL modbus coils");
        process_exit(1);
    }
    let b: Int = modbus_fc_read_holding_registers();
    if b != 3 {
        println("FAIL modbus hold");
        process_exit(1);
    }
    let c: Int = modbus_fc_write_multiple_registers();
    if c != 16 {
        println("FAIL modbus wmr");
        process_exit(1);
    }
    println("prod_modbusfc: PASSED");
}
