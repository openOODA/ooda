// # Bitcask record adversarial suite
//
// Logline: Packs then parses a CRC32 record and tracks the latest keydir location.
//
// Setup: Pure. Imports bitcask_storage.oo. Run from ooda/.
//
// Beats:
//   1. Serialize timestamp, key, and value.
//   2. Parse and recover sizes.
//   3. Put twice into the keydir and keep the latest offset.
//   4. Reject a CRC mismatch.

import "std/database/bitcask_storage.oo";

pub fn main() {
    let mut k: List[Int] = list_new();
    k = list_push(k, 97);
    let mut v: List[Int] = list_new();
    v = list_push(v, 49);
    v = list_push(v, 50);
    let e: ByteOut = bitcask_storage_pack(99, k, v);
    if e.flag < 1 {
        println("FAIL pack " + e.err);
        process_exit(1);
    }
    let p: BitRec = bitcask_storage_parse(e.bytes);
    if p.flag < 1 {
        println("FAIL parse " + p.err);
        process_exit(1);
    }
    if p.ts != 99 {
        println("FAIL ts");
        process_exit(1);
    }
    if p.ksz != 1 {
        println("FAIL ksz");
        process_exit(1);
    }
    if p.vsz != 2 {
        println("FAIL vsz");
        process_exit(1);
    }
    println("serialize then parse CRC32+timestamp+sizes+key+value");
    let kd0: Keydir = bitcask_storage_keydir_new();
    let kd1: Keydir = bitcask_storage_put(kd0.keys, kd0.ts, kd0.off, kd0.sz, kd0.n, "a", 1, 10, 8);
    let kd2: Keydir = bitcask_storage_put(kd1.keys, kd1.ts, kd1.off, kd1.sz, kd1.n, "a", 2, 20, 8);
    let got: Result[Int, String] = bitcask_storage_get(kd2.keys, kd2.off, kd2.n, "a");
    match got {
        Ok(off) => {
            if off != 20 {
                println("FAIL latest");
                process_exit(1);
            }
        },
        Err(e2) => {
            println("FAIL keydir " + e2);
            process_exit(1);
        }
    }
    println("keydir latest location");
    let mut tam: List[Int] = list_new();
    let mut i: Int = 0;
    while i < list_len(e.bytes) {
        tam = list_push(tam, list_get(e.bytes, i));
        i = i + 1;
    }
    let last: Int = list_len(tam) - 1;
    let mut badb: List[Int] = list_new();
    i = 0;
    while i < list_len(tam) {
        if i == last {
            let x: Int = list_get(tam, i);
            badb = list_push(badb, (x | 1) - (x & 1));
        } else {
            badb = list_push(badb, list_get(tam, i));
        }
        i = i + 1;
    }
    let bad: BitRec = bitcask_storage_parse(badb);
    if bad.flag > 0 {
        println("FAIL crc ok");
        process_exit(1);
    }
    println("CRC fail Err");
    println("SUITE PASSED");
    println("test_bitcask_storage: PASSED");
}
