// # Product prove std/physics_advanced/compressible_isentropic_flow.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/physics_advanced/compressible_isentropic_flow.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/compressible_isentropic_flow.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_compressible_isentropic_flow: PASSED only if they match.

import "std/physics_advanced/compressible_isentropic_flow.oo";

pub fn main() {
    let compressible_isentropic_flow_a = isentropic_temperature_ratio(0.0, 0.0);
    let compressible_isentropic_flow_b = isentropic_temperature_ratio(0.0, 0.0);
    if compressible_isentropic_flow_a != compressible_isentropic_flow_b {
        println("FAIL compressible_isentropic_flow");
        process_exit(1);
    }
    println("prod_ap_compressible_isentropic_flow: PASSED");
}
