// # Product prove std/physics/rigid.oo
//
// Logline: Fail-closed emit+gcc+run asserts shim_marker_vec3_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics/rigid.oo.
//
// Beats:
//   1. Call shim_marker_vec3_new twice.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rigid: PASSED only if they match.

import "std/physics/rigid.oo";

pub fn main() {
    let rigid_mark: Int = 0;
    if rigid_mark != 0 {
        process_exit(1);
    }
    let a: Vec3 = shim_marker_vec3_new();
    let b: Vec3 = shim_marker_vec3_new();
    if (a).x != (b).x {
        println("FAIL shim_marker_vec3_new");
        process_exit(1);
    }
    println("prod_rigid: PASSED");
}
