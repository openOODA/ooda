// # Product pairing_heap prove
//
// Logline: Fail-closed emit+gcc+run of shipped pairing_heap_push/len.
//
// Setup: Product std/collections/pairing_heap.oo. Push 7 then 3.
//
// Beats:
//   1. After two pushes, len 2 and root_val 3.
//   2. Exit 1 before PASSED on a miss.

import "std/collections/pairing_heap.oo";

pub fn main() {
    let mut h: PairingHeap = pairing_heap_new();
    h = pairing_heap_push(h, 7);
    h = pairing_heap_push(h, 3);
    let n: Int = pairing_heap_len(h);
    if n != 2 {
        println("FAIL pairheap len");
        process_exit(1);
    }
    let r: Int = h.root_val;
    if r != 3 {
        println("FAIL pairheap root");
        process_exit(1);
    }
    println("prod_pairheap: PASSED");
}
