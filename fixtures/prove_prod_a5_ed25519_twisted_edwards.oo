// # Product prove std/zk_rollup/ed25519_twisted_edwards.oo
//
// Logline: Fail-closed emit+gcc+run asserts edwards_params_ed25519 is deterministic.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/ed25519_twisted_edwards.oo.
//
// Beats:
//   1. Call edwards_params_ed25519 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ed25519_twisted_edwards: PASSED only if they match.

import "std/zk_rollup/ed25519_twisted_edwards.oo";

pub fn main() {
    let ed25519_twisted_edwards_mark: Int = 0;
    if ed25519_twisted_edwards_mark != 0 {
        process_exit(1);
    }
    let a: EdwardsCurveParams = edwards_params_ed25519();
    let b: EdwardsCurveParams = edwards_params_ed25519();
    if (a).d_coeff != (b).d_coeff {
        println("FAIL edwards_params_ed25519");
        process_exit(1);
    }
    println("prod_ed25519_twisted_edwards: PASSED");
}
