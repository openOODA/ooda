// # Product prove std/security_defense/code_integrity_hmac_checker.oo
//
// Logline: Fail-closed emit+gcc+run asserts simple_hmac_compute is a real value.
//
// Setup: Isolated emit-c. Imports std/security_defense/code_integrity_hmac_checker.oo. Avoids String != and Result unwrap.
//
// Beats:
//   1. Call simple_hmac_compute twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_gr_code_integrity_hmac_checker: PASSED only if they match.

import "std/security_defense/code_integrity_hmac_checker.oo";

pub fn main() {
    let g0_a = simple_hmac_compute(0, list_new(), 0);
    let g0_b = simple_hmac_compute(0, list_new(), 0);
    if g0_a != g0_b {
        println("FAIL simple_hmac_compute");
        process_exit(1);
    }
    println("prod_gr_code_integrity_hmac_checker: PASSED");
}
