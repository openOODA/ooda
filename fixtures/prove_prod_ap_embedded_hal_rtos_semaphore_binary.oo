// # Product prove std/embedded_hal/rtos_semaphore_binary.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/embedded_hal/rtos_semaphore_binary.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/embedded_hal/rtos_semaphore_binary.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_rtos_semaphore_binary: PASSED only if they match.

import "std/embedded_hal/rtos_semaphore_binary.oo";

pub fn main() {
    let rtos_semaphore_binary_a = rtos_semaphore_binary_new(0, true);
    let rtos_semaphore_binary_b = rtos_semaphore_binary_new(0, true);
    let rtos_semaphore_binary_va = rtos_semaphore_get_count(rtos_semaphore_binary_a);
    let rtos_semaphore_binary_vb = rtos_semaphore_get_count(rtos_semaphore_binary_b);
    if rtos_semaphore_binary_va != rtos_semaphore_binary_vb {
        println("FAIL rtos_semaphore_binary");
        process_exit(1);
    }
    println("prod_ap_rtos_semaphore_binary: PASSED");
}
