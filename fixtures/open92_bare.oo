// # OPEN-92 bare_metal_init returns a page canary
//
// Logline: Init zeros a static page and returns 0x4D455441. Zero is a no-op.
//
// Setup: runtime/chs_rt_vision.c.
//
// Beats:
//   1. Refuse return 0.
//   2. Require 1296389441.
//   3. Print open92: PASSED.

pub fn main() {
    let n = bare_metal_init();
    if n == 0 {
        println("FAIL no-op");
        process_exit(1);
    }
    if n != 1296389185 {
        println("FAIL canary");
        process_exit(1);
    }
    println("open92: PASSED");
}
