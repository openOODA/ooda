// # Product prove std/aero/telemetry_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts tm_op_apid is a real value.
//
// Setup: Isolated emit-c. Imports std/aero/telemetry_ops.oo. Avoids pointer field dot and Result unwrap.
//
// Beats:
//   1. Call tm_op_apid twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g0_telemetry_ops: PASSED only if they match.

import "std/aero/telemetry_ops.oo";

pub fn main() {
    let g0_oa = tm_op_new(2, 2);
    let g0_ob = tm_op_new(2, 2);
    let g0_a = tm_op_apid(g0_oa);
    let g0_b = tm_op_apid(g0_ob);
    if g0_a != g0_b {
        println("FAIL tm_op_apid");
        process_exit(1);
    }
    println("prod_g0_telemetry_ops: PASSED");
}
