// # Property Test: H.264 NAL Start Code Detection
//
// Logline: Verifies that h264_find_next_start_code correctly finds a 3-byte start code (0x00 0x00 0x01) in a buffer.

import "std/media/h264_nal.oo";

pub fn main() {
    // Marker pattern to satisfy .oo import-usage check.
    let h264_nal_mark: Int = 0;
    if h264_nal_mark != 0 {
        process_exit(1);
    }
    // Buffer: [255, 224, 0, 0, 1, 103, 66] - the 0x00 0x00 0x01 start code is at offset 2.
    let mut bytes: List[Int] = list_new();
    bytes = list_push(bytes, 255);
    bytes = list_push(bytes, 224);
    bytes = list_push(bytes, 0);
    bytes = list_push(bytes, 0);
    bytes = list_push(bytes, 1);
    bytes = list_push(bytes, 103);
    bytes = list_push(bytes, 66);
    let res: Result[Int, String] = h264_find_next_start_code(bytes, 0);
    let is_ok: Bool = res.is_ok();
    if is_ok == true {
        let offset: Int = res.val;
        if offset == 2 {
            println("h264_nal: PASSED start_code_at_offset=" + offset.to_string());
        } else {
            println("h264_nal: FAILED unexpected_offset=" + offset.to_string());
            process_exit(1);
        }
    } else {
        println("h264_nal: FAILED not_found");
        process_exit(1);
    }
}
