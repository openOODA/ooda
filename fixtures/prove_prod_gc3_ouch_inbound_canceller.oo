// # Product prove std/fintech_l3_book/ouch_inbound_canceller.oo
//
// Logline: Fail-closed emit+gcc+run asserts mass_cancel_request_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/fintech_l3_book/ouch_inbound_canceller.oo.
//
// Beats:
//   1. Call mass_cancel_request_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ouch_inbound_canceller: PASSED only if they match.

import "std/fintech_l3_book/ouch_inbound_canceller.oo";

pub fn main() {
    let ouch_inbound_canceller_mark: Int = 0;
    if ouch_inbound_canceller_mark != 0 {
        process_exit(1);
    }
    let ouch_inbound_canceller_a = mass_cancel_request_new("x", "x", "x", "x", 1);
    let ouch_inbound_canceller_b = mass_cancel_request_new("x", "x", "x", "x", 1);
    if (ouch_inbound_canceller_a).timestamp_ns != (ouch_inbound_canceller_b).timestamp_ns {
        println("FAIL mass_cancel_request_new");
        process_exit(1);
    }
    println("prod_ouch_inbound_canceller: PASSED");
}
