// # Product prove std/graph_gnn/kg_hyperbolic_embedding_poincare.oo
//
// Logline: Fail-closed emit+gcc+run asserts poincare_arcosh is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_gnn/kg_hyperbolic_embedding_poincare.oo.
//
// Beats:
//   1. Call poincare_arcosh twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_poincare_arcosh: PASSED only if they match.

import "std/graph_gnn/kg_hyperbolic_embedding_poincare.oo";

pub fn main() {
    let kg_hyperbolic_embedding_poincare_mark: Int = 0;
    if kg_hyperbolic_embedding_poincare_mark != 0 { process_exit(1); }
    let a: Float = poincare_arcosh(2.0);
    let b: Float = poincare_arcosh(2.0);
    if a != b {
        println("FAIL poincare_arcosh");
        process_exit(1);
    }
    println("prod_poincare_arcosh: PASSED");
}
