// # Product prove std/sync/barrier.oo
//
// Logline: Fail-closed emit+gcc+run asserts barrier_threshold is deterministic.
//
// Setup: Isolated emit-c. Imports std/sync/barrier.oo.
//
// Beats:
//   1. Call barrier_threshold twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_barrier: PASSED only if they match.

import "std/sync/barrier.oo";

pub fn main() {
    let obj = barrier_new(0);
    let a = barrier_threshold(obj);
    let b = barrier_threshold(obj);
    if a != b {
        println("FAIL barrier_threshold");
        process_exit(1);
    }
    println("prod_barrier: PASSED");
}
