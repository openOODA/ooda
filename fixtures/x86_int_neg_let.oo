// # emit-x86 same-fn negative const-int let
//
// Logline: Bind n to -7 and print n so emit-x86 can lower a lone signed int ident.
//
// Setup: Product path is oodac emit-x86 on this file, then as and ld. No ALU negate.
//
// Beats:
//   1. Declare main.
//   2. Bind n to unary-minus 7.
//   3. Print n.
//
// residual: println(-n) of an ident stays leftover. ALU stays later.

pub fn main() {
    let n = -7;
    println(n);
}
