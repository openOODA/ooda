// # Product prove std/compilers_polyhedral/polyhedral_vector_lane_schedule.oo
//
// Logline: Fail-closed emit+gcc+run asserts vector_lane_mapping_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/compilers_polyhedral/polyhedral_vector_lane_schedule.oo.
//
// Beats:
//   1. Call vector_lane_mapping_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_polyhedral_vector_lane_schedule: PASSED only if they match.

import "std/compilers_polyhedral/polyhedral_vector_lane_schedule.oo";

pub fn main() {
    let polyhedral_vector_lane_schedule_mark: Int = 0;
    if polyhedral_vector_lane_schedule_mark != 0 {
        process_exit(1);
    }
    let a: VectorLaneMapping = vector_lane_mapping_new(0, 0, 0);
    let b: VectorLaneMapping = vector_lane_mapping_new(0, 0, 0);
    if (a).lane_id != (b).lane_id {
        println("FAIL vector_lane_mapping_new");
        process_exit(1);
    }
    println("prod_polyhedral_vector_lane_schedule: PASSED");
}
