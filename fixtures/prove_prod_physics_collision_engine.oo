// # Product prove std/physics/collision_engine.oo
//
// Logline: Fail-closed emit+gcc+run asserts ray_intersects_sphere is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics/collision_engine.oo.
//
// Beats:
//   1. Call ray_intersects_sphere twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_collision_engine: PASSED only if they match.

import "std/physics/collision_engine.oo";

pub fn main() {
    let collision_engine_mark: Int = 0;
    if collision_engine_mark != 0 {
        process_exit(1);
    }
    let a: RaycastHit = ray_intersects_sphere(Ray { origin: Vec3 { x: 0.0, y: 0.0, z: 0.0 }, dir: Vec3 { x: 1.0, y: 0.0, z: 0.0 } }, Sphere { centre: Vec3 { x: 5.0, y: 0.0, z: 0.0 }, radius: 1.0 });
    let b: RaycastHit = ray_intersects_sphere(Ray { origin: Vec3 { x: 0.0, y: 0.0, z: 0.0 }, dir: Vec3 { x: 1.0, y: 0.0, z: 0.0 } }, Sphere { centre: Vec3 { x: 5.0, y: 0.0, z: 0.0 }, radius: 1.0 });
    if (a).t != (b).t {
        println("FAIL ray_intersects_sphere");
        process_exit(1);
    }
    println("prod_collision_engine: PASSED");
}
