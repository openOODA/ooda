// # Product prove std/physics_advanced/lattice_boltzmann_mrt.oo
//
// Logline: Fail-closed emit+gcc+run asserts mrt_relax_moment is deterministic.
//
// Setup: Isolated emit-c. Imports std/physics_advanced/lattice_boltzmann_mrt.oo.
//
// Beats:
//   1. Call mrt_relax_moment twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_lattice_boltzmann_mrt: PASSED only if they match.

import "std/physics_advanced/lattice_boltzmann_mrt.oo";

pub fn main() {
    let lattice_boltzmann_mrt_mark: Int = 0;
    if lattice_boltzmann_mrt_mark != 0 {
        process_exit(1);
    }
    let a: Float = mrt_relax_moment(0.0, 0.0, 0.0);
    let b: Float = mrt_relax_moment(0.0, 0.0, 0.0);
    if a != b {
        println("FAIL mrt_relax_moment");
        process_exit(1);
    }
    println("prod_lattice_boltzmann_mrt: PASSED");
}
