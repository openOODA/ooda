// # Product prove std/astro_advanced/frame_dragging_lense_thirring.oo
//
// Logline: Fail-closed emit+gcc+run asserts lt_precession_mas is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/frame_dragging_lense_thirring.oo.
//
// Beats:
//   1. Call lt_precession_mas twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_frame_dragging_lense_thirring: PASSED only if they match.

import "std/astro_advanced/frame_dragging_lense_thirring.oo";

pub fn main() {
    let a = lt_precession_mas();
    let b = lt_precession_mas();
    if a != b {
        println("FAIL lt_precession_mas");
        process_exit(1);
    }
    println("prod_frame_dragging_lense_thirring: PASSED");
}
