// # Allow a public struct field
//
// Logline: A public field stays clean even when a tagged name exists beside it.
//
// Beats:
//   1. Tag api_key at line start.
//   2. Build Box with a public field.
//   3. Print that field so the sink stays allowed.

// M-? field clean: struct field stays clean, field read at sink
type Box = struct { v: String };
// SECRET: api_key
pub fn main() {
    let api_key = "x";
    let b = Box { v: "public" };
    println(b.v);
}
