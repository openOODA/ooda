// # Product prove std/wasm_gc/jit_cranelift_machine_ir.oo
//
// Logline: Fail-closed emit+gcc+run asserts jir_type_i32 is deterministic.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/jit_cranelift_machine_ir.oo.
//
// Beats:
//   1. Call jir_type_i32 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_jit_cranelift_machine_ir: PASSED only if they match.

import "std/wasm_gc/jit_cranelift_machine_ir.oo";

pub fn main() {
    let jit_cranelift_machine_ir_mark: Int = 0;
    if jit_cranelift_machine_ir_mark != 0 {
        process_exit(1);
    }
    let a: JirType = jir_type_i32();
    let b: JirType = jir_type_i32();
    if (a).tag != (b).tag {
        println("FAIL jir_type_i32");
        process_exit(1);
    }
    println("prod_jit_cranelift_machine_ir: PASSED");
}
