// # Product prove std/space_propulsion/propellant_pogo_suppression.oo
//
// Logline: Fail-closed emit+gcc+run asserts pogo_spec_default value or determinism.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/propellant_pogo_suppression.oo.
//
// Beats:
//   1. Call pogo_spec_default twice with the same args.
//   2. Exit 1 if the comparable value misses.
//   3. Print prod_propellant_pogo_suppression: PASSED only if asserts hold.

import "std/space_propulsion/propellant_pogo_suppression.oo";

pub fn main() {
    let propellant_pogo_suppression_a: PogoSystemSpec = pogo_spec_default();
    let propellant_pogo_suppression_b: PogoSystemSpec = pogo_spec_default();
    if propellant_pogo_suppression_a.structural_frequency_hz != propellant_pogo_suppression_b.structural_frequency_hz {
        println("FAIL pogo_spec_default");
        process_exit(1);
    }
    println("prod_propellant_pogo_suppression: PASSED");
}
