// # Product prove std/astro_advanced/payload_fairing_aerodynamics.oo
//
// Logline: Fail-closed emit+gcc+run asserts fairing_cd is deterministic.
//
// Setup: Isolated emit-c. Imports std/astro_advanced/payload_fairing_aerodynamics.oo.
//
// Beats:
//   1. Call fairing_cd twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_payload_fairing_aerodynamics: PASSED only if they match.

import "std/astro_advanced/payload_fairing_aerodynamics.oo";

pub fn main() {
    let payload_fairing_aerodynamics_mark: Int = 0;
    if payload_fairing_aerodynamics_mark != 0 {
        process_exit(1);
    }
    let a: Int = fairing_cd();
    let b: Int = fairing_cd();
    if a != b {
        println("FAIL fairing_cd");
        process_exit(1);
    }
    println("prod_payload_fairing_aerodynamics: PASSED");
}
