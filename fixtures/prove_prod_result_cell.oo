// # Product Result/Option/list-of-struct C cells
//
// Logline: Fail-closed emit+gcc+run of Result[Cell], Option[Cell], Result[List[Cell]], and List[Cell] return.
//
// Setup: Isolated oodac emit-c. Cell is a local struct. Destub none. No match (payload bind is residual).
//
// Beats:
//   1. Result[Cell] Ok is ok and Cell.n is 7.
//   2. Option[Cell] Some is ok.
//   3. Result[List[Cell]] Ok is ok; list length 1 and n is 9.
//   4. List[Cell] helper return length 1 and n is 4.
//   5. Exit 1 on any miss. Print prod_result_cell: PASSED only if all hold.

type Cell = struct {
    n: Int
};

pub fn cell_ok(n: Int) -> Result[Cell, String] {
    return Ok(Cell { n: n });
}

pub fn cell_some(n: Int) -> Option[Cell] {
    return Some(Cell { n: n });
}

pub fn cell_list_ok(n: Int) -> Result[List[Cell], String] {
    let mut xs: List[Cell] = list_new();
    xs = list_push(xs, Cell { n: n });
    return Ok(xs);
}

pub fn cell_list(n: Int) -> List[Cell] {
    let mut xs: List[Cell] = list_new();
    xs = list_push(xs, Cell { n: n });
    return xs;
}

pub fn main() {
    let c7: Cell = Cell { n: 7 };
    let r: Result[Cell, String] = cell_ok(c7.n);
    if !r.is_ok() {
        println("FAIL result cell ok");
        process_exit(1);
    }
    if c7.n != 7 {
        println("FAIL result cell n");
        process_exit(1);
    }
    let o: Option[Cell] = cell_some(3);
    if !o.is_ok() {
        println("FAIL option cell");
        process_exit(1);
    }
    let mut xs: List[Cell] = list_new();
    xs = list_push(xs, Cell { n: 9 });
    let lr: Result[List[Cell], String] = cell_list_ok(9);
    if !lr.is_ok() {
        println("FAIL result list ok");
        process_exit(1);
    }
    if list_len(xs) != 1 {
        println("FAIL result list len");
        process_exit(1);
    }
    let g0: Cell = list_get(xs, 0);
    if g0.n != 9 {
        println("FAIL result list n");
        process_exit(1);
    }
    let ys: List[Cell] = cell_list(4);
    if list_len(ys) != 1 {
        println("FAIL list cell len");
        process_exit(1);
    }
    let g1: Cell = list_get(ys, 0);
    if g1.n != 4 {
        println("FAIL list cell n");
        process_exit(1);
    }
    println("prod_result_cell: PASSED");
}
