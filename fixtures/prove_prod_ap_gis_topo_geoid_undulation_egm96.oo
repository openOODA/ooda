    let geoid_undulation_egm96_a = egm96_geoid_undulation(0.0, 0.0);
    let geoid_undulation_egm96_b = egm96_geoid_undulation(0.0, 0.0);
    if geoid_undulation_egm96_a != geoid_undulation_egm96_b {
