// # Product prove std/bio_advanced/protein_disulfide_bonds.oo
//
// Logline: Fail-closed emit+gcc+run asserts protein_disulfide_bonds_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/protein_disulfide_bonds.oo.
//
// Beats:
//   1. Call protein_disulfide_bonds_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_protein_disulfide_bonds: PASSED only if it matches.

import "std/bio_advanced/protein_disulfide_bonds.oo";

pub fn main() {
    let a: Int = protein_disulfide_bonds_probe();
    if a != 0 {
        println("FAIL protein_disulfide_bonds_probe");
        process_exit(1);
    }
    println("prod_nc_protein_disulfide_bonds: PASSED");
}
