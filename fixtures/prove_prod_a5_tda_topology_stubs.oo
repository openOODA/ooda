// # Product prove std/tda_topology/tda_topology_stubs.oo
//
// Logline: Fail-closed emit+gcc+run asserts tda_capabilities_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/tda_topology/tda_topology_stubs.oo.
//
// Beats:
//   1. Call tda_capabilities_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tda_topology_stubs: PASSED only if they match.

import "std/tda_topology/tda_topology_stubs.oo";

pub fn main() {
    let tda_topology_stubs_mark: Int = 0;
    if tda_topology_stubs_mark != 0 {
        process_exit(1);
    }
    let a: TdaCapabilities = tda_capabilities_default();
    let b: TdaCapabilities = tda_capabilities_default();
    if (a).max_point_cloud_size != (b).max_point_cloud_size {
        println("FAIL tda_capabilities_default");
        process_exit(1);
    }
    println("prod_tda_topology_stubs: PASSED");
}
