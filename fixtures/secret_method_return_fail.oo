// # Refuse a chained call on a secret
//
// Logline: A method chain on a secret-derived value taints the later println.
//
// Beats:
//   1. Tag api_key at line start.
//   2. Return that name from make_secret and take .len().
//   3. Print the chain result so the sink refuses.

// M-? method-call return taint: chained call returns secret-derived value
// SECRET: api_key
pub fn make_secret() -> String {
    let api_key = "x";
    return api_key;
}
pub fn main() {
    let y = make_secret().len();
    println(y);
}
