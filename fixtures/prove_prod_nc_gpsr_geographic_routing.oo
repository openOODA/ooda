// # Product prove std/graph_networks/gpsr_geographic_routing.oo
//
// Logline: Fail-closed emit+gcc+run asserts gpsr_geographic_routing_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/graph_networks/gpsr_geographic_routing.oo.
//
// Beats:
//   1. Call gpsr_geographic_routing_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_gpsr_geographic_routing: PASSED only if it matches.

import "std/graph_networks/gpsr_geographic_routing.oo";

pub fn main() {
    let a: Int = gpsr_geographic_routing_probe();
    if a != 0 {
        println("FAIL gpsr_geographic_routing_probe");
        process_exit(1);
    }
    println("prod_nc_gpsr_geographic_routing: PASSED");
}
