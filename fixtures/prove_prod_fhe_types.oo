// # Product prove std/crypto/fhe_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts fhe_params_degree is deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto/fhe_types.oo.
//
// Beats:
//   1. Call fhe_params_degree twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_fhe_types: PASSED only if they match.

import "std/crypto/fhe_types.oo";

pub fn main() {
    let obj = fhe_params_new(0, 0, 0);
    let a = fhe_params_degree(obj);
    let b = fhe_params_degree(obj);
    if a != b {
        println("FAIL fhe_params_degree");
        process_exit(1);
    }
    println("prod_fhe_types: PASSED");
}
