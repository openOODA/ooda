// # Product prove std/bio_advanced/wig_coverage_calculator.oo
//
// Logline: Fail-closed emit+gcc+run asserts wig_coverage_calculator_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/bio_advanced/wig_coverage_calculator.oo.
//
// Beats:
//   1. Call wig_coverage_calculator_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_wig_coverage_calculator: PASSED only if it matches.

import "std/bio_advanced/wig_coverage_calculator.oo";

pub fn main() {
    let a: Int = wig_coverage_calculator_probe();
    if a != 0 {
        println("FAIL wig_coverage_calculator_probe");
        process_exit(1);
    }
    println("prod_nc_wig_coverage_calculator: PASSED");
}
