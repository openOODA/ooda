// # Product prove std/defi_derivatives/power_perpetual_squeeth.oo
//
// Logline: Fail-closed emit+gcc+run asserts power_perp_calc_index is deterministic.
//
// Setup: Isolated emit-c. Imports std/defi_derivatives/power_perpetual_squeeth.oo.
//
// Beats:
//   1. Call power_perp_calc_index twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_power_perpetual_squeeth: PASSED only if they match.

import "std/defi_derivatives/power_perpetual_squeeth.oo";

pub fn main() {
    let power_perpetual_squeeth_mark: Int = 0;
    if power_perpetual_squeeth_mark != 0 {
        process_exit(1);
    }
    let a: Float = power_perp_calc_index(0.0, 0.0);
    let b: Float = power_perp_calc_index(0.0, 0.0);
    if a != b {
        println("FAIL power_perp_calc_index");
        process_exit(1);
    }
    println("prod_power_perpetual_squeeth: PASSED");
}
