// # Product prove std/gis_topo/contour_hypsometric_tint.oo
//
// Logline: Fail-closed emit+gcc+run asserts color_rgb_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/gis_topo/contour_hypsometric_tint.oo.
//
// Beats:
//   1. Call color_rgb_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_contour_hypsometric_tint: PASSED only if they match.

import "std/gis_topo/contour_hypsometric_tint.oo";

pub fn main() {
    let contour_hypsometric_tint_mark: Int = 0;
    if contour_hypsometric_tint_mark != 0 {
        process_exit(1);
    }
    let a: ColorRgb = color_rgb_new(0, 0, 0);
    let b: ColorRgb = color_rgb_new(0, 0, 0);
    if (a).r != (b).r {
        println("FAIL color_rgb_new");
        process_exit(1);
    }
    println("prod_contour_hypsometric_tint: PASSED");
}
