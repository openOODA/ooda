// # Complex contract pass
//
// Logline: Add two positive ints under a matching requires and ensures.
//
// Beats:
//   1. Require x > 0 and y > 0.
//   2. Ensure result == x + y and > 0.
//   3. Call with 3, 4 and print 7.

// Pass: complex requires and ensures
pub fn complex_fn(x: Int, y: Int) -> Int
    requires (x > 0 && y > 0)
    ensures result > 0 && (result == x + y)
{
    return x + y;
}

pub fn main() {
    println(complex_fn(3, 4));
}
