// # Product prove std/db_vector_ann/diskann_vamana_graph.oo
//
// Logline: Fail-closed emit+gcc+run asserts vamana_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/db_vector_ann/diskann_vamana_graph.oo.
//
// Beats:
//   1. Call vamana_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_diskann_vamana_graph: PASSED only if they match.

import "std/db_vector_ann/diskann_vamana_graph.oo";

pub fn main() {
    let diskann_vamana_graph_mark: Int = 0;
    if diskann_vamana_graph_mark != 0 {
        process_exit(1);
    }
    let a: VamanaConfig = vamana_config_default();
    let b: VamanaConfig = vamana_config_default();
    if (a).max_degree != (b).max_degree {
        println("FAIL vamana_config_default");
        process_exit(1);
    }
    println("prod_g2_diskann_vamana_graph: PASSED");
}
