// # Product prove std/wasm_gc/wasm_component_linker.oo
//
// Logline: Fail-closed emit+gcc+run asserts link_edge_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/wasm_gc/wasm_component_linker.oo.
//
// Beats:
//   1. Call link_edge_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_wasm_component_linker: PASSED only if they match.

import "std/wasm_gc/wasm_component_linker.oo";

pub fn main() {
    let wasm_component_linker_mark: Int = 0;
    if wasm_component_linker_mark != 0 {
        process_exit(1);
    }
    let wasm_component_linker_a = link_edge_new(1, 1, "x");
    let wasm_component_linker_b = link_edge_new(1, 1, "x");
    if (wasm_component_linker_a).from_node_id != (wasm_component_linker_b).from_node_id {
        println("FAIL link_edge_new");
        process_exit(1);
    }
    println("prod_wasm_component_linker: PASSED");
}
