// # Product prove std/db_vector_ann/hnsw_heuristic_pruning.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/db_vector_ann/hnsw_heuristic_pruning.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/db_vector_ann/hnsw_heuristic_pruning.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_hnsw_heuristic_pruning: PASSED only if they match.

import "std/db_vector_ann/hnsw_heuristic_pruning.oo";

pub fn main() {
    let hnsw_heuristic_pruning_a = heuristic_config_default(0);
    let hnsw_heuristic_pruning_b = heuristic_config_default(0);
    if hnsw_heuristic_pruning_a.max_neighbors_m != hnsw_heuristic_pruning_b.max_neighbors_m {
        println("FAIL hnsw_heuristic_pruning");
        process_exit(1);
    }
    println("prod_ap_hnsw_heuristic_pruning: PASSED");
}
