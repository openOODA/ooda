// # Product prove std/math/matrix_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts matrix_ops_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/math/matrix_ops.oo.
//
// Beats:
//   1. Call matrix_ops_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_matrix_ops: PASSED only if it matches.

import "std/math/matrix_ops.oo";

pub fn main() {
    let a: Int = matrix_ops_probe();
    if a != 0 {
        println("FAIL matrix_ops_probe");
        process_exit(1);
    }
    println("prod_nc_matrix_ops: PASSED");
}
