// # Product binned stats prove
//
// Logline: Fail-closed emit+gcc+run of shipped binned_stats_add/total/bin0/bin1.
//
// Setup: Product std/math/statistics_binned.oo. Range [0,10] two bins width 5.
//
// Beats:
//   1. 1.0 lands in bin 0; 8.0 lands in bin 1.
//   2. Total samples is 2.
//   3. Exit 1 before PASSED on a miss.

import "std/math/statistics_binned.oo";

pub fn main() {
    let mut s: BinnedStats = binned_stats_new(0.0, 10.0, 2);
    s = binned_stats_add(s, 1.0);
    s = binned_stats_add(s, 8.0);
    let t: Int = binned_stats_total(s);
    if t != 2 {
        println("FAIL binned total");
        process_exit(1);
    }
    let b0: Int = binned_stats_bin0(s);
    if b0 != 1 {
        println("FAIL binned bin0");
        process_exit(1);
    }
    let b1: Int = binned_stats_bin1(s);
    if b1 != 1 {
        println("FAIL binned bin1");
        process_exit(1);
    }
    println("prod_binned: PASSED");
}
