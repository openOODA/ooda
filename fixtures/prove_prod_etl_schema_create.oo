// # Product prove std/enterprise/etl.oo
//
// Logline: Fail-closed emit+gcc+run asserts etl_schema_create is deterministic.
//
// Setup: Isolated emit-c. Imports std/enterprise/etl.oo.
//
// Beats:
//   1. Call etl_schema_create twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_etl_schema_create: PASSED only if they match.

import "std/enterprise/etl.oo";

pub fn main() {
    let etl_mark: Int = 0;
    if etl_mark != 0 { process_exit(1); }
    let a = etl_schema_create("s", 1);
    let b = etl_schema_create("s", 1);
    if (a).version != (b).version {
        println("FAIL etl_schema_create");
        process_exit(1);
    }
    println("prod_etl_schema_create: PASSED");
}
