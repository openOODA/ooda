// # Product prove std/sec/crypto/ed25519.oo
//
// Logline: Fail-closed emit+gcc+run asserts shim_marker_public_key holds a real value or is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/ed25519.oo.
//
// Beats:
//   1. Call shim_marker_public_key using the ed25519 ident.
//   2. Exit 1 if the assert misses.
//   3. Print prod_ed25519: PASSED only if asserts hold.

import "std/sec/crypto/ed25519.oo";

pub fn main() {
    let xa = shim_marker_public_key();
    let xb = shim_marker_public_key();
    let ed25519_a = xa.is_ok();
    if !ed25519_a {
        println("FAIL shim_marker_public_key");
        process_exit(1);
    }
    println("prod_ed25519: PASSED");
}
