// # Product prove std/graph_networks/directed_diffusion_sensor.oo
//
// Logline: Fail-closed emit+gcc+run asserts diffusion_create is deterministic.
//
// Setup: Isolated emit-c. Imports std/graph_networks/directed_diffusion_sensor.oo.
//
// Beats:
//   1. Call diffusion_create twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_directed_diffusion_sensor: PASSED only if they match.

import "std/graph_networks/directed_diffusion_sensor.oo";

pub fn main() {
    let a: DiffusionSensorNode = diffusion_create(0, list_new());
    let b: DiffusionSensorNode = diffusion_create(0, list_new());
    if a.local_id != b.local_id {
        println("FAIL diffusion_create");
        process_exit(1);
    }
    println("prod_directed_diffusion_sensor: PASSED");
}
