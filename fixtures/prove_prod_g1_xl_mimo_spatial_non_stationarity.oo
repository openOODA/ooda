// # Product prove std/telecom_6g/xl_mimo_spatial_non_stationarity.oo
//
// Logline: Fail-closed emit+gcc+run asserts xl_mimo_array_default_1024 is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom_6g/xl_mimo_spatial_non_stationarity.oo.
//
// Beats:
//   1. Call xl_mimo_array_default_1024 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_xl_mimo_spatial_non_stationarity: PASSED only if they match.

import "std/telecom_6g/xl_mimo_spatial_non_stationarity.oo";

pub fn main() {
    let a: XlMimoArray = xl_mimo_array_default_1024();
    let b: XlMimoArray = xl_mimo_array_default_1024();
    if a.total_panels != b.total_panels {
        println("FAIL xl_mimo_array_default_1024");
        process_exit(1);
    }
    println("prod_xl_mimo_spatial_non_stationarity: PASSED");
}
