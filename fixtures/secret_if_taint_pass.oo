// # Allow a public rebind inside an if
//
// Logline: An if that only assigns public literals does not taint the later println.
//
// Beats:
//   1. Tag secret at line start.
//   2. Rebind s to a clean literal in the true branch.
//   3. Print s so the sink stays allowed.

// T1 if-taint clean: SECRET exists but if-branch rebinds only public literals
// SECRET: secret
pub fn main() {
    let secret = "token";
    let mut s = "public";
    if true {
        s = "clean";
    }
    println(s);
}
