// # Product prove std/aero/orbit_types.oo
//
// Logline: Fail-closed emit+gcc+run asserts orbit_vec3_x is deterministic.
//
// Setup: Isolated emit-c. Imports std/aero/orbit_types.oo.
//
// Beats:
//   1. Call orbit_vec3_x twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_orbit_types: PASSED only if they match.

import "std/aero/orbit_types.oo";

pub fn main() {
    let obj_a: Vec3 = orbit_vec3_new(0, 0, 0);
    let obj_b: Vec3 = orbit_vec3_new(0, 0, 0);
    let a: Int = orbit_vec3_x(obj_a);
    let b: Int = orbit_vec3_x(obj_b);
    if a != b {
        println("FAIL orbit_vec3_x");
        process_exit(1);
    }
    println("prod_orbit_types: PASSED");
}
