// # Product prove std/genomics_advanced/single_cell_leiden_clustering.oo
//
// Logline: Fail-closed emit+gcc+run asserts single_cell_leiden_clustering_probe is deterministic.
//
// Setup: Isolated emit-c. Imports std/genomics_advanced/single_cell_leiden_clustering.oo.
//
// Beats:
//   1. Call single_cell_leiden_clustering_probe twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_single_cell_leiden_clustering: PASSED only if they match.

import "std/genomics_advanced/single_cell_leiden_clustering.oo";

pub fn main() {
    let a = single_cell_leiden_clustering_probe();
    let b = single_cell_leiden_clustering_probe();
    if a != b {
        println("FAIL single_cell_leiden_clustering_probe");
        process_exit(1);
    }
    println("prod_single_cell_leiden_clustering: PASSED");
}
