// # Property Test: Tensor Marker
//
// Logline: Verifies the tensor types module is loadable and returns its marker.
//
// Setup: Imports std/ai_ml/tensor_types.oo. Calls tensor_types_marker and asserts the result is a non-zero Int.
//
// Beats:
//   1. Call the marker function.
//   2. Assert the value is finite.
//   3. Print PASSED or FAIL.

import "std/ai_ml/tensor_types.oo";

pub fn main() {
    let m: Int = tensor_types_marker();
    let mut ok: Int = 0;
    if m > 0 {
        if m < 10000000 {
            ok = 1;
        } else {
            ok = 0;
        }
    } else {
        ok = 0;
    }
    if ok == 1 {
        println("tensor_marker: PASSED marker=" + m.to_string());
    } else {
        println("tensor_marker: FAILED marker=" + m.to_string());
        process_exit(1);
    }
}
