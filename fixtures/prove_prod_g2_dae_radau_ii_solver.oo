// # Product prove std/digital_twin/dae_radau_ii_solver.oo
//
// Logline: Fail-closed emit+gcc+run asserts radau_2stage_tableau_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/digital_twin/dae_radau_ii_solver.oo.
//
// Beats:
//   1. Call radau_2stage_tableau_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_dae_radau_ii_solver: PASSED only if they match.

import "std/digital_twin/dae_radau_ii_solver.oo";

pub fn main() {
    let dae_radau_ii_solver_mark: Int = 0;
    if dae_radau_ii_solver_mark != 0 {
        process_exit(1);
    }
    let a: RadauTableau = radau_2stage_tableau_new();
    let b: RadauTableau = radau_2stage_tableau_new();
    if (a).num_stages != (b).num_stages {
        println("FAIL radau_2stage_tableau_new");
        process_exit(1);
    }
    println("prod_g2_dae_radau_ii_solver: PASSED");
}
