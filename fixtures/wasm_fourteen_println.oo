// # Fourteen println string statements
//
// Logline: Print fourteen string literals so emit-wasm can plant all fourteen texts.
//
// Setup: One public main. Body is only fourteen println(STRING) statements.
//
// Beats:
//   1. Print line-a through line-g.
//   2. Print line-h through line-n.
//   3. Leave no other statements.

pub fn main() {
    println("line-a");
    println("line-b");
    println("line-c");
    println("line-d");
    println("line-e");
    println("line-f");
    println("line-g");
    println("line-h");
    println("line-i");
    println("line-j");
    println("line-k");
    println("line-l");
    println("line-m");
    println("line-n");
}
