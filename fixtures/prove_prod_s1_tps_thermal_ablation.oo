// # Product prove std/space_propulsion/tps_thermal_ablation.oo
//
// Logline: Fail-closed emit+gcc+run asserts ablation_compute_response is deterministic.
//
// Setup: Isolated emit-c. Imports std/space_propulsion/tps_thermal_ablation.oo.
//
// Beats:
//   1. Call ablation_compute_response twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_tps_thermal_ablation: PASSED only if they match.

import "std/space_propulsion/tps_thermal_ablation.oo";

pub fn main() {
    let tps_thermal_ablation_mark: Int = 0;
    if tps_thermal_ablation_mark != 0 {
        process_exit(1);
    }
    let tps_thermal_ablation_a = ablation_compute_response(ablator_spec_default_pica(), 1.0, 1.0);
    let tps_thermal_ablation_b = ablation_compute_response(ablator_spec_default_pica(), 1.0, 1.0);
    if (tps_thermal_ablation_a).is_bondline_safe != (tps_thermal_ablation_b).is_bondline_safe {
        println("FAIL ablation_compute_response");
        process_exit(1);
    }
    println("prod_tps_thermal_ablation: PASSED");
}
