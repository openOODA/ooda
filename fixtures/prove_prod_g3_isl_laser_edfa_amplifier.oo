// # Product prove std/satellite_dvb/isl_laser_edfa_amplifier.oo
//
// Logline: Fail-closed emit+gcc+run asserts edfa_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/satellite_dvb/isl_laser_edfa_amplifier.oo.
//
// Beats:
//   1. Call edfa_config_default twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_isl_laser_edfa_amplifier: PASSED only if they match.

import "std/satellite_dvb/isl_laser_edfa_amplifier.oo";

pub fn main() {
    let isl_laser_edfa_amplifier_mark: Int = 0;
    if isl_laser_edfa_amplifier_mark != 0 {
        process_exit(1);
    }
    let a: EdfaConfig = edfa_config_default();
    let b: EdfaConfig = edfa_config_default();
    if (a).small_signal_gain_db != (b).small_signal_gain_db {
        println("FAIL edfa_config_default");
        process_exit(1);
    }
    println("prod_isl_laser_edfa_amplifier: PASSED");
}
