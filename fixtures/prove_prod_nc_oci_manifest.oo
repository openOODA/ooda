// # Product prove std/cloud/oci_manifest.oo
//
// Logline: Fail-closed emit+gcc+run asserts oci_manifest_probe returns 0.
//
// Setup: Isolated emit-c. Imports std/cloud/oci_manifest.oo.
//
// Beats:
//   1. Call oci_manifest_probe.
//   2. Exit 1 if the result is not 0.
//   3. Print prod_nc_oci_manifest: PASSED only if it matches.

import "std/cloud/oci_manifest.oo";

pub fn main() {
    let a: Int = oci_manifest_probe();
    if a != 0 {
        println("FAIL oci_manifest_probe");
        process_exit(1);
    }
    println("prod_nc_oci_manifest: PASSED");
}
