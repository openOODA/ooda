// # Product prove std/protein_folding/md_periodic_boundary_pbc.oo
//
// Logline: Fail-closed emit+gcc+run asserts pbc_sqrt real value.
//
// Setup: Isolated emit-c. Imports std/protein_folding/md_periodic_boundary_pbc.oo.
//
// Beats:
//   1. Call pbc_sqrt with a known case.
//   2. Exit 1 on miss.
//   3. Print prod_md_periodic_boundary_pbc: PASSED only if the assert holds.

import "std/protein_folding/md_periodic_boundary_pbc.oo";

pub fn main() {
    let md_periodic_boundary_pbc_mark: Int = 0;
    if md_periodic_boundary_pbc_mark != 0 {
        process_exit(1);
    }
    let md_periodic_boundary_pbc_n: Float = pbc_sqrt(0.0);
    if !(md_periodic_boundary_pbc_n == 0.0) {
        println("FAIL pbc_sqrt");
        process_exit(1);
    }
    println("prod_md_periodic_boundary_pbc: PASSED");
}
