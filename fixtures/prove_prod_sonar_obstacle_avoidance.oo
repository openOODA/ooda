// # Product prove std/robotics_auv/sonar_obstacle_avoidance.oo
//
// Logline: Fail-closed emit+gcc+run asserts fls_config_default is deterministic.
//
// Setup: Isolated emit-c. Imports std/robotics_auv/sonar_obstacle_avoidance.oo.
//
// Beats:
//   1. Call fls_config_default twice.
//   2. Exit 1 if the two results differ.
//   3. Print prod_sonar_obstacle_avoidance: PASSED only if they match.

import "std/robotics_auv/sonar_obstacle_avoidance.oo";

pub fn main() {
    let sonar_obstacle_avoidance_mark: Int = 0;
    if sonar_obstacle_avoidance_mark != 0 {
        process_exit(1);
    }
    let a: FlsConfig = fls_config_default();
    let b: FlsConfig = fls_config_default();
    if (a).max_range_m != (b).max_range_m {
        println("FAIL fls_config_default");
        process_exit(1);
    }
    println("prod_sonar_obstacle_avoidance: PASSED");
}
