// # Product prove std/crispr_cas/prime_editing_twin_pe.oo
//
// Logline: Fail-closed emit+gcc+run asserts twin_pe_validate_pair is deterministic.
//
// Setup: Isolated emit-c. Imports std/crispr_cas/prime_editing_twin_pe.oo.
//
// Beats:
//   1. Call twin_pe_validate_pair twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_prime_editing_twin_pe: PASSED only if they match.

import "std/crispr_cas/prime_editing_twin_pe.oo";

pub fn main() {
    let a: Bool = twin_pe_validate_pair(0, 0);
    let b: Bool = twin_pe_validate_pair(0, 0);
    if a != b {
        println("FAIL twin_pe_validate_pair");
        process_exit(1);
    }
    println("prod_prime_editing_twin_pe: PASSED");
}
