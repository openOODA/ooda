// # Product prove std/game_engine/camera_3d_follow.oo
//
// Logline: Fail-closed emit+gcc+run asserts camera_3d_follow_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/game_engine/camera_3d_follow.oo.
//
// Beats:
//   1. Call camera_3d_follow_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_camera_3d_follow: PASSED only if they match.

import "std/game_engine/camera_3d_follow.oo";

pub fn main() {
    let a: Camera3DFollow = camera_3d_follow_new(0.0);
    let b: Camera3DFollow = camera_3d_follow_new(0.0);
    if a.target_x != b.target_x {
        println("FAIL camera_3d_follow_new");
        process_exit(1);
    }
    println("prod_camera_3d_follow: PASSED");
}
