// # Product prove std/hash/xxhash.oo
//
// Logline: Fail-closed emit+gcc+run asserts xxhash64 is deterministic.
//
// Setup: Isolated emit-c. Imports std/hash/xxhash.oo.
//
// Beats:
//   1. Call xxhash64 twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_xxhash: PASSED only if they match.

import "std/hash/xxhash.oo";

pub fn main() {
    let a = xxhash64("x", 0);
    let b = xxhash64("x", 0);
    if a != b {
        println("FAIL xxhash64");
        process_exit(1);
    }
    println("prod_xxhash: PASSED");
}
