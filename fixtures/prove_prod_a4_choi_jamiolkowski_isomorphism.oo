// # Product prove std/quantum_open_systems/choi_jamiolkowski_isomorphism.oo
//
// Logline: Fail-closed emit+gcc+run asserts choi_depolarizing_channel is deterministic.
//
// Setup: Isolated emit-c. Imports std/quantum_open_systems/choi_jamiolkowski_isomorphism.oo.
//
// Beats:
//   1. Call choi_depolarizing_channel twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_choi_jamiolkowski_isomorphism: PASSED only if they match.

import "std/quantum_open_systems/choi_jamiolkowski_isomorphism.oo";

pub fn main() {
    let choi_jamiolkowski_isomorphism_mark: Int = 0;
    if choi_jamiolkowski_isomorphism_mark != 0 {
        process_exit(1);
    }
    let a: ChoiMatrix4x4 = choi_depolarizing_channel(0.0);
    let b: ChoiMatrix4x4 = choi_depolarizing_channel(0.0);
    if (a).diag0 != (b).diag0 {
        println("FAIL choi_depolarizing_channel");
        process_exit(1);
    }
    println("prod_choi_jamiolkowski_isomorphism: PASSED");
}
