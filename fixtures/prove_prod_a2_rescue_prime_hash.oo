// # Product prove std/crypto_advanced/rescue_prime_hash.oo
//
// Logline: Fail-closed emit+gcc+run asserts rescue_prime_sbox_fwd is deterministic.
//
// Setup: Isolated emit-c. Imports std/crypto_advanced/rescue_prime_hash.oo.
//
// Beats:
//   1. Call rescue_prime_sbox_fwd twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_rescue_prime_hash: PASSED only if they match.

import "std/crypto_advanced/rescue_prime_hash.oo";

pub fn main() {
    let rescue_prime_hash_mark: Int = 0;
    if rescue_prime_hash_mark != 0 {
        process_exit(1);
    }
    let a: Int = rescue_prime_sbox_fwd(0, 0, 0);
    let b: Int = rescue_prime_sbox_fwd(0, 0, 0);
    if a != b {
        println("FAIL rescue_prime_sbox_fwd");
        process_exit(1);
    }
    println("prod_rescue_prime_hash: PASSED");
}
