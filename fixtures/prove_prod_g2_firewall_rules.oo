// # Product prove std/net_telemetry/firewall_rules.oo
//
// Logline: Fail-closed emit+gcc+run asserts firewall_rule_new is deterministic.
//
// Setup: Isolated emit-c. Imports std/net_telemetry/firewall_rules.oo.
//
// Beats:
//   1. Call firewall_rule_new twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_g2_firewall_rules: PASSED only if they match.

import "std/net_telemetry/firewall_rules.oo";

pub fn main() {
    let firewall_rules_mark: Int = 0;
    if firewall_rules_mark != 0 {
        process_exit(1);
    }
    let a: FirewallRule = firewall_rule_new(0, 0, true, 0, "x", "x", 0, 0);
    let b: FirewallRule = firewall_rule_new(0, 0, true, 0, "x", "x", 0, 0);
    if (a).rule_id != (b).rule_id {
        println("FAIL firewall_rule_new");
        process_exit(1);
    }
    println("prod_g2_firewall_rules: PASSED");
}
