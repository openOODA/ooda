// # Product diag metrics gauge prove
//
// Logline: Fail-closed emit+gcc+run of shipped std/diag/metrics_gauge.oo.
//
// Setup: Product std/diag/metrics_gauge.oo. Isolated emit-c+gcc+run.
//
// Beats:
//   1. New gauge initial 5.
//   2. inc then dec then set 9.
//   9. Exit 1 before PASSED on a miss.

import "std/diag/metrics_gauge.oo";

pub fn main() {
    let g0: MetricsGauge = metrics_gauge_new("temp", 5);
    let a: Int = metrics_gauge_get(g0);
    if a != 5 {
        println("FAIL mgauge init");
        process_exit(1);
    }
    let g1: MetricsGauge = metrics_gauge_inc(g0);
    let b: Int = metrics_gauge_get(g1);
    if b != 6 {
        println("FAIL mgauge inc");
        process_exit(1);
    }
    let g2: MetricsGauge = metrics_gauge_dec(g1);
    let c: Int = metrics_gauge_get(g2);
    if c != 5 {
        println("FAIL mgauge dec");
        process_exit(1);
    }
    let g3: MetricsGauge = metrics_gauge_set(g2, 9);
    let d: Int = metrics_gauge_get(g3);
    if d != 9 {
        println("FAIL mgauge set");
        process_exit(1);
    }
    println("prod_mgauge: PASSED");
}
