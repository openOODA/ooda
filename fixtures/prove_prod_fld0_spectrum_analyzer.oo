// # Product prove std/telecom/spectrum_analyzer.oo
//
// Logline: Fail-closed emit+gcc+run asserts spectrum_int_to_float is deterministic.
//
// Setup: Isolated emit-c. Imports std/telecom/spectrum_analyzer.oo.
//
// Beats:
//   1. Call spectrum_int_to_float twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_spectrum_analyzer: PASSED only if they match.

import "std/telecom/spectrum_analyzer.oo";

pub fn main() {
    let spectrum_analyzer_mark: Int = 0;
    if spectrum_analyzer_mark != 0 {
        process_exit(1);
    }
    let spectrum_analyzer_a: Float = spectrum_int_to_float(1);
    let spectrum_analyzer_b: Float = spectrum_int_to_float(1);
    if spectrum_analyzer_a != spectrum_analyzer_b {
        println("FAIL spectrum_int_to_float");
        process_exit(1);
    }
    println("prod_spectrum_analyzer: PASSED");
}
