// # Product prove std/zk_rollup/merkle_patricia_trie_proof.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/zk_rollup/merkle_patricia_trie_proof.oo field determinism.
//
// Setup: Isolated emit-c. Imports std/zk_rollup/merkle_patricia_trie_proof.oo.
//
// Beats:
//   1. Build two values the same way.
//   2. Exit 1 if a comparable field differs.
//   3. Print prod_ap_merkle_patricia_trie_proof: PASSED only if they match.

import "std/zk_rollup/merkle_patricia_trie_proof.oo";

pub fn main() {
    let merkle_patricia_trie_proof_a = mpt_proof_node_new(0, 0, 0);
    let merkle_patricia_trie_proof_b = mpt_proof_node_new(0, 0, 0);
    if merkle_patricia_trie_proof_a.node_hash != merkle_patricia_trie_proof_b.node_hash {
        println("FAIL merkle_patricia_trie_proof");
        process_exit(1);
    }
    println("prod_ap_merkle_patricia_trie_proof: PASSED");
}
