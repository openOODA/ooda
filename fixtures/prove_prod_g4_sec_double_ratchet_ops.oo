// # Product prove std/sec/crypto/double_ratchet_ops.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/sec/crypto/double_ratchet_ops.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/sec/crypto/double_ratchet_ops.oo.
//
// Beats:
//   1. Call real functions twice with concrete test inputs.
//   2. Exit 1 if return values differ.
//   3. Print prod_g4_sec_double_ratchet_ops: PASSED and exit 0 only on match.

import "std/sec/crypto/double_ratchet_ops.oo";

pub fn main() {
    let chk_a: Int = double_ratchet_checksum("01234567890123456789012345678901");
    let chk_b: Int = double_ratchet_checksum("01234567890123456789012345678901");
    if chk_a != chk_b {
        println("FAIL double_ratchet_ops checksum");
        process_exit(1);
    }

    let hpair_a: String = byte_to_hex_pair(160);
    let hpair_b: String = byte_to_hex_pair(160);
    if hpair_a != hpair_b || hpair_a != "a0" {
        println("FAIL double_ratchet_ops byte_to_hex_pair");
        process_exit(1);
    }

    let hval_a: Int = hex_char_to_val(65);
    let hval_b: Int = hex_char_to_val(65);
    if hval_a != hval_b || hval_a != 10 {
        println("FAIL double_ratchet_ops hex_char_to_val");
        process_exit(1);
    }

    let enc_a: String = double_ratchet_hex_encode("hi");
    let enc_b: String = double_ratchet_hex_encode("hi");
    if enc_a != enc_b || enc_a != "6869" {
        println("FAIL double_ratchet_ops double_ratchet_hex_encode");
        process_exit(1);
    }

    let dec_res_a: Result[String, String] = double_ratchet_hex_decode("6869");
    let dec_res_b: Result[String, String] = double_ratchet_hex_decode("6869");
    let dec_str_a: String = match dec_res_a {
        Ok(s) => s,
        Err(_) => "",
    };
    let dec_str_b: String = match dec_res_b {
        Ok(s) => s,
        Err(_) => "",
    };
    if dec_str_a != dec_str_b || dec_str_a != "hi" {
        println("FAIL double_ratchet_ops double_ratchet_hex_decode");
        process_exit(1);
    }

    let eq_a: Bool = double_ratchet_constant_time_eq("shared_secret", "shared_secret");
    let eq_b: Bool = double_ratchet_constant_time_eq("shared_secret", "wrong_secret");
    if !eq_a || eq_b {
        println("FAIL double_ratchet_ops constant_time_eq");
        process_exit(1);
    }

    let pub_key: String = "01234567890123456789012345678901";
    let hdr_res_a: Result[MessageHeader, String] = message_header_create(pub_key, 2, 10);
    let hdr_res_b: Result[MessageHeader, String] = message_header_create(pub_key, 2, 10);
    let hdr_a: MessageHeader = match hdr_res_a {
        Ok(h) => h,
        Err(_) => {
            println("FAIL double_ratchet_ops message_header_create a");
            process_exit(1);
        },
    };
    let hdr_b: MessageHeader = match hdr_res_b {
        Ok(h) => h,
        Err(_) => {
            println("FAIL double_ratchet_ops message_header_create b");
            process_exit(1);
        },
    };
    if (hdr_a).checksum != (hdr_b).checksum {
        println("FAIL double_ratchet_ops header checksum");
        process_exit(1);
    }

    let v_a: Bool = message_header_validate(&hdr_a);
    let v_b: Bool = message_header_validate(&hdr_b);
    if !v_a || !v_b {
        println("FAIL double_ratchet_ops message_header_validate");
        process_exit(1);
    }

    let ser_a: String = message_header_serialize(&hdr_a);
    let ser_b: String = message_header_serialize(&hdr_b);
    if ser_a != ser_b {
        println("FAIL double_ratchet_ops message_header_serialize");
        process_exit(1);
    }

    let tostr_a: String = message_header_to_string(&hdr_a);
    let tostr_b: String = message_header_to_string(&hdr_b);
    if tostr_a != tostr_b {
        println("FAIL double_ratchet_ops message_header_to_string");
        process_exit(1);
    }

    println("prod_g4_sec_double_ratchet_ops: PASSED");
    process_exit(0);
}
