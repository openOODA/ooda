// # Product prove std/media_dsp/mkv_ebml_element_parser.oo
//
// Logline: Fail-closed emit+gcc+run asserts std/media_dsp/mkv_ebml_element_parser.oo is deterministic.
//
// Setup: Isolated emit-c. Imports std/media_dsp/mkv_ebml_element_parser.oo.
//
// Beats:
//   1. Call twice with the same args.
//   2. Exit 1 if the two results differ.
//   3. Print prod_ap_mkv_ebml_element_parser: PASSED only if they match.

import "std/media_dsp/mkv_ebml_element_parser.oo";

pub fn main() {
    let mkv_ebml_element_parser_a = ebml_id_header();
    let mkv_ebml_element_parser_b = ebml_id_header();
    if mkv_ebml_element_parser_a != mkv_ebml_element_parser_b {
        println("FAIL mkv_ebml_element_parser");
        process_exit(1);
    }
    println("prod_ap_mkv_ebml_element_parser: PASSED");
}
