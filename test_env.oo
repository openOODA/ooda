import "oodac/llvm_emit_env.oo";
import "oodac/token_fmt.oo";
import "oodac/llvm_emit_arc.oo";
import "oodac/llvm_emit_ty.oo";

pub fn main() {
    let mut env: List[String] = llvm_env_new();
    env = llvm_env_add_var(env, "src", "%OoStr");
    env = llvm_env_add_var(env, "n", "i64");
    env = llvm_env_add_var(env, "__did_ret__", "1");
    env = llvm_env_add_var(env, "i", "i64");
    env = llvm_env_add_var(env, "line", "i64");
    env = llvm_env_add_var(env, "col", "i64");
    println(list_get(env, 3));
    println(llvm_env_get_var_ty(env, "n"));
}
