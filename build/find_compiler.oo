// # Find oodac with zero user config
//
// Logline: Resolve the compiler path: OODA_COMPILER first, then the
// self-derived OODA_TOOLCHAIN layout, then the HOME convention. No PATH.
//
// Setup: &FsReadCap validates every candidate. &EnvCap reads the tokens.
//
// Beats:
//   1. Prefer OODA_COMPILER. Fail closed when nothing resolves.
//   2. Fall back to OODA_TOOLCHAIN/bin/oodac (ctor-derived, not searched).
//   3. Fall back to HOME/.openooda/bin/oodac (install convention).
//   4. Reject a path whose basename is the product CLI (`ooda`).

import "std/fs/file/path.oo";
import "std/fs/process/env.oo";

fn take_compiler(fs: &FsReadCap, path: String) -> String {
    if path == "" { return ""; }
    if !path_exists(fs, path) { return ""; }
    if path_basename(path) == "ooda" { return ""; }
    return path;
}

pub fn find_oodac(fs: &FsReadCap, env: &EnvCap) -> String {
    let r: Result[String, String] = env_get(env, "OODA_COMPILER");
    let raw: String = match r { Ok(s) => s, Err(_) => "" };
    if raw != "" {
        let strict: String = take_compiler(fs, raw);
        if strict == "" {
            println("ERR\tcli\tno oodac at OODA_COMPILER");
            process_exit(1);
        }
        return strict;
    }
    let mut p: String = "";
    if p == "" {
        let tr: Result[String, String] = env_get(env, "OODA_TOOLCHAIN");
        let th: String = match tr { Ok(s) => s, Err(_) => "" };
        if th != "" { p = take_compiler(fs, th + "/bin/oodac"); }
    }
    if p == "" {
        let hr: Result[String, String] = env_get(env, "HOME");
        let home: String = match hr { Ok(s) => s, Err(_) => "" };
        if home != "" { p = take_compiler(fs, home + "/.openooda/bin/oodac"); }
    }
    if p == "" {
        println("ERR\tcli\tno oodac (OODA_COMPILER, OODA_TOOLCHAIN, or HOME layout)");
        process_exit(1);
    }
    return p;
}
