// # Find oodac without ambient fallback chains
//
// Logline: Resolve compiler and source root from explicit tokens. No XDG, no HOME, no path heuristics.
//
// Setup: &FsReadCap validates the path. &EnvCap reads the two allowed env keys.
//
// Beats:
//   1. Reject paths whose basename is the product CLI (`ooda`).
//   2. Prefer the explicit OODA_COMPILER environment token.
//   3. Fall through to the two canonical in-tree/release locations.
//   4. Require OODA_HOME or OODA_SRC_ROOT for source root; do not infer from strings.

import "std/fs/path.oo";
import "std/os/env.oo";

fn take_compiler(fs: &FsReadCap, path: String) -> String {
    if !path_exists(fs, path) { return ""; }
    if path_basename(path) == "ooda" { return ""; }
    return path;
}

fn ooda_key_path(env: &EnvCap, key: String) -> String {
    let r: Result[String, String] = env_get(env, key);
    return match r { Ok(s) => s, Err(_) => "" };
}

pub fn find_oodac(fs: &FsReadCap, env: &EnvCap) -> String {
    let mut p: String = take_compiler(fs, ooda_key_path(env, "OODA_COMPILER"));
    if p != "" { return p; }
    p = take_compiler(fs, "bin/oodac");
    if p != "" { return p; }
    p = take_compiler(fs, "ooda/oodac_bin");
    if p != "" { return p; }
    println("ERR\tcli\tno oodac");
    process_exit(1);
    return "";
}

pub fn find_src_root(env: &EnvCap) -> String {
    let mut r: String = ooda_key_path(env, "OODA_HOME");
    if r != "" { return r; }
    r = ooda_key_path(env, "OODA_SRC_ROOT");
    if r != "" { return r; }
    println("ERR\tcli\tOODA_HOME or OODA_SRC_ROOT required");
    process_exit(1);
    return "";
}
