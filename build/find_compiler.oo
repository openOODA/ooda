// # Find oodac from one explicit token
//
// Logline: Resolve the compiler path from OODA_COMPILER only. No path chain. No HOME. No PATH.
//
// Setup: &FsReadCap validates the path. &EnvCap reads OODA_COMPILER.
//
// Beats:
//   1. Require OODA_COMPILER. Fail closed when unset or empty.
//   2. Reject a path whose basename is the product CLI (`ooda`).
//   3. Reject a path that does not exist under FsReadCap.
//   4. Return the path.

import "std/fs/file/path.oo";
import "std/fs/process/env.oo";

fn take_compiler(fs: &FsReadCap, path: String) -> String {
    if path == "" { return ""; }
    if !path_exists(fs, path) { return ""; }
    if path_basename(path) == "ooda" { return ""; }
    return path;
}

pub fn find_oodac(fs: &FsReadCap, env: &EnvCap) -> String {
    let r: Result[String, String] = env_get(env, "OODA_COMPILER");
    let raw: String = match r { Ok(s) => s, Err(_) => "" };
    if raw == "" {
        println("ERR\tcli\tOODA_COMPILER required");
        process_exit(1);
    }
    let p: String = take_compiler(fs, raw);
    if p == "" {
        println("ERR\tcli\tno oodac at OODA_COMPILER");
        process_exit(1);
    }
    return p;
}
