// # Ruby on Rails-Style Scaffolding Generator
//
// Logline: Scaffold domain modules, capability services, and locked smoke tests with Academy headers.
//
// Setup: Generates compliant <= 256 line .oo files under src/ and tests/ using FsWriteCap.
//
// Beats:
//   1. Parse generator subcommand (module, service, test) and target entity name.
//   2. Reject names with path traversal or directory separators.
//   3. Generate module, service, or test template and write it under FsWriteCap.

import "std/os/fs.oo";

fn gen_path_ok(name: String) -> Bool {
    if str_contains(name, "/") { return false; }
    if str_contains(name, "..") { return false; }
    if chars_len(name) == 0 { return false; }
    return true;
}

pub fn gen_module_template(name: String) -> String {
    let mut out: String = "// # Domain Module for " + name + "\n";
    out = out + "//\n";
    out = out + "// Logline: Domain logic, state representation, and verified operations for " + name + ".\n";
    out = out + "//\n";
    out = out + "// Setup: Core record model with invariant contracts and constructors.\n";
    out = out + "//\n";
    out = out + "// Beats:\n";
    out = out + "//   1. Define " + name + " struct state.\n";
    out = out + "//   2. Construct and validate instances.\n";
    out = out + "//   3. Execute verified domain operations.\n\n";
    out = out + "import \"std/result.oo\";\n\n";
    out = out + "pub type " + name + " = struct {\n";
    out = out + "    id: Int,\n";
    out = out + "    name: String,\n";
    out = out + "    is_active: Bool\n";
    out = out + "};\n\n";
    out = out + "pub fn " + name + "_new(id: Int, name: String) -> " + name + " {\n";
    out = out + "    return " + name + " {\n";
    out = out + "        id: id,\n";
    out = out + "        name: name,\n";
    out = out + "        is_active: true\n";
    out = out + "    };\n";
    out = out + "}\n\n";
    out = out + "pub fn " + name + "_get_id(item: &" + name + ") -> Int {\n";
    out = out + "    return item.id;\n";
    out = out + "}\n\n";
    out = out + "pub fn " + name + "_is_valid(item: &" + name + ") -> Bool {\n";
    out = out + "    return item.id > 0 && chars_len(item.name) > 0;\n";
    out = out + "}\n";
    return out;
}

pub fn gen_service_template(name: String) -> String {
    let mut out: String = "// # Capability Service for " + name + "\n";
    out = out + "//\n";
    out = out + "// Logline: Capability-gated service lifecycle and request dispatcher for " + name + ".\n";
    out = out + "//\n";
    out = out + "// Setup: Isolated actor lifecycle managed under runtime capabilities.\n";
    out = out + "//\n";
    out = out + "// Beats:\n";
    out = out + "//   1. Initialize service state with capabilities.\n";
    out = out + "//   2. Start, dispatch, and handle service requests.\n";
    out = out + "//   3. Gracefully stop and clean up service resources.\n\n";
    out = out + "import \"std/result.oo\";\n\n";
    out = out + "pub type " + name + "Service = struct {\n";
    out = out + "    name: String,\n";
    out = out + "    running: Bool,\n";
    out = out + "    request_count: Int\n";
    out = out + "};\n\n";
    out = out + "pub fn " + name + "_service_create(name: String) -> " + name + "Service {\n";
    out = out + "    return " + name + "Service {\n";
    out = out + "        name: name,\n";
    out = out + "        running: false,\n";
    out = out + "        request_count: 0\n";
    out = out + "    };\n";
    out = out + "}\n\n";
    out = out + "pub fn " + name + "_service_start(svc: &mut " + name + "Service) -> Result[Bool, String] {\n";
    out = out + "    svc.running = true;\n";
    out = out + "    return Ok(true);\n";
    out = out + "}\n\n";
    out = out + "pub fn " + name + "_service_handle(svc: &mut " + name + "Service, req: String) -> Result[String, String] {\n";
    out = out + "    if !svc.running {\n";
    out = out + "        return Err(\"service not running\");\n";
    out = out + "    }\n";
    out = out + "    svc.request_count = svc.request_count + 1;\n";
    out = out + "    return Ok(\"handled: \" + req);\n";
    out = out + "}\n\n";
    out = out + "pub fn " + name + "_service_stop(svc: &mut " + name + "Service) -> Result[Bool, String] {\n";
    out = out + "    svc.running = false;\n";
    out = out + "    return Ok(true);\n";
    out = out + "}\n";
    return out;
}

pub fn gen_test_template(name: String) -> String {
    let mut out: String = "// # Smoke Test Suite for " + name + "\n";
    out = out + "//\n";
    out = out + "// Logline: Automated smoke proof and regression locks for " + name + ".\n";
    out = out + "//\n";
    out = out + "// Setup: Executes unit verification gates and enforces pass locks.\n";
    out = out + "//\n";
    out = out + "// Beats:\n";
    out = out + "//   1. Verify initial constructor state.\n";
    out = out + "//   2. Verify domain invariants and error paths.\n";
    out = out + "//   3. Lock smoke pass status.\n\n";
    out = out + "fn test_" + name + "_initialization() -> Bool {\n";
    out = out + "    return true;\n";
    out = out + "}\n\n";
    out = out + "pub fn main() {\n";
    out = out + "    if !test_" + name + "_initialization() {\n";
    out = out + "        println(\"FAIL: " + name + " initialization check\");\n";
    out = out + "        process_exit(1);\n";
    out = out + "    }\n";
    out = out + "    println(\"OK: " + name + "_SMOKE_PASSED\");\n";
    out = out + "}\n";
    return out;
}

pub fn run_ooda_gen(fw: &FsWriteCap, args: List[String]) {
    if list_len(args) < 3 {
        println("usage: ooda gen module|service|test <name>");
        process_exit(2);
    }
    let kind: String = list_get(args, 1);
    let name: String = list_get(args, 2);
    if !gen_path_ok(name) {
        println("ERR\tgen\trefused name: " + name);
        process_exit(2);
    }

    let content: String = if kind == "module" { gen_module_template(name); }
        else if kind == "service" { gen_service_template(name); }
        else if kind == "test" { gen_test_template(name); }
        else { "" };
    if content == "" {
        println("ERR\tgen\tunknown generator kind: " + kind + " (want module|service|test)");
        process_exit(2);
    }

    let dir: String = if kind == "test" { "tests" } else { "src" };
    let path: String = dir + "/" + if kind == "service" { name + "_service" } else if kind == "test" { "test_" + name } else { name } + ".oo";
    let mk: Result[Void, String] = fs_mkdir_p(fw, dir);
    if mk.is_err() {
        println("ERR\tgen\tfailed to create " + dir);
        process_exit(1);
    }
    let wr: Result[Void, String] = fs_write_file(fw, path, content);
    if wr.is_err() {
        println("ERR\tgen\tfailed to write " + path);
        process_exit(1);
    }
    println("ooda gen: created " + path);
}
