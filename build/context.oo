// # Enumerate .oo files and emit sovereign AI orientation codex
//
// Logline: List .oo files under a path, or stream the LLMS.oot codex to stdout.
//
// Setup: &FsReadCap walks the target directory and reads openOODA/LLMS.oot.
//
// Beats:
//   1. Parse --llm, --json flags and the optional directory path from argv.
//   2. In --llm mode, read the codex file once and stream its bytes to stdout.
//   3. In default mode, enumerate .oo files under the path, count, and print the list.
//   4. In --json mode, emit the count and file list as a single JSON object.
//
// ## CAPs
//   &FsReadCap: Read directory listings and the orientation codex file.

pub fn is_oo_name(name: String) -> Bool {
    return str_ends_with(name, ".oo");
}

pub fn ctx_filter_text(text: String) -> String {
    let n: Int = chars_len(text);
    let mut i: Int = 0;
    let mut start: Int = 0;
    let mut acc: String = "";
    while i <= n {
        if i == n || char_at(text, i) == "\n" {
            if i > start {
                let line: String = str_slice(text, start, i);
                if is_oo_name(line) {
                    acc = acc + line + "\n";
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return acc;
}

pub fn count_nl(text: String) -> Int {
    let n: Int = chars_len(text);
    let mut c: Int = 0;
    let mut i: Int = 0;
    while i < n {
        if char_at(text, i) == "\n" {
            c = c + 1;
        }
        i = i + 1;
    }
    return c;
}

fn print_nl_names(text: String) {
    let n: Int = chars_len(text);
    let mut i: Int = 0;
    let mut start: Int = 0;
    while i <= n {
        if i == n || char_at(text, i) == "\n" {
            if i > start {
                println(str_slice(text, start, i));
            }
            start = i + 1;
        }
        i = i + 1;
    }
}

fn read_codex(fr: &FsReadCap) -> Result[String, String] {
    return read_file(fr, "openOODA/LLMS.oot");
}

pub fn ctx_names_in(fr: &FsReadCap, dir: String) -> String {
    let list: List[String] = oo_fs_read_dir(fr, dir);
    let n: Int = list_len(list);
    let mut acc: String = "";
    let mut i: Int = 0;
    while i < n {
        let name: String = list_get(list, i);
        if is_oo_name(name) {
            acc = acc + name + "\n";
        }
        i = i + 1;
    }
    return acc;
}

fn print_json_context(dir: String, names: String, count: Int) {
    let mut out: String = "{\"command\":\"context\",\"target\":\""
        + dir + "\",\"files_count\":" + count.to_string() + ",\"files\":[";
    let n: Int = chars_len(names);
    let mut i: Int = 0;
    let mut start: Int = 0;
    let mut first: Bool = true;
    while i <= n {
        if i == n || char_at(names, i) == "\n" {
            if i > start {
                let name: String = str_slice(names, start, i);
                if is_oo_name(name) {
                    if !first {
                        out = out + ",";
                    }
                    out = out + "\"" + name + "\"";
                    first = false;
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    out = out + "]}";
    println(out);
}

pub fn run_ooda_context(fr: &FsReadCap, args: List[String]) {
    let mut dir: String = ".";
    let mut saw_llm: Bool = false;
    let mut saw_json: Bool = false;
    let argc: Int = list_len(args);
    let mut i: Int = 1;
    while i < argc {
        let a: String = list_get(args, i);
        if a == "--llm" {
            saw_llm = true;
        } else if a == "--json" {
            saw_json = true;
        } else if str_slice(a, 0, 1) != "-" {
            dir = a;
        }
        i = i + 1;
    }

    if saw_llm {
        let res: Result[String, String] = read_codex(fr);
        let codex: String = match res { Ok(s) => s, Err(e) => e };
        if codex == "" {
            println("ERR\tcontext\topenOODA/LLMS.oot not found");
            return;
        }
        println("=== openOODA SOVEREIGN AI ORIENTATION CODEX ===");
        println("source: openOODA/LLMS.oot");
        println("");
        println(codex);
        return;
    }

    if chars_len(dir) == 0 {
        dir = ".";
    }
    let names: String = ctx_names_in(fr, dir);
    let n: Int = count_nl(names);

    if saw_json {
        print_json_context(dir, names, n);
        return;
    }

    println("ooda context: " + n.to_string());
    print_nl_names(names);
}
