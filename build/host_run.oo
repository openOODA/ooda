// # Start oodac from the product CLI
//
// Logline: Find the in-tree oodac binary and run check, test, eval, or repl without a product .sh file.
//
// Setup: FsReadCap sees the tree. FsWriteCap creates the run cache. EnvCap resolves the compiler. ProcessCap starts oodac.
//
// Beats:
//   1. Resolve the compiler via &EnvCap and validate it is not the product CLI.
//   2. Ensure the run cache exists with &FsWriteCap.
//   3. Forward variable-arity compiler arguments through one bounded sh -c quoting path.

import "find_compiler.oo";
import "std/os/fs.oo";

pub fn sq(s: String) -> String {
    let n: Int = chars_len(s);
    let mut i = 0;
    let mut out: String = "'";
    while i < n {
        let c: String = char_at(s, i);
        if c == "'" { out = out + "'\\''"; }
        else { out = out + c; }
        i = i + 1;
    }
    return out + "'";
}

pub fn refuse_cli(proc: &ProcessCap, path: String) {
    let r: Result[String, String] = sys_exec(proc, path, "--version");
    let out: String = match r { Ok(s) => s, Err(e) => e };
    let parts: List[String] = str_split(out, " ");
    if list_len(parts) == 0 || list_get(parts, 0) != "oodac" {
        println("ERR\tcli\toodac is CLI or not executable");
        process_exit(1);
    }
}

pub fn run_oodac(fr: &FsReadCap, fw: &FsWriteCap, proc: &ProcessCap, env: &EnvCap, argv: List[String]) {
    let oodac: String = find_oodac(fr, env);
    refuse_cli(proc, oodac);
    let mk: Result[Void, String] = fs_mkdir_p(fw, ".ooda-cache/run");
    if mk.is_err() { println("ERR\tcli\tmkdir failed"); process_exit(1); }
    let mut cmd: String = sq(oodac);
    let mut i = 0;
    while i < list_len(argv) {
        cmd = cmd + " " + sq(list_get(argv, i));
        i = i + 1;
    }
    let r: Result[String, String] = sys_exec(proc, "sh", "-c", cmd);
    if r.is_ok() {
        let out_str: String = match r { Ok(s) => s, Err(_) => "" };
        println(out_str);
        process_exit(0);
    }
    let err_str: String = match r { Ok(_) => "", Err(e) => e };
    println(err_str);
    process_exit(1);
}

pub fn run_oodac_check(fr: &FsReadCap, proc: &ProcessCap, env: &EnvCap, path: String, json: Bool) {
    let oodac: String = find_oodac(fr, env);
    refuse_cli(proc, oodac);
    if json {
        let r: Result[String, String] = sys_exec(proc, oodac, "check", path, "--json-errors");
        if r.is_ok() { process_exit(0); }
        let err_str: String = match r { Ok(_) => "", Err(e) => e };
        println(err_str); process_exit(1);
    }
    let r: Result[String, String] = sys_exec(proc, oodac, "check", path);
    if r.is_ok() { process_exit(0); }
    let err_str: String = match r { Ok(_) => "", Err(e) => e };
    println(err_str); process_exit(1);
}

pub fn run_ooda_eval(fr: &FsReadCap, fw: &FsWriteCap, proc: &ProcessCap, env: &EnvCap, args: List[String]) {
    let mut argv: List[String] = list_new();
    argv = list_push(argv, "eval");
    let mut i = 1;
    while i < list_len(args) { argv = list_push(argv, list_get(args, i)); i = i + 1; }
    run_oodac(fr, fw, proc, env, argv);
}

pub fn run_ooda_repl(fr: &FsReadCap, fw: &FsWriteCap, proc: &ProcessCap, env: &EnvCap, args: List[String]) {
    let mut argv: List[String] = list_new();
    argv = list_push(argv, "repl");
    let mut i = 1;
    while i < list_len(args) { argv = list_push(argv, list_get(args, i)); i = i + 1; }
    run_oodac(fr, fw, proc, env, argv);
}
