// # Start oodac from the product CLI
//
// Logline: Find the oodac binary and run it with a direct argv list. No shell.
//
// Setup: FsReadCap sees the tree. FsWriteCap creates the run cache. EnvCap resolves OODA_COMPILER. ProcessCap starts oodac.
//
// Beats:
//   1. Resolve the compiler via OODA_COMPILER and refuse a product-CLI basename.
//   2. Ensure the run cache exists with &FsWriteCap.
//   3. Exec oodac with sys_exec_wait. Stdio is inherited.

import "find_compiler.oo";
import "std/fs/os/fs.oo";
import "std/fs/file/path.oo";
import "std/fs/process/cmd.oo";

pub fn refuse_cli(proc: &ProcessCap, path: String) {
    if path_basename(path) == "ooda" {
        println("ERR\tcli\toodac path is the product CLI");
        process_exit(1);
    }
    let r: Result[String, String] = sys_exec(proc, path, "--version");
    if r.is_err() {
        println("ERR\tcli\toodac is not executable");
        process_exit(1);
    }
}

pub fn run_oodac(fr: &FsReadCap, fw: &FsWriteCap, proc: &ProcessCap, env: &EnvCap, argv: List[String]) {
    let oodac: String = find_oodac(fr, env);
    refuse_cli(proc, oodac);
    let mk: Result[Void, String] = fs_mkdir_p(fw, ".ooda-cache/run");
    if mk.is_err() { println("ERR\tcli\tmkdir failed"); process_exit(1); }
    let r: Result[Int, String] = sys_exec_wait(proc, oodac, argv);
    if r.is_ok() {
        process_exit(r.val);
    }
    println("ERR\tcli\texec failed");
    process_exit(1);
}

pub fn run_oodac_check(fr: &FsReadCap, proc: &ProcessCap, env: &EnvCap, path: String, json: Bool) {
    let oodac: String = find_oodac(fr, env);
    refuse_cli(proc, oodac);
    if json {
        let r: Result[String, String] = sys_exec(proc, oodac, "check", path, "--json-errors");
        if r.is_ok() { process_exit(0); }
        let err_str: String = match r { Ok(_) => "", Err(e) => e };
        println(err_str); process_exit(1);
    }
    let r: Result[String, String] = sys_exec(proc, oodac, "check", path);
    if r.is_ok() { process_exit(0); }
    let err_str: String = match r { Ok(_) => "", Err(e) => e };
    println(err_str); process_exit(1);
}
