// # Ooda Eval — Headless 1-Turn Expression Evaluator
//
// Logline: Evaluate an openOODA expression headlessly, printing output to stdout and returning appropriate exit code.
//
// Setup: Requires &FsReadCap, &FsWriteCap, &ProcessCap, &SysCap, &TimeCap. Zero ambient authority.
//
// Beats:
//   1. Validate arguments, parse --sandbox flag, and parse expression.
//   2. Apply Landlock sandbox matrix under &SysCap if requested.
//   3. Invoke headless evaluation engine in std/app/agent/repl_engine.oo.
//   4. Format and print result or fail-closed error with appropriate exit code.

import "std/app/agent/repl_engine.oo";
import "std/sec/sandbox/config.oo";
import "std/sec/sandbox/engine.oo";
import "std/fs/os/fs.oo";

pub fn run_ooda_eval(
    fr: &FsReadCap,
    fw: &FsWriteCap,
    proc: &ProcessCap,
    sys_cap: &SysCap,
    time: &TimeCap,
    args: List[String]
) -> Result[Int, String] {
    let n: Int = list_len(args);
    if n < 1 {
        println("usage: ooda eval [--sandbox] <expression>");
        process_exit(2);
        return Err("missing expression");
    }

    let mut use_sandbox: Bool = false;
    let mut expr: String = "";
    let mut i: Int = 0;

    while i < n {
        let arg: String = list_get(args, i);
        if arg == "--help" || arg == "-h" {
            println("usage: ooda eval [--sandbox] <expression>");
            println("evaluates a single openOODA expression and prints the result.");
            process_exit(0);
            return Ok(0);
        }
        if arg == "--sandbox" {
            use_sandbox = true;
        } else if str_starts_with(arg, "-") {
            println("ERR\teval\tunknown flag: " + arg);
            process_exit(2);
            return Err("unknown flag: " + arg);
        } else {
            if chars_len(expr) == 0 {
                expr = arg;
            } else {
                expr = expr + " " + arg;
            }
        }
        i = i + 1;
    }

    if chars_len(expr) == 0 {
        println("usage: ooda eval [--sandbox] <expression>");
        process_exit(2);
        return Err("missing expression");
    }

    if use_sandbox {
        let _mk0: Result[Void, String] = fs_mkdir_p(fw, "/home/jeryd/.ooda-cache/ooda-tmp");
        let _mk1: Result[Void, String] = fs_mkdir_p(fw, "/home/jeryd/Projects/openOODA/.ooda-cache/repl");
        let _mk2: Result[Void, String] = fs_mkdir_p(fw, "/home/jeryd/Projects/openOODA/.ooda-cache/ooda-tmp");
        let mut scfg: SandboxConfig = sandbox_config_default();
        scfg = sandbox_config_with_read(scfg, "/usr");
        scfg = sandbox_config_with_read(scfg, "/lib");
        scfg = sandbox_config_with_read(scfg, "/lib64");
        scfg = sandbox_config_with_read(scfg, "/bin");
        scfg = sandbox_config_with_read(scfg, "/usr/lib");
        scfg = sandbox_config_with_read(scfg, "/usr/bin");
        scfg = sandbox_config_with_read(scfg, "/etc");
        scfg = sandbox_config_with_read(scfg, "/dev");
        scfg = sandbox_config_with_read(scfg, "/proc");
        scfg = sandbox_config_with_read(scfg, "/tmp");
        scfg = sandbox_config_with_read(scfg, "/home");
        scfg = sandbox_config_with_write(scfg, "/tmp");
        scfg = sandbox_config_with_write(scfg, "/home/jeryd/.ooda-cache");
        scfg = sandbox_config_with_write(scfg, "/home/jeryd/Projects/openOODA/.ooda-cache");

        let p_res: Result[String, String] = sys_exec(proc, "pwd");
        let raw_pwd: String = match p_res { Ok(s) => s, Err(_) => "" };
        let cwd: String = str_trim(raw_pwd);
        if chars_len(cwd) > 0 {
            let cwd_cache: String = cwd + "/.ooda-cache";
            let _mk3: Result[Void, String] = fs_mkdir_p(fw, cwd_cache + "/repl");
            let _mk4: Result[Void, String] = fs_mkdir_p(fw, cwd_cache + "/ooda-tmp");
            scfg = sandbox_config_with_write(scfg, cwd_cache);
        }

        scfg = sandbox_config_with_caps_mask(scfg, 126);

        let s_res: Result[Int, String] = sandbox_apply_matrix(sys_cap, scfg);
        if s_res.is_err() {
            let se: String = match s_res { Ok(_) => "", Err(e) => e };
            println("ERR\teval\t" + se);
            process_exit(1);
            return Err(se);
        }
    }

    let res: Result[String, String] = repl_eval_expr_headless(fr, fw, proc, time, expr);
    if res.is_ok() {
        let out: String = match res { Ok(s) => s, Err(_) => "" };
        if chars_len(out) > 0 {
            println(out);
        }
        process_exit(0);
        return Ok(0);
    }

    let err: String = match res { Ok(_) => "", Err(e) => e };
    println("ERR\teval\t" + err);
    if str_contains(err, "syntax error") || str_contains(err, "unclosed delimiter") || str_contains(err, "trailing operator") {
        process_exit(2);
        return Err(err);
    }
    if str_contains(err, "capability_denied") {
        process_exit(3);
        return Err(err);
    }
    process_exit(1);
    return Err(err);
}

