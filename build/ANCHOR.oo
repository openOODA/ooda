// # Ooda Build Cluster — Anchor for Agents
//
// Logline: Front door for the build-toolchain drivers and the project-init commands.
//
// Setup: find_compiler/host_run/host_build drive oodac. context/health/test/install/gen/bench/init are user-facing.
//
// Beats:
//   1. Toolchain plumbing: find_compiler, host_run, host_build — spawn oodac with OODA_COMPILER.
//   2. Diagnostics: context, health — read the project tree under FsReadCap.
//   3. Code generation: gen — scaffold a new .oo file from a template.
//   4. Project lifecycle: init, test, install, bench.

import "find_compiler.oo";
import "host_run.oo";
import "host_build.oo";
import "context.oo";
import "health.oo";
import "test.oo";
import "install.oo";
import "gen.oo";
import "bench.oo";
import "init.oo";
import "spawn.oo";
