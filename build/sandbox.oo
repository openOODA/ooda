// # Ooda Sandbox — Sovereign Capability Hypervisor CLI
//
// Logline: Surface kernel Landlock LSM, seccomp filters, and POSIX resource quotas via sovereign CLI subcommands.
//
// Setup: Requires &SysCap for kernel lockdown and &ProcessCap for process execution. Zero ambient authority.
//
// Beats:
//   1. Parse and validate CLI subcommands (status, run).
//   2. Inspect active kernel backend and report confinement state under "status".
//   3. Parse allowlist flags, resource quotas, and target command under "run".
//   4. Apply Landlock matrix under &SysCap and execute target command under &ProcessCap.

import "std/sec/sandbox/config.oo";
import "std/sec/sandbox/status.oo";
import "std/sec/sandbox/engine.oo";
import "std/fs/process/cmd.oo";
import "std/fs/os/fs.oo";

fn parse_sandbox_int(s: String) -> Int {
    let n: Int = chars_len(s);
    let mut acc: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == "0" { acc = acc * 10; }
        else if c == "1" { acc = acc * 10 + 1; }
        else if c == "2" { acc = acc * 10 + 2; }
        else if c == "3" { acc = acc * 10 + 3; }
        else if c == "4" { acc = acc * 10 + 4; }
        else if c == "5" { acc = acc * 10 + 5; }
        else if c == "6" { acc = acc * 10 + 6; }
        else if c == "7" { acc = acc * 10 + 7; }
        else if c == "8" { acc = acc * 10 + 8; }
        else if c == "9" { acc = acc * 10 + 9; }
        else { return acc; }
        i = i + 1;
    }
    return acc;
}

fn add_paths_to_cfg(cfg: SandboxConfig, paths_str: String, is_write: Bool) -> SandboxConfig {
    let paths: List[String] = str_split(paths_str, ":");
    let mut cur: SandboxConfig = cfg;
    let mut i: Int = 0;
    while i < list_len(paths) {
        let p: String = str_trim(list_get(paths, i));
        if chars_len(p) > 0 {
            if is_write { cur = sandbox_config_with_write(cur, p); }
            else { cur = sandbox_config_with_read(cur, p); }
        }
        i = i + 1;
    }
    return cur;
}

fn print_sandbox_help() {
    println("ooda sandbox — sovereign kernel sandbox and capability hypervisor");
    println("usage: ooda sandbox <status|run> [args...]");
    println("");
    println("commands:");
    println("  status       — inspect active kernel sandbox backend and confinement state");
    println("  run [flags] <cmd> [args...] — execute command confined under Landlock LSM");
    println("");
    println("run flags:");
    println("  --read-dirs <paths>   — colon-separated read allowlist (default: system libs + cwd)");
    println("  --write-dirs <paths>  — colon-separated write allowlist");
    println("  --max-mem <mb>        — maximum memory in MB (RLIMIT_AS)");
    println("  --max-cpu <sec>       — maximum CPU time in seconds (RLIMIT_CPU)");
    println("  --max-nofile <count>  — maximum open file descriptors (RLIMIT_NOFILE)");
}

pub fn run_ooda_sandbox(
    fs_r: &FsReadCap,
    fs_w: &FsWriteCap,
    sys: &ProcessCap,
    sys_cap: &SysCap,
    env: &EnvCap,
    time: &TimeCap,
    args: List[String]
) -> Result[Int, String] {
    let n: Int = list_len(args);
    if n < 1 {
        print_sandbox_help();
        process_exit(2);
        return Err("missing sandbox subcommand");
    }

    let sub: String = list_get(args, 0);

    if sub == "--help" || sub == "-h" || sub == "help" {
        print_sandbox_help();
        process_exit(0);
        return Ok(0);
    }

    if sub == "status" {
        let mut si: Int = 1;
        while si < n {
            let sarg: String = list_get(args, si);
            if sarg == "--help" || sarg == "-h" {
                println("usage: ooda sandbox status");
                println("inspects active kernel sandbox backend and OS confinement state.");
                process_exit(0);
                return Ok(0);
            }
            if str_starts_with(sarg, "-") {
                println("ERR\tsandbox\tunknown flag: " + sarg);
                process_exit(2);
                return Err("unknown flag: " + sarg);
            }
            si = si + 1;
        }

        let backend: String = sandbox_probe_backend();
        println("Active kernel sandbox backend: " + backend);
        let st: SandboxStatus = sandbox_current_status();
        println(sandbox_status_to_string(st));
        process_exit(0);
        return Ok(0);
    }

    if sub == "run" {
        let mut cfg: SandboxConfig = sandbox_config_default();
        cfg = sandbox_config_with_read(cfg, "/usr");
        cfg = sandbox_config_with_read(cfg, "/lib");
        cfg = sandbox_config_with_read(cfg, "/lib64");
        cfg = sandbox_config_with_read(cfg, "/bin");
        cfg = sandbox_config_with_read(cfg, "/usr/lib");
        cfg = sandbox_config_with_read(cfg, "/usr/bin");
        cfg = sandbox_config_with_read(cfg, "/tmp");

        let mut i: Int = 1;
        let mut cmd: String = "";
        let mut cmd_args: List[String] = list_new();

        while i < n {
            let arg: String = list_get(args, i);
            if str_starts_with(arg, "--") {
                if arg == "--help" {
                    println("usage: ooda sandbox run [--read-dirs <paths>] [--write-dirs <paths>] <cmd> [args...]");
                    process_exit(0);
                    return Ok(0);
                }
                if arg == "--read-dirs" {
                    i = i + 1;
                    if i >= n {
                        println("ERR\tsandbox\tmissing value for --read-dirs");
                        process_exit(2);
                        return Err("missing value for --read-dirs");
                    }
                    cfg = add_paths_to_cfg(cfg, list_get(args, i), false);
                } else if str_starts_with(arg, "--read-dirs=") {
                    cfg = add_paths_to_cfg(cfg, str_slice(arg, 12, chars_len(arg)), false);
                } else if arg == "--write-dirs" {
                    i = i + 1;
                    if i >= n {
                        println("ERR\tsandbox\tmissing value for --write-dirs");
                        process_exit(2);
                        return Err("missing value for --write-dirs");
                    }
                    cfg = add_paths_to_cfg(cfg, list_get(args, i), true);
                } else if str_starts_with(arg, "--write-dirs=") {
                    cfg = add_paths_to_cfg(cfg, str_slice(arg, 13, chars_len(arg)), true);
                } else if arg == "--max-mem" {
                    i = i + 1;
                    if i >= n {
                        println("ERR\tsandbox\tmissing value for --max-mem");
                        process_exit(2);
                        return Err("missing value for --max-mem");
                    }
                    cfg = sandbox_config_with_max_mem(cfg, parse_sandbox_int(list_get(args, i)));
                } else if str_starts_with(arg, "--max-mem=") {
                    cfg = sandbox_config_with_max_mem(cfg, parse_sandbox_int(str_slice(arg, 10, chars_len(arg))));
                } else if arg == "--max-cpu" {
                    i = i + 1;
                    if i >= n {
                        println("ERR\tsandbox\tmissing value for --max-cpu");
                        process_exit(2);
                        return Err("missing value for --max-cpu");
                    }
                    cfg = sandbox_config_with_max_cpu(cfg, parse_sandbox_int(list_get(args, i)));
                } else if str_starts_with(arg, "--max-cpu=") {
                    cfg = sandbox_config_with_max_cpu(cfg, parse_sandbox_int(str_slice(arg, 10, chars_len(arg))));
                } else if arg == "--max-nofile" {
                    i = i + 1;
                    if i >= n {
                        println("ERR\tsandbox\tmissing value for --max-nofile");
                        process_exit(2);
                        return Err("missing value for --max-nofile");
                    }
                    cfg = sandbox_config_with_max_nofile(cfg, parse_sandbox_int(list_get(args, i)));
                } else if str_starts_with(arg, "--max-nofile=") {
                    cfg = sandbox_config_with_max_nofile(cfg, parse_sandbox_int(str_slice(arg, 13, chars_len(arg))));
                } else {
                    println("ERR\tsandbox\tunknown flag: " + arg);
                    process_exit(2);
                    return Err("unknown flag: " + arg);
                }
            } else if str_starts_with(arg, "-") {
                println("ERR\tsandbox\tunknown flag: " + arg);
                process_exit(2);
                return Err("unknown flag: " + arg);
            } else {
                cmd = arg;
                i = i + 1;
                while i < n {
                    cmd_args = list_push(cmd_args, list_get(args, i));
                    i = i + 1;
                }
                break;
            }
            i = i + 1;
        }

        if chars_len(cmd) == 0 {
            println("usage: ooda sandbox run [--read-dirs <paths>] [--write-dirs <paths>] <cmd> [args...]");
            process_exit(2);
            return Err("missing command to execute");
        }

        let r_apply: Result[Int, String] = sandbox_apply_matrix(sys_cap, cfg);
        if r_apply.is_err() {
            let em: String = match r_apply { Ok(_) => "", Err(e) => e };
            println("ERR\tsandbox\t" + em);
            process_exit(1);
            return Err(em);
        }

        let r_exec: Result[Int, String] = sys_exec_wait(sys, cmd, cmd_args);
        let code: Int = r_exec.val;
        process_exit(code);
        return Ok(code);
    }

    println("ERR\tsandbox\tunknown subcommand: " + sub);
    println("usage: ooda sandbox <status|run> [args...]");
    process_exit(2);
    return Err("unknown subcommand: " + sub);
}
