// # Product liveness for ooda health
//
// Logline: Print ooda health: ok and whether ./oodac/oodac exists.
//
// Setup: FsReadCap probes the compiler path. No shell, no ProcessCap.
//
// Beats:
//   1. Print the ok line.
//   2. Probe ./oodac/oodac and oodac/oodac under &FsReadCap.
//   3. Print yes or no and return.

pub fn run_ooda_health(fr: &FsReadCap, args: List[String]) {
    println("ooda health: ok");
    let mut here: String = "no";
    if path_exists(fr, "./oodac/oodac") {
        here = "yes";
    }
    if path_exists(fr, "oodac/oodac") {
        here = "yes";
    }
    if list_len(args) >= 0 {
        println("oodac/oodac: " + here);
    }
}
