// # Product liveness for ooda health
//
// Logline: Print ooda health: ok and whether OODA_COMPILER points at an existing file.
//
// Setup: FsReadCap probes the compiler path. EnvCap reads OODA_COMPILER. No shell.
//
// Beats:
//   1. Print the ok line.
//   2. Read OODA_COMPILER and probe that path under FsReadCap.
//   3. Print yes or no.

import "std/fs/process/env.oo";

pub fn run_ooda_health(fr: &FsReadCap, env: &EnvCap, args: List[String]) {
    println("ooda health: ok");
    let r: Result[String, String] = env_get(env, "OODA_COMPILER");
    let p: String = match r { Ok(s) => s, Err(_) => "" };
    let mut here: String = "no";
    if p != "" {
        if path_exists(fr, p) { here = "yes"; }
    }
    println("OODA_COMPILER: " + here);
}
