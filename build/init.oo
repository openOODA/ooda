// # Project Initialization and Scaffolding Handler
//
// Logline: Scaffolds an OODA package: manifest, src/main.oo, and tests.
//
// Setup: Creates src/main.oo, tests/test_main.oo, and ooda.pkg under FsReadCap and FsWriteCap.
//
// Beats:
//   1. Resolve project name and reject traversal or existing directories.
//   2. Generate ooda.pkg, src/main.oo, and tests/test_main.oo.
//   3. Never write CLAUDE.md, .cursorrules, .windsurfrules, or AGENTS.oot.

import "std/fs/os/fs.oo";

fn init_name_ok(name: String) -> Bool {
    if chars_len(name) == 0 { return false; }
    if str_contains(name, "/") { return false; }
    if str_contains(name, "..") { return false; }
    return true;
}

pub fn cli_init_project(fr: &FsReadCap, fw: &FsWriteCap, proj_name: String) -> Result[String, String] {
    if !init_name_ok(proj_name) {
        return Err("E_INIT: refused project name");
    }
    if path_exists(fr, proj_name) {
        return Err("E_INIT: path already exists: " + proj_name);
    }

    let manifest_content: String = "name=" + proj_name + "\nversion=0.1.0\nmin_pin=v0.210.0\ndeps=\ncaps=FsRead\n";
    let main_content: String = "// # Main Entry Point for " + proj_name + "\n"
        + "//\n"
        + "// Logline: Starter application entry point for " + proj_name + ".\n"
        + "//\n"
        + "// Setup: Granted SysCap to run application logic.\n"
        + "//\n"
        + "// Beats:\n"
        + "//   1. Print welcome message.\n"
        + "\n"
        + "pub fn main(sys: &SysCap) {\n"
        + "    println(\"Hello from " + proj_name + "!\");\n"
        + "}\n";
    let test_content: String = "// # Test Suite for " + proj_name + "\n"
        + "//\n"
        + "// Logline: Starter unit tests for " + proj_name + ".\n"
        + "//\n"
        + "// Setup: Verifies basic logic.\n"
        + "//\n"
        + "// Beats:\n"
        + "//   1. Run basic arithmetic assertions.\n"
        + "\n"
        + "pub fn test_basic_addition() -> Bool {\n"
        + "    let sum: Int = 2 + 2;\n"
        + "    if sum == 4 {\n"
        + "        return true;\n"
        + "    }\n"
        + "    return false;\n"
        + "}\n"
        + "\n"
        + "pub fn main() {\n"
        + "    if !test_basic_addition() {\n"
        + "        println(\"FAIL: basic test\");\n"
        + "        process_exit(1);\n"
        + "    }\n"
        + "    println(\"OK: ALL_TESTS_PASSED\");\n"
        + "}\n";

    let mk: Result[Void, String] = fs_mkdir_p(fw, proj_name + "/src");
    if mk.is_err() { return Err("E_INIT: failed to create directories"); }
    let mk2: Result[Void, String] = fs_mkdir_p(fw, proj_name + "/tests");
    if mk2.is_err() { return Err("E_INIT: failed to create directories"); }

    let mut files: List[String] = list_new();
    files = list_push(files, proj_name + "/ooda.pkg");
    files = list_push(files, proj_name + "/src/main.oo");
    files = list_push(files, proj_name + "/tests/test_main.oo");

    let mut contents: List[String] = list_new();
    contents = list_push(contents, manifest_content);
    contents = list_push(contents, main_content);
    contents = list_push(contents, test_content);

    let mut i: Int = 0;
    while i < list_len(files) {
        let wr: Result[Void, String] = fs_write_file(fw, list_get(files, i), list_get(contents, i));
        if wr.is_err() { return Err("E_INIT: failed to write " + list_get(files, i)); }
        i = i + 1;
    }

    return Ok("Created OODA project '" + proj_name + "' successfully.");
}
