// # Ooda Swarm — Sovereign Autonomous Agent Swarm & Actor Mesh Driver
//
// Logline: Initialize, inspect, and execute sovereign multi-agent actor swarms under supervision and capability bounds.
//
// Setup: Requires ProcessCap, SysCap, FsReadCap, FsWriteCap, TimeCap, and ThreadCap. Zero ambient authority.
//
// Beats:
//   1. Parse swarm subcommand (init, status, run, help).
//   2. ooda swarm init: Scaffold template swarm.oot manifest.
//   3. ooda swarm status: Load manifest or default topology and report active agents, states, and fuel metrics.
//   4. ooda swarm run <manifest>: Parse manifest, boot supervisor, spawn cells, and drive OODA cycles.
//   5. Negative-trust CLI falsification: Fail closed with exit code 2 on unknown flags or missing manifest.

import "std/core/primitives/list.oo";
import "std/fs/os/fs.oo";
import "std/app/agent/swarm/ANCHOR.oo";

fn swarm_print_help() {
    println("ooda swarm — sovereign autonomous agent swarm & actor mesh");
    println("usage: ooda swarm <subcommand> [args]");
    println("");
    println("subcommands:");
    println("  init [path]              generate template swarm.oot manifest");
    println("  status [manifest]        report active agents, mailbox depths, fuel");
    println("  run <manifest>           boot supervisor, spawn cells, and step OODA cycles");
    println("  help                     print this help message");
}

fn fallback_manifest() -> SwarmManifest {
    let caps: AgentCaps = agent_caps_new(true, false, false, false);
    let mut roles: List[AgentRole] = list_new();
    roles = list_push(roles, agent_role_new("Planner", caps, 1000));
    return SwarmManifest { name: "swarm", strategy: 0, max_restarts: 3, roles: roles, initial_task: "" };
}

fn handle_swarm_init(fs_w: &FsWriteCap, args: List[String]) -> Result[Int, String] {
    let n: Int = list_len(args);
    let mut out_path: String = "swarm.oot";
    let mut i: Int = 0;
    while i < n {
        let arg: String = list_get(args, i);
        if arg == "--help" || arg == "-h" { swarm_print_help(); process_exit(0); return Ok(0); }
        if arg == "--output" || arg == "-o" {
            if i + 1 >= n { println("ERR\tswarm init: missing output file path"); process_exit(2); return Err("missing output"); }
            out_path = list_get(args, i + 1); i = i + 1;
        } else if str_starts_with(arg, "-") {
            println("ERR\tswarm\tunknown flag: " + arg); process_exit(2); return Err("unknown flag: " + arg);
        } else { out_path = arg; }
        i = i + 1;
    }
    let wr: Result[Void, String] = fs_write_file(fs_w, out_path, swarm_manifest_template());
    if wr.is_err() {
        let e: String = match wr { Ok(_) => "", Err(m) => m };
        println("ERR\tswarm init: failed to write manifest: " + e); process_exit(1); return Err(e);
    }
    println("Created swarm topology template '" + out_path + "' with roles: Planner, Coder, Tester, Auditor.");
    process_exit(0);
    return Ok(0);
}

fn handle_swarm_status(thread: &ThreadCap, fs_r: &FsReadCap, args: List[String]) -> Result[Int, String] {
    let n: Int = list_len(args);
    let mut manifest_path: String = "";
    let mut i: Int = 0;
    while i < n {
        let arg: String = list_get(args, i);
        if arg == "--help" || arg == "-h" { swarm_print_help(); process_exit(0); return Ok(0); }
        if arg == "--manifest" || arg == "-m" {
            if i + 1 >= n { println("ERR\tswarm status: missing manifest path"); process_exit(2); return Err("missing manifest"); }
            manifest_path = list_get(args, i + 1); i = i + 1;
        } else if str_starts_with(arg, "-") {
            println("ERR\tswarm\tunknown flag: " + arg); process_exit(2); return Err("unknown flag: " + arg);
        } else if chars_len(manifest_path) == 0 { manifest_path = arg; }
        i = i + 1;
    }
    if chars_len(manifest_path) > 0 && !path_exists(fs_r, manifest_path) {
        println("ERR\tswarm\tunreadable manifest: " + manifest_path);
        process_exit(2);
        return Err("unreadable manifest: " + manifest_path);
    }
    let manifest_res: Result[SwarmManifest, String] = if chars_len(manifest_path) > 0 {
        swarm_load_manifest(fs_r, manifest_path)
    } else if path_exists(fs_r, "swarm.oot") {
        swarm_load_manifest(fs_r, "swarm.oot")
    } else {
        swarm_manifest_parse(swarm_manifest_template())
    };
    if manifest_res.is_err() {
        let em: String = match manifest_res { Ok(_) => "", Err(e) => e };
        println("ERR\tswarm status: failed to parse manifest: " + em); process_exit(2); return Err(em);
    }
    let manifest: SwarmManifest = match manifest_res { Ok(m) => m, Err(_) => fallback_manifest() };
    let mesh_res: Result[SwarmMesh, String] = swarm_create(thread, manifest);
    if mesh_res.is_err() {
        let em: String = match mesh_res { Ok(_) => "", Err(e) => e };
        println("ERR\tswarm status: failed to create mesh: " + em); process_exit(1); return Err(em);
    }
    let dummy_mesh: SwarmMesh = SwarmMesh { sup: swarm_sup_new(thread, 0, 3), manifest: manifest, current_turn: 0, total_fuel_consumed: 0, is_finished: false };
    let mesh: SwarmMesh = match mesh_res { Ok(m) => m, Err(_) => dummy_mesh };
    println(swarm_status(mesh));
    println("Swarm Status: READY");
    process_exit(0);
    return Ok(0);
}

fn handle_swarm_run(
    fs_r: &FsReadCap, fs_w: &FsWriteCap, proc: &ProcessCap,
    sys_cap: &SysCap, time: &TimeCap, thread: &ThreadCap, args: List[String]
) -> Result[Int, String] {
    let n: Int = list_len(args);
    if n < 1 { println("usage: ooda swarm run <manifest>"); process_exit(2); return Err("missing manifest"); }
    let mut manifest_path: String = "";
    let mut i: Int = 0;
    while i < n {
        let arg: String = list_get(args, i);
        if arg == "--help" || arg == "-h" { swarm_print_help(); process_exit(0); return Ok(0); }
        if str_starts_with(arg, "-") { println("ERR\tswarm\tunknown flag: " + arg); process_exit(2); return Err("unknown flag: " + arg); }
        if chars_len(manifest_path) == 0 { manifest_path = arg; }
        i = i + 1;
    }
    if chars_len(manifest_path) == 0 { println("usage: ooda swarm run <manifest>"); process_exit(2); return Err("missing manifest"); }
    if !path_exists(fs_r, manifest_path) {
        println("ERR\tswarm\tunreadable manifest: " + manifest_path); process_exit(2); return Err("unreadable manifest: " + manifest_path);
    }
    let manifest_res: Result[SwarmManifest, String] = swarm_load_manifest(fs_r, manifest_path);
    if manifest_res.is_err() {
        let em: String = match manifest_res { Ok(_) => "", Err(e) => e };
        println("ERR\tswarm\tunreadable manifest: " + em); process_exit(2); return Err(em);
    }
    let manifest: SwarmManifest = match manifest_res { Ok(m) => m, Err(_) => fallback_manifest() };
    let strat_name: String = if manifest.strategy == 1 { "OneForAll" } else { "OneForOne" };
    println("[supervisor] booting swarm topology from '" + manifest_path + "'...");
    println("[supervisor] supervision strategy: " + strat_name + " (max_restarts: " + manifest.max_restarts.to_string() + ")");

    let mesh_res: Result[SwarmMesh, String] = swarm_create(thread, manifest);
    if mesh_res.is_err() {
        let em: String = match mesh_res { Ok(_) => "", Err(e) => e };
        println("ERR\tswarm run: failed to initialize mesh: " + em); process_exit(1); return Err(em);
    }
    let dummy_mesh: SwarmMesh = SwarmMesh { sup: swarm_sup_new(thread, 0, 3), manifest: manifest, current_turn: 0, total_fuel_consumed: 0, is_finished: false };
    let mut mesh: SwarmMesh = match mesh_res { Ok(m) => m, Err(_) => dummy_mesh };

    let num_cells: Int = swarm_sup_cell_count(mesh.sup);
    let mut ci: Int = 0;
    while ci < num_cells {
        let c: AgentCell = list_get(mesh.sup.cells, ci);
        println("[cell:" + c.role.name + "] spawned cell in state " + agent_state_name(c.state));
        ci = ci + 1;
    }

    println("[supervisor] stepping OODA execution cycles...");
    let max_turns: Int = 10;
    while mesh.current_turn < max_turns && !mesh.is_finished {
        let prev_mesh: SwarmMesh = mesh;
        let prev_autopsies: Int = list_len(prev_mesh.sup.autopsies);
        let t_num: Int = mesh.current_turn + 1;
        if str_contains(manifest.initial_task, "CRASH") && t_num == 1 {
            println("[Turn " + t_num.to_string() + "] Stepping autonomous OODA cycles with fault injection...");
        } else {
            println("[Turn " + t_num.to_string() + "] Stepping autonomous OODA cycles...");
        }
        let step_res: Result[SwarmMesh, String] = swarm_step(thread, fs_r, fs_w, proc, time, mesh);
        if step_res.is_err() {
            let em: String = match step_res { Ok(_) => "", Err(e) => e };
            println("ERR\tswarm run: execution halted: " + em); process_exit(1); return Err(em);
        }
        mesh = match step_res { Ok(m) => m, Err(_) => mesh };

        let cur_autopsies: Int = list_len(mesh.sup.autopsies);
        let mut ai: Int = prev_autopsies;
        while ai < cur_autopsies {
            let a: SwarmAutopsy = list_get(mesh.sup.autopsies, ai);
            println("[cell:" + a.role_name + "] OBSERVE -> FAULT: " + a.crash_reason);
            println("[supervisor] detected cell crash: Agent " + a.agent_id.to_string() + " (" + a.role_name + ") entered state CRASHED");
            println("[supervisor] recorded autopsy: Agent " + a.agent_id.to_string() + " (" + a.role_name + "), reason: " + a.crash_reason + ", fuel at crash: " + a.fuel_at_crash.to_string());
            println("[supervisor] executed Let-It-Crash " + strat_name + " recovery (<2ms restart budget)");
            println("[supervisor] agent cell " + a.role_name + " rejuvenated in " + a.rejuvenation_ms.to_string() + "ms (<2ms budget, restart " + mesh.sup.inner_sup.current_restarts.to_string() + "/" + manifest.max_restarts.to_string() + ")");
            ai = ai + 1;
        }

        let mut c_idx: Int = 0;
        while c_idx < num_cells {
            let cur_c: AgentCell = list_get(mesh.sup.cells, c_idx);
            let prev_c: AgentCell = list_get(prev_mesh.sup.cells, c_idx);
            if cur_c.fuel_consumed > prev_c.fuel_consumed {
                println("[cell:" + cur_c.role.name + "] OBSERVE -> ORIENT -> DECIDE -> ACT (fuel: " + cur_c.fuel_remaining.to_string() + ")");
            }
            c_idx = c_idx + 1;
        }
    }

    let total_autopsies: Int = list_len(mesh.sup.autopsies);
    if total_autopsies > 0 {
        let cw: String = if total_autopsies == 1 { "crash" } else { "crashes" };
        println("[supervisor] crash recovery verified: supervisor handled " + total_autopsies.to_string() + " " + cw + " without cascading.");
    }
    println("[supervisor] all agent cells completed cycles cleanly.");
    println("Swarm execution completed in " + mesh.current_turn.to_string() + " turn(s). Fuel consumed: " + mesh.total_fuel_consumed.to_string() + ".");
    process_exit(0);
    return Ok(0);
}

pub fn run_ooda_swarm(
    fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap,
    sys_cap: &SysCap, time: &TimeCap, thread: &ThreadCap, args: List[String]
) -> Result[Int, String] {
    let n: Int = list_len(args);
    if n < 1 {
        println("ooda swarm — sovereign autonomous agent swarm & actor mesh");
        println("usage: ooda swarm <init|run|status> [args...]");
        process_exit(2);
        return Err("missing swarm subcommand");
    }
    let sub: String = list_get(args, 0);
    let rest: List[String] = list_slice(args, 1, n);
    if sub == "help" || sub == "--help" || sub == "-h" { swarm_print_help(); process_exit(0); return Ok(0); }
    if str_starts_with(sub, "-") {
        println("ERR\tswarm\tunknown flag: " + sub);
        process_exit(2);
        return Err("unknown flag: " + sub);
    }
    if sub == "init" { return handle_swarm_init(fs_w, rest); }
    if sub == "status" { return handle_swarm_status(thread, fs_r, rest); }
    if sub == "run" { return handle_swarm_run(fs_r, fs_w, sys, sys_cap, time, thread, rest); }
    println("ERR\tswarm\tunknown subcommand: " + sub);
    println("usage: ooda swarm <init|run|status> [args...]");
    process_exit(2);
    return Err("unknown subcommand: " + sub);
}
