// # Ooda Self-Update via Canonical Installer
//
// Logline: Fetch the canonical install.sh and exec it to update the toolchain.
//
// Setup: ProcessCap spawns sh or bash. EnvCap reads OODA_INSTALLER. FsReadCap
//        probes an explicit installer path. No NetCap is needed: typing
//        `ooda update` is explicit consent for the download. Installer logic
//        stays in the install repo; this file only routes to it. Never guard
//        list_get with &&: nest the bound check in an outer if instead,
//        because slist_get exits fail-closed on OOB (str_slice is safe).
//
// Beats:
//   1. Parse --yes, --dry-run, --no-modify-shell, --installer <path>.
//   2. Resolve the source: explicit path, OODA_INSTALLER, or canonical URL.
//   3. Exec the installer and report its exit code.
//   4. Reject unknown flags and unsafe installer paths fail-closed.

import "std/fs/process/env.oo";

fn update_canonical_url() -> String {
    return "https://openooda.org/install.sh";
}

// update_mirror_url: GitHub raw fallback for `ooda update`. The primary
// URL is openooda.org, but on hosts where oda's child process has a
// sanitized environment (e.g. ProcessCap strips DNS-resolving context),
// the primary URL may fail. The mirror is reachable when the GitHub raw
// domain is reachable; the user can override via the OODA_INSTALLER env
// var or --installer flag for a fully local path.
fn update_mirror_url() -> String {
    return "https://raw.githubusercontent.com/openOODA/install/main/install.sh";
}

fn update_has_flag(args: List[String], name: String) -> Bool {
    let n: Int = list_len(args);
    let mut i: Int = 0;
    while i < n {
        if list_get(args, i) == name { return true; }
        i = i + 1;
    }
    return false;
}

fn update_argv_installer(args: List[String]) -> String {
    let n: Int = list_len(args);
    let mut i: Int = 0;
    while i < n {
        let a: String = list_get(args, i);
        if a == "--installer" {
            if i + 1 < n { return list_get(args, i + 1); }
            return "";
        }
        let eq: String = "--installer=";
        if chars_len(a) > chars_len(eq) && str_slice(a, 0, chars_len(eq)) == eq {
            return str_slice(a, chars_len(eq), chars_len(a));
        }
        i = i + 1;
    }
    return "";
}

fn update_argv_error(args: List[String]) -> String {
    let n: Int = list_len(args);
    let mut i: Int = 0;
    while i < n {
        let a: String = list_get(args, i);
        if a == "--yes" || a == "--dry-run" || a == "--no-modify-shell" {
            i = i + 1;
            continue;
        }
        if a == "--installer" {
            if i + 1 < n {
                if chars_len(list_get(args, i + 1)) > 0 {
                    i = i + 2;
                    continue;
                }
            }
            return "--installer needs a path";
        }
        if a == "--installer=" {
            return "--installer needs a path";
        }
        let eq: String = "--installer=";
        if chars_len(a) > chars_len(eq) && str_slice(a, 0, chars_len(eq)) == eq {
            i = i + 1;
            continue;
        }
        if chars_len(a) > 0 && str_slice(a, 0, 1) == "-" {
            return "unknown flag: " + a;
        }
        return "unexpected arg: " + a;
    }
    return "";
}

fn update_installer_unsafe(path: String) -> String {
    if path == "" { return "empty installer path"; }
    if chars_len(path) > 4096 { return "installer path exceeds maximum length"; }
    if str_contains(path, "..") { return "installer path must not contain .."; }
    if str_contains(path, "~") { return "installer path must not contain ~"; }
    if str_contains(path, "'") || str_contains(path, "\"") {
        return "installer path must not contain quotes";
    }
    if str_contains(path, "$") || str_contains(path, "`") {
        return "installer path must not contain expansion";
    }
    if str_contains(path, ";") || str_contains(path, "|") || str_contains(path, "&") {
        return "installer path must not contain shell metachars";
    }
    return "";
}

fn update_fetch_script(args: List[String]) -> String {
    // Robust fetch: DNS pre-check, download to temp file, fall back to
    // the GitHub raw mirror, exec the downloaded file. The old pipe-to-bash
    // pattern (`curl | bash -s --`) was brittle: on hosts where oda's
    // child process has a sanitized environment, the curl inside the
    // pipe couldn't resolve DNS, and the user got a cryptic
    // "Could not resolve host" with no actionable path.
    //
    // The new script:
    //   1. Pre-checks DNS for openooda.org via getent (catches the
    //      child-DNS-stripped case early with a clear message).
    //   2. Downloads the install script to a tmp file with a 10s
    //      connect timeout and 60s total timeout. Failure is caught
    //      explicitly so we can fall back to the mirror.
    //   3. Tries the GitHub raw mirror if the primary download fails.
    //   4. Execs the downloaded file (replaces the child bash with
    //      the installer, saving a process and removing any chance of
    //      env strip at the intermediate step).
    //   5. Cleans up the tmp file on any exit path via trap.
    let flags: String = update_passthrough(args);
    let primary: String = update_canonical_url();
    let mirror: String = update_mirror_url();
    return "set -o pipefail\n" +
        "if ! getent hosts openooda.org >/dev/null 2>&1; then\n" +
        "  echo 'ERROR: ooda update: child process has no DNS resolver for openooda.org'\n" +
        "  echo 'Hint: download install.sh yourself and retry with --installer <path>:'\n" +
        "  echo '  curl -O " + primary + "'\n" +
        "  echo '  ooda update --installer ./install.sh " + flags + "'\n" +
        "  exit 1\n" +
        "fi\n" +
        "TMP=$(mktemp) || exit 1\n" +
        "trap 'rm -f \"$TMP\"' EXIT\n" +
        "if ! curl -fsSL --connect-timeout 10 -m 60 " + primary + " -o \"$TMP\"; then\n" +
        "  echo 'ERROR: failed to download from " + primary + " — trying mirror'\n" +
        "  if ! curl -fsSL --connect-timeout 10 -m 60 " + mirror + " -o \"$TMP\"; then\n" +
        "    echo 'ERROR: ooda update: both primary and mirror failed to download'\n" +
        "    echo 'Hint: download install.sh yourself and retry with --installer <path>:'\n" +
        "    echo '  curl -O " + primary + "'\n" +
        "    echo '  ooda update --installer ./install.sh " + flags + "'\n" +
        "    exit 1\n" +
        "  fi\n" +
        "fi\n" +
        "exec bash \"$TMP\" " + flags + "\n";
}

fn update_passthrough(args: List[String]) -> String {
    let mut flags: String = "";
    if update_has_flag(args, "--dry-run") { flags = flags + " --dry-run"; }
    if update_has_flag(args, "--yes") { flags = flags + " --yes"; }
    if update_has_flag(args, "--no-modify-shell") { flags = flags + " --no-modify-shell"; }
    return flags;
}

fn update_exec(sys: &ProcessCap, prog: String, argv: List[String]) {
    let r: Result[Int, String] = sys_exec_wait(sys, prog, argv);
    if r.is_err() {
        let e: String = match r { Ok(_) => "", Err(m) => m };
        println("ERROR: update exec failed: " + e);
        process_exit(1);
    }
    let code: Int = match r { Ok(c) => c, Err(_) => 1 };
    if code != 0 {
        println("ERROR: installer failed");
        println("Hint: without child-process DNS, download install.sh first and retry with --installer <path>.");
        process_exit(1);
    }
}

pub fn run_ooda_update(fr: &FsReadCap, sys: &ProcessCap, env: &EnvCap, args: List[String]) {
    let bad: String = update_argv_error(args);
    if bad != "" {
        println("ERROR: " + bad);
        process_exit(2);
    }
    let mut src: String = update_argv_installer(args);
    if src == "" {
        let r: Result[String, String] = env_get(env, "OODA_INSTALLER");
        src = match r { Ok(s) => s, Err(_) => "" };
    }
    println("=== ooda update ===");
    if src != "" {
        let why: String = update_installer_unsafe(src);
        if why != "" {
            println("ERROR: " + why);
            process_exit(2);
        }
        if !path_exists(fr, src) {
            println("ERROR: installer not found: " + src);
            process_exit(1);
        }
        println("Installer: " + src);
        let mut argv: List[String] = list_new();
        argv = list_push(argv, src);
        if update_has_flag(args, "--dry-run") { argv = list_push(argv, "--dry-run"); }
        if update_has_flag(args, "--yes") { argv = list_push(argv, "--yes"); }
        if update_has_flag(args, "--no-modify-shell") { argv = list_push(argv, "--no-modify-shell"); }
        update_exec(sys, "bash", argv);
        println("=== ooda update complete ===");
        println("Restart open harnesses so the new MCP config loads.");
        return;
    }
    println("Installer: " + update_canonical_url());
    let mut argv: List[String] = list_new();
    argv = list_push(argv, "-c");
    argv = list_push(argv, update_fetch_script(args));
    update_exec(sys, "bash", argv);
    println("=== ooda update complete ===");
    println("Restart open harnesses so the new MCP config loads.");
}
