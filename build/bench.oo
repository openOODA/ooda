// # Ooda Bench — Time oodac check (and optional run) on a .oo file
//
// Logline: Times the cost of `oodac check` (and optionally `oodac run`) on a .oo file under TimeCap, FsReadCap, EnvCap, and ProcessCap.
//
// Setup: Dispatched from ooda/main.oo. Uses find_oodac to locate the compiler, refuse_cli to enforce no-shell, and now_ms from TimeCap to measure.
//
// Beats:
//   1. Parse argv for the target .oo file and optional --run flag.
//   2. find_oodac locates the compiler; refuse_cli enforces no-shell invocation.
//   3. Run `oodac check <path>`, time the call, print ms.
//   4. If --run, also run `oodac run <path>` and print the run ms.

import "build/find_compiler.oo";
import "build/host_run.oo";

pub fn bench_argv_file(args: List[String]) -> String {
    let mut path: String = "";
    let mut i: Int = 0;
    while i < list_len(args) {
        let a: String = list_get(args, i);
        if str_slice(a, 0, 1) != "-" {
            if path == "" { path = a; }
        }
        i = i + 1;
    }
    return path;
}

pub fn run_ooda_bench(fr: &FsReadCap, proc: &ProcessCap, env: &EnvCap, time: &TimeCap, args: List[String]) {
    let mut path: String = bench_argv_file(args);
    let mut do_run: Bool = false;
    let mut i: Int = 0;
    while i < list_len(args) {
        let a: String = list_get(args, i);
        if a == "--run" {
            do_run = true;
        } else if str_slice(a, 0, 1) != "-" {
            if path == "" {
                path = a;
            }
        }
        i = i + 1;
    }
    if path == "" {
        println("usage: ooda bench <file.oo> [--run]");
        process_exit(2);
    }
    if !path_exists(fr, path) {
        println("ERR\tbench\tunreadable file: " + path);
        process_exit(2);
    }
    let oodac: String = find_oodac(fr, env);
    refuse_cli(proc, oodac);
    let t0: Int = now_ms(time);
    let cr: Result[String, String] = sys_exec(proc, oodac, "check", path);
    let t1: Int = now_ms(time);
    let mut ms: Int = t1 - t0;
    if ms < 0 { ms = 0; }
    if cr.is_err() {
        println("ooda bench: check failed " + path);
        process_exit(1);
    }
    println("ooda bench: check " + path + " " + ms.to_string() + "ms");
    if do_run {
        let r0: Int = now_ms(time);
        let rr: Result[String, String] = sys_exec(proc, oodac, "run", path);
        let r1: Int = now_ms(time);
        let mut rms: Int = r1 - r0;
        if rms < 0 { rms = 0; }
        println("ooda bench: run " + path + " " + rms.to_string() + "ms");
        if rr.is_err() {
            process_exit(1);
        }
    }
}
