import "oodac/token_fmt.oo";
import "oodac/llvm_emit_arc.oo";
import "oodac/llvm_emit_env.oo";
import "oodac/llvm_emit_ty.oo";

pub fn main() {
    let mut my_env: List[String] = llvm_env_new();
    my_env = llvm_env_add_var(my_env, "src", "%OoStr");
    my_env = llvm_env_add_var(my_env, "n", "i64");
    my_env = llvm_env_add_var(my_env, "i", "i64");
    my_env = llvm_env_add_var(my_env, "line", "i64");
    my_env = llvm_env_add_var(my_env, "col", "i64");
    println("vars: " + list_get(my_env, 3));
    let ty: String = llvm_env_get_var_ty(my_env, "n");
    println("type of n: " + ty);
}
